---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Website Quote | Fexa Digital"
  
  
  canonical="https://fexadigital.com/website-quote"
  
  
>
  <!-- End of Navigation-->

  <!-- Add padding to account for fixed navbar -->
  <div class="pt-10"></div>
<!-- Enhanced Quote Hero Section -->
<section class="relative overflow-hidden bg-gradient-to-br from-violet-800 to-purple-700 text-white py-20 md:py-28 px-4">
  <!-- Decorative elements -->
  <div class="absolute inset-0 opacity-10">
    <div class="absolute top-0 left-0 w-full h-full bg-[url('data:image/svg+xml;base64,')]"></div>
  </div>
  
  <!-- Floating circles -->
  <div class="absolute -top-20 -right-20 w-64 h-64 rounded-full bg-violet-600 opacity-20 mix-blend-screen"></div>
  <div class="absolute -bottom-16 -left-16 w-72 h-72 rounded-full bg-blue-500 opacity-20 mix-blend-screen"></div>

  <div class="container mx-auto max-w-6xl relative z-10">
    <div class="text-center">
      <!-- Badge -->
      <div class="inline-flex items-center px-4 py-2 rounded-full bg-white/15 backdrop-blur-sm mb-6">
        <svg class="w-5 h-5 mr-2 text-blue-300" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.38z" clip-rule="evenodd" />
        </svg>
        <span class="font-medium text-blue-100">FAST RESPONSE</span>
      </div>
      
      <!-- Headline -->
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6 leading-tight">
        <span class="bg-gradient-to-r from-blue-300 to-white bg-clip-text text-transparent">Precise Pricing</span><br>
        For Your Perfect Website
      </h1>
      
      <!-- Subhead -->
      <p class="text-xl md:text-2xl font-light max-w-3xl mx-auto opacity-90 mb-8">
        Get a <span class="font-semibold">tailored quote</span> in 24 hours. No templates. No surprises. Just custom solutions for your business goals.
      </p>
      
      <!-- CTA with animation -->
      <div class="animate-bounce-slow">
        <a href="#quote-form" class="inline-flex items-center px-8 py-4 bg-white text-violet-800 font-bold rounded-lg hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-1">
          Get My Free Quote
          <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
          </svg>
        </a>
      </div>
      
      <!-- Trust indicators -->
      <div class="mt-10 flex flex-col md:flex-row items-center justify-center gap-4 text-sm text-blue-100">
        <div class="flex items-center">
          <svg class="w-5 h-5 mr-2 text-green-300" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
          </svg>
          No obligation quote
        </div>
        <div class="hidden md:block w-px h-6 bg-blue-400"></div>
        <div class="flex items-center">
          <svg class="w-5 h-5 mr-2 text-green-300" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
          </svg>
          24-hour response time
        </div>
        <div class="hidden md:block w-px h-6 bg-blue-400"></div>
        <div class="flex items-center">
          <svg class="w-5 h-5 mr-2 text-green-300" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
          </svg>
          Transparent pricing
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .animate-bounce-slow {
    animation: bounce-slow 3s infinite;
  }
  @keyframes bounce-slow {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-8px);
    }
  }
</style>

<!-- Quote Section -->
<section class="container mx-auto max-w-6xl px-4 md:px-6 py-12 md:py-16">
    <div class="flex flex-col lg:flex-row gap-8 md:gap-12">
        
        <!-- Left Info Panel -->
        <div class="lg:w-2/5 bg-gradient-to-br from-violet-700 to-blue-600 text-white p-8 rounded-2xl shadow-xl">
            <div class="flex items-center mb-6">
                <svg class="w-10 h-10 text-white" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 2L2 7v10l10 5 10-5V7L12 2zm0 2.8L20 9v6l-8 4-8-4V9l8-4.2z"/>
                    <path d="M12 16.8l-8-4V9l8 4.2 8-4.2v3.8l-8 4z"/>
                </svg>
                <h2 class="text-2xl font-bold ml-3">Fexa Digital</h2>
            </div>
            <h3 class="text-xl font-semibold mb-4">Personalized Quote Process</h3>
            <ul class="space-y-4 mb-6">
                <li class="flex items-start">
                    <svg class="w-5 h-5 text-blue-300 mt-0.5 mr-2 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                    </svg>
                    <span>Simple 4-step process</span>
                </li>
                <li class="flex items-start">
                    <svg class="w-5 h-5 text-blue-300 mt-0.5 mr-2 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                    </svg>
                    <span>No obligation estimate</span>
                </li>
                <li class="flex items-start">
                    <svg class="w-5 h-5 text-blue-300 mt-0.5 mr-2 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                    </svg>
                    <span>Tailored to your needs</span>
                </li>
            </ul>
            <div class="bg-white/10 p-4 rounded-lg">
                <p class="text-blue-100 mb-2">Need help deciding?</p>
                <a href="/getting-started#quote-section" class="inline-flex items-center text-white font-medium hover:underline">
                    Schedule a free consultation
                    <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                    </svg>
                </a>
            </div>
        </div>

        <!-- Right Form Panel -->
        <div class="lg:w-3/5 bg-white p-6 md:p-8 rounded-2xl shadow-xl">
            
            <!-- Step Indicator -->
            <div class="flex items-center justify-between mb-8" id="step-indicator">
                <!-- Will be dynamically updated -->
            </div>

            <!-- Multi-step Form -->
            <form id="quote-form" class="space-y-6" action="https://formsubmit.co/samuriel01@gmail.com" method="POST">
                <input type="hidden" name="_subject" value="New Website Quote Request">
                <input type="hidden" name="_template" value="table">
                <input type="hidden" name="_captcha" value="false">
                
                <!-- STEP 1 -->
                <div class="step step-transition animate-slide-in" data-step="1">
                    <div class="space-y-6">
                        <div>
                            <h3 class="text-lg font-semibold text-gray-800 mb-3">Project Type</h3>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                                <label class="flex items-center p-4 border border-gray-200 rounded-lg hover:border-blue-400 cursor-pointer transition-colors">
                                    <input type="radio" name="projectType" value="new" class="h-4 w-4 text-blue-600 focus:ring-blue-500" checked />
                                    <span class="ml-3 text-gray-700">New Website</span>
                                </label>
                                <label class="flex items-center p-4 border border-gray-200 rounded-lg hover:border-blue-400 cursor-pointer transition-colors">
                                    <input type="radio" name="projectType" value="existing" class="h-4 w-4 text-blue-600 focus:ring-blue-500" />
                                    <span class="ml-3 text-gray-700">Existing Website</span>
                                </label>
                            </div>
                        </div>

                        <div>
                            <label for="businessName" class="block text-sm font-medium text-gray-700 mb-1">
                                Business Name <span class="text-red-500">*</span>
                            </label>
                            <input type="text" id="businessName" name="businessName" 
                                class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all" 
                                placeholder="Enter your business name" 
                                required />
                        </div>

                        <div>
                            <label for="existingSite" class="block text-sm font-medium text-gray-700 mb-1">
                                Existing Website URL (if applicable)
                            </label>
                            <input type="text" id="existingSite" name="existingSite" 
                                class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all" 
                                placeholder="https://www.yourwebsite.com" />
                        </div>
                    </div>
                </div>

                <!-- STEP 2 -->
                <div class="step hidden step-transition" data-step="2">
                    <div>
                        <h3 class="text-lg font-semibold text-gray-800 mb-4">Required Features</h3>
                        <p class="text-sm text-gray-500 mb-4">Select all features you need for your website:</p>
                        
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                            <label class="flex items-center p-3 border border-gray-200 rounded-lg hover:border-blue-400 cursor-pointer transition-colors">
                                <input type="checkbox" name="features[]" value="Client Portal" class="h-4 w-4 text-blue-600 focus:ring-blue-500">
                                <span class="ml-3 text-gray-700">Client Portal</span>
                            </label>
                            <label class="flex items-center p-3 border border-gray-200 rounded-lg hover:border-blue-400 cursor-pointer transition-colors">
                                <input type="checkbox" name="features[]" value="Custom Web App" class="h-4 w-4 text-blue-600 focus:ring-blue-500">
                                <span class="ml-3 text-gray-700">Custom Web App</span>
                            </label>
                            <label class="flex items-center p-3 border border-gray-200 rounded-lg hover:border-blue-400 cursor-pointer transition-colors">
                                <input type="checkbox" name="features[]" value="Payment Integration" class="h-4 w-4 text-blue-600 focus:ring-blue-500">
                                <span class="ml-3 text-gray-700">Payment Integration</span>
                            </label>
                            <label class="flex items-center p-3 border border-gray-200 rounded-lg hover:border-blue-400 cursor-pointer transition-colors">
                                <input type="checkbox" name="features[]" value="Blog or News Section" class="h-4 w-4 text-blue-600 focus:ring-blue-500">
                                <span class="ml-3 text-gray-700">Blog/News Section</span>
                            </label>
                            <label class="flex items-center p-3 border border-gray-200 rounded-lg hover:border-blue-400 cursor-pointer transition-colors">
                                <input type="checkbox" name="features[]" value="Online Booking" class="h-4 w-4 text-blue-600 focus:ring-blue-500">
                                <span class="ml-3 text-gray-700">Online Booking</span>
                            </label>
                            <label class="flex items-center p-3 border border-gray-200 rounded-lg hover:border-blue-400 cursor-pointer transition-colors">
                                <input type="checkbox" name="features[]" value="eCommerce Store" class="h-4 w-4 text-blue-600 focus:ring-blue-500">
                                <span class="ml-3 text-gray-700">eCommerce Store</span>
                            </label>
                            <label class="flex items-center p-3 border border-gray-200 rounded-lg hover:border-blue-400 cursor-pointer transition-colors">
                                <input type="checkbox" name="features[]" value="Business Automation" class="h-4 w-4 text-blue-600 focus:ring-blue-500">
                                <span class="ml-3 text-gray-700">Business Automation with AI</span>
                            </label>
                            <label class="flex items-center p-3 border border-gray-200 rounded-lg hover:border-blue-400 cursor-pointer transition-colors">
                                <input type="checkbox" name="features[]" value="CRM Integration" class="h-4 w-4 text-blue-600 focus:ring-blue-500">
                                <span class="ml-3 text-gray-700">CRM Integration</span>
                            </label>
                            
                            <!-- Other Features -->
                            <div class="col-span-full">
                                <label class="flex items-center p-3 border border-gray-200 rounded-lg hover:border-blue-400 cursor-pointer transition-colors">
                                    <input type="checkbox" id="otherFeaturesCheckbox" name="features[]" value="Other" class="h-4 w-4 text-blue-600 focus:ring-blue-500">
                                    <span class="ml-3 text-gray-700">Other Features</span>
                                </label>
                                <input
                                    type="text"
                                    id="otherFeaturesInput"
                                    name="otherFeatures"
                                    class="mt-2 w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all hidden"
                                    placeholder="Please specify other features needed"
                                >
                            </div>
                        </div>
                    </div>
                </div>

                <!-- STEP 3 -->
                <div class="step hidden step-transition" data-step="3">
                    <div>
                        <h3 class="text-lg font-semibold text-gray-800 mb-4">Website Pages</h3>
                        <p class="text-sm text-gray-500 mb-4">Select all pages your website will need:</p>
                        
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                            <label class="flex items-center p-3 border border-gray-200 rounded-lg hover:border-blue-400 cursor-pointer transition-colors">
                                <input type="checkbox" name="pages[]" value="Home" class="h-4 w-4 text-blue-600 focus:ring-blue-500">
                                <span class="ml-3 text-gray-700">Home Page</span>
                            </label>
                            <label class="flex items-center p-3 border border-gray-200 rounded-lg hover:border-blue-400 cursor-pointer transition-colors">
                                <input type="checkbox" name="pages[]" value="About" class="h-4 w-4 text-blue-600 focus:ring-blue-500">
                                <span class="ml-3 text-gray-700">About Us</span>
                            </label>
                            <label class="flex items-center p-3 border border-gray-200 rounded-lg hover:border-blue-400 cursor-pointer transition-colors">
                                <input type="checkbox" name="pages[]" value="Services" class="h-4 w-4 text-blue-600 focus:ring-blue-500">
                                <span class="ml-3 text-gray-700">Services</span>
                            </label>
                            <label class="flex items-center p-3 border border-gray-200 rounded-lg hover:border-blue-400 cursor-pointer transition-colors">
                                <input type="checkbox" name="pages[]" value="Products" class="h-4 w-4 text-blue-600 focus:ring-blue-500">
                                <span class="ml-3 text-gray-700">Products</span>
                            </label>
                            <label class="flex items-center p-3 border border-gray-200 rounded-lg hover:border-blue-400 cursor-pointer transition-colors">
                                <input type="checkbox" name="pages[]" value="Portfolio" class="h-4 w-4 text-blue-600 focus:ring-blue-500">
                                <span class="ml-3 text-gray-700">Portfolio</span>
                            </label>
                            <label class="flex items-center p-3 border border-gray-200 rounded-lg hover:border-blue-400 cursor-pointer transition-colors">
                                <input type="checkbox" name="pages[]" value="Blog or News" class="h-4 w-4 text-blue-600 focus:ring-blue-500">
                                <span class="ml-3 text-gray-700">Blog/News</span>
                            </label>
                            <label class="flex items-center p-3 border border-gray-200 rounded-lg hover:border-blue-400 cursor-pointer transition-colors">
                                <input type="checkbox" name="pages[]" value="Testimonials" class="h-4 w-4 text-blue-600 focus:ring-blue-500">
                                <span class="ml-3 text-gray-700">Testimonials</span>
                            </label>
                            <label class="flex items-center p-3 border border-gray-200 rounded-lg hover:border-blue-400 cursor-pointer transition-colors">
                                <input type="checkbox" name="pages[]" value="Contact" class="h-4 w-4 text-blue-600 focus:ring-blue-500">
                                <span class="ml-3 text-gray-700">Contact</span>
                            </label>
                        </div>
                    </div>

                    <div class="mt-8">
                        <label for="otherDetails" class="block text-sm font-medium text-gray-700 mb-2">
                            Additional Project Details
                        </label>
                        <textarea id="otherDetails" name="otherDetails" rows="4" 
                            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all" 
                            placeholder="Tell us more about your project goals, timeline, or any special requirements..."></textarea>
                    </div>
                </div>

                <!-- STEP 4 -->
                <div class="step hidden step-transition" data-step="4">
                    <div class="space-y-6">
                        <div>
                            <h3 class="text-lg font-semibold text-gray-800 mb-4">Contact Information</h3>
                            <p class="text-sm text-gray-500 mb-6">We'll use this to send your customized quote.</p>
                        </div>
                        
                        <div>
                            <label for="name" class="block text-sm font-medium text-gray-700 mb-1">
                                Full Name <span class="text-red-500">*</span>
                            </label>
                            <input type="text" id="name" name="name" 
                                class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all" 
                                placeholder="Your full name" 
                                required />
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div>
                                <label for="email" class="block text-sm font-medium text-gray-700 mb-1">
                                    Email Address <span class="text-red-500">*</span>
                                </label>
                                <input type="email" id="email" name="email" 
                                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all" 
                                    placeholder="your.email@example.com" 
                                    required />
                            </div>
                            <div>
                                <label for="phone" class="block text-sm font-medium text-gray-700 mb-1">
                                    Phone Number
                                </label>
                                <input type="tel" id="phone" name="phone" 
                                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all" 
                                    placeholder="+1(123) 456-7890, include country code" />
                            </div>
                        </div>

                        <div>
                            <label for="contactPreference" class="block text-sm font-medium text-gray-700 mb-1">
                                Preferred Contact Method
                            </label>
                            <select id="contactPreference" name="contactPreference" 
                                class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all bg-white">
                                <option value="email" selected>Email Only</option>
                                <option value="call">Phone Call</option>
                                <option value="whatsapp">Whatsapp Chat</option>
                            </select>
                        </div>
                    </div>
                </div>

                <!-- Navigation Buttons -->
                <div class="flex justify-between gap-4 pt-8">
                    <button type="button" id="prevBtn" class="hidden flex-1 py-3 px-6 border-2 border-gray-800 bg-gray-800 text-white font-semibold rounded-full hover:bg-gray-700 hover:border-gray-700 transition-colors shadow-sm">
                        Back
                    </button>
                    <button type="button" id="nextBtn" class="flex-1 py-3 px-6 bg-gradient-to-r from-orange-500 to-orange-600 text-white font-semibold rounded-full hover:from-orange-600 hover:to-orange-700 transition-all shadow-md">
                        Next Step
                    </button>
                </div>
            </form>
        </div>
    </div>
</section>

<style>
    .step-transition {
        transition: all 0.3s ease-in-out;
    }
    
    .animate-slide-in {
        animation: slideIn 0.5s ease-out forwards;
    }
    
    @keyframes slideIn {
        from {
            opacity: 0;
            transform: translateX(20px);
        }
        to {
            opacity: 1;
            transform: translateX(0);
        }
    }
    
    .connector-line {
        background: linear-gradient(to right, #e5e7eb 50%, #e5e7eb 50%);
        background-size: 200% 100%;
        background-position: right bottom;
        transition: all 0.5s ease-out;
    }
    
    .connector-line.active {
        background: linear-gradient(to right, #5B3DF5 50%, #e5e7eb 50%);
        background-size: 200% 100%;
        background-position: left bottom;
    }
</style>

	
<!-- Footer Section -->
</BaseLayout>

<script is:inline>
document.addEventListener('DOMContentLoaded', function() {
        const form = document.getElementById("quote-form");
        const steps = document.querySelectorAll(".step");
        const prevBtn = document.getElementById("prevBtn");
        const nextBtn = document.getElementById("nextBtn");
        const stepIndicator = document.getElementById("step-indicator");

        let currentStep = 0;

        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        const urlRegex = /^(https?:\/\/)?([\w-]+\.)+[\w-]{2,}(\/\S*)?$/i;
        const phoneRegex = /^[\+]?[1-9][\d]{0,15}$/;

        // Update step indicator with animated connectors
        const updateStepIndicator = () => {
            const totalSteps = steps.length;
            stepIndicator.innerHTML = "";
            
            for (let i = 0; i < totalSteps; i++) {
                const stepBox = document.createElement("div");
                stepBox.className = "flex flex-col items-center flex-1";
                
                // Step circle
                const circle = document.createElement("div");
                circle.className = `w-10 h-10 rounded-full flex items-center justify-center font-semibold transition-all duration-300 ${
                    i === currentStep 
                        ? 'bg-gradient-to-r from-violet-600 to-blue-500 text-white shadow-lg shadow-blue-200'
                        : i < currentStep
                        ? 'bg-blue-100 text-blue-600'
                        : 'bg-gray-100 text-gray-400'
                }`;
                circle.textContent = i + 1;
                
                // Step label
                const label = document.createElement("span");
                label.className = `text-xs mt-2 text-center font-medium ${
                    i === currentStep ? 'text-blue-600' : 'text-gray-500'
                }`;
                label.textContent = ["Project", "Features", "Pages", "Contact"][i];
                
                stepBox.appendChild(circle);
                stepBox.appendChild(label);
                
                // Add to container
                stepIndicator.appendChild(stepBox);
                
                // Add animated connector if not last step
                if (i < totalSteps - 1) {
                    const connector = document.createElement("div");
                    connector.className = `flex-1 h-1 mx-2 relative connector-line ${
                        i < currentStep ? 'active' : ''
                    }`;
                    stepIndicator.appendChild(connector);
                }
            }
            
            // Activate connector animations
            document.querySelectorAll('.connector-line').forEach((connector, index) => {
                if (index < currentStep) {
                    setTimeout(() => {
                        connector.classList.add('active');
                    }, index * 100);
                } else {
                    connector.classList.remove('active');
                }
            });
        };

        // Show current step with animation
        const showStep = (index) => {
            steps.forEach((step, i) => {
                if (i === index) {
                    step.classList.remove("hidden");
                    step.classList.add("animate-slide-in");
                } else {
                    step.classList.add("hidden");
                    step.classList.remove("animate-slide-in");
                }
            });
            
            prevBtn.classList.toggle("hidden", index === 0);
            nextBtn.textContent = index === steps.length - 1 ? "Get My Quote" : "Next Step";
            updateStepIndicator();
        };

        // Show error message for a field
        const showError = (field, message) => {
            field.classList.add("border-red-500", "focus:ring-red-500", "focus:border-red-500");
            const errorEl = document.createElement("p");
            errorEl.className = "text-red-500 text-xs mt-1 form-error";
            errorEl.textContent = message;
            field.insertAdjacentElement("afterend", errorEl);
        };

        // Clear all error messages
        const clearErrors = () => {
            document.querySelectorAll(".form-error").forEach(e => e.remove());
            document.querySelectorAll("input, textarea, select").forEach(input => {
                input.classList.remove(
                    "border-red-500", 
                    "focus:ring-red-500", 
                    "focus:border-red-500"
                );
            });
        };

        // Validate fields in current step
        const validateFields = (containerSelector) => {
            const container = document.querySelector(containerSelector);
            const fields = container.querySelectorAll("input, textarea, select");
            let isValid = true;
            
            fields.forEach((field) => {
                const value = field.value.trim();
                
                if (field.hasAttribute("required") && !value) {
                    showError(field, "This field is required.");
                    isValid = false;
                } else if (field.type === "email" && value && !emailRegex.test(value)) {
                    showError(field, "Please enter a valid email address.");
                    isValid = false;
                } else if (field.name === "existingSite" && value && !urlRegex.test(value)) {
                    showError(field, "Please enter a valid website URL (include http:// or https://).");
                    isValid = false;
                } else if (field.type === "tel" && value && !phoneRegex.test(value.replace(/\s/g, ''))) {
                    showError(field, "Please enter a valid phone number.");
                    isValid = false;
                }
            });
            
            return isValid;
        };

        // Validate checkbox groups (at least one checked)
        const validateCheckboxes = (selector, errorMsg) => {
            const checked = document.querySelectorAll(`${selector}:checked`);
            
            if (checked.length === 0) {
                const container = document.querySelector(selector).closest(".step");
                const error = document.createElement("p");
                error.className = "text-red-500 text-sm mt-2 form-error";
                error.textContent = errorMsg;
                container.appendChild(error);
                return false;
            }
            
            return true;
        };

        // Toggle "Other Features" input visibility
        const otherFeaturesCheckbox = document.getElementById("otherFeaturesCheckbox");
        const otherFeaturesInput = document.getElementById("otherFeaturesInput");

        if (otherFeaturesCheckbox && otherFeaturesInput) {
            otherFeaturesCheckbox.addEventListener("change", function() {
                if (this.checked) {
                    otherFeaturesInput.classList.remove("hidden");
                    otherFeaturesInput.focus();
                } else {
                    otherFeaturesInput.classList.add("hidden");
                    otherFeaturesInput.value = "";
                }
            });
        }

        // Next button click handler
        nextBtn.addEventListener("click", () => {
            clearErrors();

            // Validate current step before proceeding
            let isValid = true;
            
            if (currentStep === 0) {
                // Validate step 1 fields
                isValid = validateFields(`.step[data-step="1"]`);
            } else if (currentStep === 1) {
                // Validate at least one feature is selected
                isValid = validateCheckboxes(
                    'input[name="features[]"]', 
                    "Please select at least one website feature."
                );
            } else if (currentStep === 2) {
                // Validate at least one page is selected
                isValid = validateCheckboxes(
                    'input[name="pages[]"]', 
                    "Please select at least one page your website will need."
                );
            } else if (currentStep === 3) {
                // Validate contact info
                isValid = validateFields(`.step[data-step="4"]`);
            }

            if (!isValid) return;

            // Proceed to next step or submit
            if (currentStep === steps.length - 1) {
                // Form submission
                nextBtn.innerHTML = `
                    <span class="flex items-center justify-center">
                        <svg class="animate-spin -ml-1 mr-2 h-4 w-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                        </svg>
                        Processing...
                    </span>
                `;
                nextBtn.disabled = true;
                
                // Create FormData from the form
                const formData = new FormData(form);
                
                // Submit the form to FormSubmit
                fetch(form.action, {
                    method: 'POST',
                    body: formData,
                    headers: {
                        'Accept': 'application/json'
                    }
                })
                .then(response => {
                    if (response.ok) {
                        // Success message - same structure as contact form
                        form.innerHTML = `
                            <div class="bg-white/90 p-6 rounded-lg text-center">
                                <svg class="w-16 h-16 text-green-500 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                                </svg>
                                <h3 class="text-xl font-bold text-gray-900 mb-2">Thank You!</h3>
                                <p class="text-gray-700">We've received your quote request and will get back to you within 24 hours.</p>
                                <p class="text-gray-600 text-sm mt-4">You should receive a confirmation email shortly.</p>
                            </div>
                        `;
                    } else {
                        throw new Error('Submission failed');
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('There was an error submitting your quote request. Please try again or contact us directly.');
                    nextBtn.innerHTML = 'Get My Quote';
                    nextBtn.disabled = false;
                });
            } else {
                currentStep++;
                showStep(currentStep);
            }
        });

        // Previous button click handler
        prevBtn.addEventListener("click", () => {
            clearErrors();
            if (currentStep > 0) {
                currentStep--;
                showStep(currentStep);
            }
        });

        // Initialize form
        showStep(currentStep);
    });
</script>
