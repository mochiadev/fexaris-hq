---
import BaseLayout from '../layouts/BaseLayout.astro';

const services = [
  {
    title: 'Web Development',
    description:
      'High-converting websites and web applications built for speed, credibility, and conversion.',
    href: '/services/web-development',
    icon: 'fa-code',
    iconBg: 'bg-violet-600',
    bullets: ['Business websites & landing pages', 'Custom web apps & client portals', 'CMS & headless builds'],
  },
  {
    title: 'AI Automation',
    description:
      'Intelligent workflows that qualify leads, follow up automatically, and remove manual work.',
    href: '/services/ai-automation',
    icon: 'fa-robot',
    iconBg: 'bg-blue-500',
    bullets: ['AI chatbots & WhatsApp automation', 'Speed-to-lead workflows', 'CRM & API integrations'],
  },
  {
    title: 'Digital Marketing',
    description:
      'Search and paid campaigns that turn attention into qualified pipeline and measurable revenue.',
    href: '/services/digital-marketing',
    icon: 'fa-chart-line',
    iconBg: 'bg-orange-500',
    bullets: ['SEO & local search', 'Meta & Google Ads', 'Conversion rate optimization'],
  },
  {
    title: 'Managed Cloud',
    description:
      'Secure, monitored infrastructure that keeps your systems online, fast, and protected.',
    href: '/services/managed-cloud',
    icon: 'fa-cloud',
    iconBg: 'bg-purple-500',
    bullets: ['Cloud migration & hosting', 'Security & monitoring', 'Maintenance & backups'],
  },
];

const process = [
  {
    step: '01',
    title: 'Discovery & Audit',
    description:
      'We review your website, campaigns, and workflows to find where leads and time are being lost.',
  },
  {
    step: '02',
    title: 'Strategy & Blueprint',
    description:
      'You receive a clear scope, timeline, and measurable goals before any build or ad spend begins.',
  },
  {
    step: '03',
    title: 'Build & Implementation',
    description:
      'We deliver in structured weekly phases with regular updates and a private preview link.',
  },
  {
    step: '04',
    title: 'Launch & Ongoing Support',
    description:
      'We test, launch, train your team, and monitor performance so the system keeps improving.',
  },
];

const commitments = [
  {
    title: 'Clear scope',
    description: 'Fixed deliverables and timelines before work starts.',
    icon: 'fa-check-double',
  },
  {
    title: 'Weekly visibility',
    description: 'Progress updates and a private preview link throughout the build.',
    icon: 'fa-calendar-check',
  },
  {
    title: 'Measured outcomes',
    description: 'Reporting tied to leads, revenue, and operational time saved.',
    icon: 'fa-chart-line',
  },
];

const team = [
  {
    title: 'Strategy & Growth',
    description: 'Positioning, funnel strategy, campaign planning, and performance reporting.',
    icon: 'fa-compass',
    iconBg: 'bg-violet-50',
    iconColor: 'text-violet-600',
  },
  {
    title: 'Engineering',
    description: 'Web development, platforms, performance, security, and cloud infrastructure.',
    icon: 'fa-code',
    iconBg: 'bg-blue-50',
    iconColor: 'text-blue-600',
  },
  {
    title: 'AI & Automation',
    description: 'Workflow design, AI agents, integrations, and quality assurance.',
    icon: 'fa-robot',
    iconBg: 'bg-green-50',
    iconColor: 'text-green-600',
  },
  {
    title: 'Delivery & Support',
    description: 'Project coordination, launch readiness, training, and ongoing maintenance.',
    icon: 'fa-headset',
    iconBg: 'bg-orange-50',
    iconColor: 'text-orange-600',
  },
];

const testimonials = [
  {
    quote:
      'Youthful and up to date with the latest marketing and tech trends. They created our website and have since gone on to create marketing content in the form of videos for us.',
    name: 'Joseph Antwi',
    role: 'CEO, Jomaf Construction',
    service: 'Web Design & Digital Advertising',
    image: '/assets/clients/uche.png',
  },
  {
    quote:
      'Working with Fexaris Studio was great. They did an excellent job with our website. Very helpful in guiding us through the process and also pays attention to details. Highly recommended.',
    name: 'Giovanna Rogow',
    role: 'Deputy Director, Noble Supplies LTD',
    service: 'Website Design & SEO',
    image: '/assets/clients/giovanna.jpg',
  },
  {
    quote:
      'I love the seamless customer experience working with Fexaris Studio. Delivering timely, technical reports and helping me track my customers feedback efficiently. I am happy to recommend them.',
    name: 'Adiele Greatman',
    role: 'Co-founder, Jamara Stores',
    service: 'Web Design & Digital Advertising',
    image: '/assets/clients/Adiele.png',
  },
];

const clientLogos = [
  '/assets/clients/ban1.png',
  '/assets/clients/ban2.png',
  '/assets/clients/ban3.png',
  '/assets/clients/ban4.png',
  '/assets/clients/ban5.png',
];
---

<BaseLayout
  title="About Fexaris Studio | Web, Marketing & AI Automation"
  description="Fexaris Studio is an Accra-based digital growth studio connecting high-converting websites, performance marketing, and AI automation under one accountable team."
  keywords="about fexaris studio, digital growth studio accra, web development ghana, digital marketing ghana, ai automation ghana"
  canonical="https://fexaris.com/about-us/"
>
  <!-- Hero -->
  <section class="relative isolate overflow-hidden bg-[#0F1117] px-4 pb-20 pt-32 text-white sm:px-6 lg:px-8">
    <img
      src="/assets/hero-image.jpeg"
      alt=""
      aria-hidden="true"
      loading="eager"
      decoding="async"
      class="absolute inset-0 -z-20 h-full w-full object-cover object-center opacity-65"
    />
    <div
      class="absolute inset-0 -z-10 bg-gradient-to-b from-[#0F1117]/80 via-[#0F1117]/85 to-[#0F1117] lg:bg-gradient-to-r lg:from-[#0F1117] lg:via-[#0F1117]/90 lg:to-[#0F1117]/40"
      aria-hidden="true"
    >
    </div>
    <div
      class="absolute inset-0 -z-10 bg-[linear-gradient(to_right,rgba(255,255,255,0.04)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.04)_1px,transparent_1px)] bg-[size:56px_56px] opacity-50"
      aria-hidden="true"
    >
    </div>
    <div
      class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_15%_20%,rgba(91,61,245,0.35),transparent_45%),radial-gradient(circle_at_85%_10%,rgba(20,216,196,0.2),transparent_40%)]"
      aria-hidden="true"
    >
    </div>

    <div class="relative mx-auto max-w-5xl">
      <div class="max-w-3xl">
        <span class="text-sm font-semibold uppercase tracking-widest text-cyan-300">About Fexaris Studio</span>
        <h1 class="mt-4 text-4xl font-bold leading-tight md:text-5xl lg:text-6xl">
          One partner for the{' '}
          <span class="bg-gradient-to-r from-purple-400 to-cyan-400 bg-clip-text text-transparent">
            systems your growth depends on.
          </span>
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-body">
          Fexaris Studio is an Accra-based digital growth studio. We connect high-converting web infrastructure,
          performance marketing, and AI automation into one accountable system.
        </p>

        <div class="mt-8 flex flex-col gap-4 sm:flex-row sm:items-center">
          <a href="/contact-us" class="btn-primary btn-md">
            <i class="fas fa-calendar-check mr-2" aria-hidden="true"></i>
            Book a Strategy Call
          </a>
          <a href="/case-studies" class="btn-ghost btn-md">See Our Work</a>
        </div>

        <div class="mt-10 flex flex-wrap gap-x-6 gap-y-3 text-sm text-gray-400">
          <span class="inline-flex items-center gap-2">
            <i class="fas fa-calendar-alt text-cyan-400" aria-hidden="true"></i>
            Founded 2025
          </span>
          <span class="inline-flex items-center gap-2">
            <i class="fas fa-map-marker-alt text-cyan-400" aria-hidden="true"></i>
            Accra, Ghana
          </span>
          <span class="inline-flex items-center gap-2">
            <i class="fas fa-globe text-cyan-400" aria-hidden="true"></i>
            Ghana · West Africa · International
          </span>
        </div>
      </div>
    </div>
  </section>

  <!-- Who we are -->
  <section id="story" class="bg-white px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto grid max-w-6xl gap-12 lg:grid-cols-[1.15fr_0.85fr] lg:items-start">
      <div>
        <span class="text-sm font-semibold uppercase tracking-widest text-purple-600">Who we are</span>
        <h2 class="mt-3 text-3xl font-bold leading-tight text-gray-900 md:text-4xl">
          A growth studio, not a collection of disconnected vendors.
        </h2>

        <div class="mt-6 space-y-4 leading-relaxed text-gray-600">
          <p>
            Most growing businesses are held back by fragmented providers: a website that does not convert, marketing
            that cannot fix the site, and manual follow-up that loses leads. Fexaris brings web, marketing, and
            automation under one accountable team.
          </p>
          <p>
            We are deliberately small and senior. You work directly with the people doing the work—from the first audit
            through launch and ongoing optimization.
          </p>
        </div>

        <div class="mt-8 grid gap-3 sm:grid-cols-3">
          <div class="rounded-xl border border-gray-200 bg-gray-50 p-4">
            <i class="fas fa-earth-africa text-purple-600" aria-hidden="true"></i>
            <h3 class="mt-3 text-sm font-semibold text-gray-900">International standards</h3>
            <p class="mt-1 text-xs leading-relaxed text-gray-600">Performance, security, and accessibility built in.</p>
          </div>
          <div class="rounded-xl border border-gray-200 bg-gray-50 p-4">
            <i class="fas fa-location-dot text-orange-500" aria-hidden="true"></i>
            <h3 class="mt-3 text-sm font-semibold text-gray-900">Accra accountability</h3>
            <p class="mt-1 text-xs leading-relaxed text-gray-600">Local access to the team doing the work.</p>
          </div>
          <div class="rounded-xl border border-gray-200 bg-gray-50 p-4">
            <i class="fas fa-user-tie text-blue-600" aria-hidden="true"></i>
            <h3 class="mt-3 text-sm font-semibold text-gray-900">Senior delivery</h3>
            <p class="mt-1 text-xs leading-relaxed text-gray-600">Founder-led, with no handoff chain.</p>
          </div>
        </div>
      </div>

      <aside class="rounded-2xl bg-[#0F1117] p-7 text-white shadow-xl">
        <h3 class="text-lg font-semibold">Studio at a glance</h3>
        <dl class="mt-6 space-y-5 text-sm">
          <div class="flex items-start justify-between gap-6 border-b border-white/10 pb-4">
            <dt class="text-gray-400">Founded</dt>
            <dd class="text-right font-medium">2025</dd>
          </div>
          <div class="flex items-start justify-between gap-6 border-b border-white/10 pb-4">
            <dt class="text-gray-400">Headquarters</dt>
            <dd class="text-right font-medium">Accra, Ghana</dd>
          </div>
          <div class="flex items-start justify-between gap-6 border-b border-white/10 pb-4">
            <dt class="text-gray-400">Service reach</dt>
            <dd class="text-right font-medium">Ghana, West Africa &amp; international clients</dd>
          </div>
          <div class="flex items-start justify-between gap-6 border-b border-white/10 pb-4">
            <dt class="text-gray-400">Core focus</dt>
            <dd class="text-right font-medium">Web, marketing &amp; AI automation</dd>
          </div>
          <div class="flex items-start justify-between gap-6">
            <dt class="text-gray-400">Delivery</dt>
            <dd class="text-right font-medium">Founder-led senior specialists</dd>
          </div>
        </dl>
        <p class="mt-6 border-t border-white/10 pt-5 text-sm leading-relaxed text-gray-400">
          One team accountable for the build, the campaigns, and the systems that support them.
        </p>
      </aside>
    </div>
  </section>

  <!-- What we do -->
  <section id="services" class="bg-gray-50 px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-6xl">
      <div class="max-w-2xl">
        <span class="text-sm font-semibold uppercase tracking-widest text-purple-600">What we do</span>
        <h2 class="mt-3 text-3xl font-bold leading-tight text-gray-900 md:text-4xl">
          Four capabilities. One growth system.
        </h2>
        <p class="mt-4 text-gray-600">
          Each service works on its own—but the real advantage is how they connect.
        </p>
      </div>

      <div class="mt-10 grid gap-5 md:grid-cols-2">
        {
          services.map((service) => (
            <article class="group flex h-full flex-col rounded-2xl border border-gray-200 bg-white p-6 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:border-purple-500/40 hover:shadow-lg">
              <div class="flex items-start justify-between">
                <div class={`flex h-12 w-12 items-center justify-center rounded-xl ${service.iconBg}`}>
                  <i class={`fas ${service.icon} text-xl text-white`} aria-hidden="true"></i>
                </div>
                <span class="text-xl font-light leading-none text-gray-300" aria-hidden="true">+</span>
              </div>

              <h3 class="mt-5 text-xl font-bold text-gray-900">{service.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-gray-600">{service.description}</p>

              <ul class="mt-5 space-y-2 text-sm text-gray-700">
                {service.bullets.map((bullet) => (
                  <li class="flex items-center gap-2">
                    <i class="fas fa-check text-sm text-green-500" aria-hidden="true"></i>
                    <span>{bullet}</span>
                  </li>
                ))}
              </ul>

              <div class="mt-auto pt-6">
                <a
                  href={service.href}
                  class="inline-flex items-center gap-1.5 text-sm font-semibold text-purple-600 transition-colors hover:text-purple-700"
                >
                  Explore {service.title}
                  <i class="fas fa-arrow-right text-xs" aria-hidden="true"></i>
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- How we work -->
  <section id="process" class="bg-white px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-6xl">
      <div class="max-w-2xl">
        <span class="text-sm font-semibold uppercase tracking-widest text-purple-600">How we work</span>
        <h2 class="mt-3 text-3xl font-bold leading-tight text-gray-900 md:text-4xl">
          A clear process, with no black boxes.
        </h2>
        <p class="mt-4 text-gray-600">
          You always know what is happening, what comes next, and how success is measured.
        </p>
      </div>

      <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
        {
          process.map((step) => (
            <div class="rounded-2xl border border-gray-200 bg-gray-50 p-6">
              <span class="text-sm font-bold text-purple-600">{step.step}</span>
              <h3 class="mt-3 text-lg font-bold text-gray-900">{step.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-gray-600">{step.description}</p>
            </div>
          ))
        }
      </div>

      <div class="mt-8 grid gap-4 md:grid-cols-3">
        {
          commitments.map((item) => (
            <div class="flex items-start gap-4 rounded-xl border border-gray-200 bg-white p-5">
              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-purple-50 text-purple-600">
                <i class={`fas ${item.icon}`} aria-hidden="true"></i>
              </div>
              <div>
                <h3 class="font-semibold text-gray-900">{item.title}</h3>
                <p class="mt-1 text-sm leading-relaxed text-gray-600">{item.description}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Team -->
  <section id="team" class="bg-gray-50 px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-6xl">
      <div class="max-w-2xl">
        <span class="text-sm font-semibold uppercase tracking-widest text-purple-600">Our team</span>
        <h2 class="mt-3 text-3xl font-bold leading-tight text-gray-900 md:text-4xl">
          Senior specialists. One accountable team.
        </h2>
        <p class="mt-4 text-gray-600">
          You work directly with the people doing the work—no handoff chain, no account-manager layer.
        </p>
      </div>

      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          team.map((role) => (
            <div class="rounded-2xl border border-gray-200 bg-white p-6">
              <div class={`flex h-11 w-11 items-center justify-center rounded-lg ${role.iconBg} ${role.iconColor}`}>
                <i class={`fas ${role.icon}`} aria-hidden="true"></i>
              </div>
              <h3 class="mt-5 text-lg font-bold text-gray-900">{role.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-gray-600">{role.description}</p>
            </div>
          ))
        }
      </div>

      <p class="mt-6 text-sm text-gray-500">
        Founder-led delivery on every engagement, with senior specialists accountable for the work.
      </p>
    </div>
  </section>

  <!-- Client proof -->
  <section id="clients" class="bg-white px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-6xl">
      <div class="max-w-2xl">
        <span class="text-sm font-semibold uppercase tracking-widest text-purple-600">Client proof</span>
        <h2 class="mt-3 text-3xl font-bold leading-tight text-gray-900 md:text-4xl">
          Trusted by growing businesses.
        </h2>
        <p class="mt-4 text-gray-600">A few words from the businesses we have worked with.</p>
      </div>

      <div class="mt-10 rounded-2xl border border-gray-200 bg-gray-50 p-6 sm:p-8">
        <div class="grid grid-cols-2 items-center gap-6 sm:grid-cols-3 lg:grid-cols-5">
          {
            clientLogos.map((logo, index) => (
              <img
                src={logo}
                alt={`Client logo ${index + 1}`}
                loading="lazy"
                decoding="async"
                class="mx-auto h-8 w-auto max-w-[140px] object-contain opacity-60 grayscale transition duration-300 hover:opacity-100 hover:grayscale-0 sm:h-10"
              />
            ))
          }
        </div>
      </div>

      <div class="mt-6 grid gap-5 md:grid-cols-3">
        {
          testimonials.map((testimonial) => (
            <figure class="flex h-full flex-col rounded-2xl border border-gray-200 bg-white p-6 shadow-sm">
              <div class="flex gap-1 text-yellow-400" aria-label="5 out of 5 stars">
                {Array.from({ length: 5 }).map(() => (
                  <i class="fas fa-star text-xs" aria-hidden="true"></i>
                ))}
              </div>

              <blockquote class="mt-4 flex-1 text-sm italic leading-relaxed text-gray-600">
                “{testimonial.quote}”
              </blockquote>

              <figcaption class="mt-5 flex items-center gap-3 border-t border-gray-100 pt-5">
                <img
                  src={testimonial.image}
                  alt={testimonial.name}
                  loading="lazy"
                  decoding="async"
                  class="h-11 w-11 rounded-full object-cover"
                />
                <div>
                  <div class="text-sm font-semibold text-gray-900">{testimonial.name}</div>
                  <div class="text-xs text-gray-500">{testimonial.role}</div>
                  <div class="mt-0.5 text-xs font-medium text-purple-600">{testimonial.service}</div>
                </div>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="bg-gradient-to-br from-purple-50 to-blue-50 px-4 py-16 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-4xl rounded-3xl bg-gradient-to-br from-[#0F1117] to-[#14122B] p-10 text-center text-white shadow-xl md:p-14">
      <h2 class="text-3xl font-bold leading-tight md:text-4xl">
        Let’s build the{' '}
        <span class="bg-gradient-to-r from-purple-400 to-cyan-400 bg-clip-text text-transparent">system</span>{' '}
        behind your next stage of growth.
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-body">
        Book a 30-minute strategy call. We will review your current setup and show you exactly where the opportunities
        are.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a href="/contact-us" class="btn-primary btn-md">
          Book a Strategy Call
          <i class="fas fa-arrow-right ml-2" aria-hidden="true"></i>
        </a>
        <a href="/case-studies" class="btn-ghost btn-md">See Our Work</a>
      </div>
      <p class="mt-6 text-sm text-gray-400">No commitment · 30-minute call · Clear next steps</p>
    </div>
  </section>
</BaseLayout>
