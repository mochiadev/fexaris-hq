<style is:global>
/* Page-specific styles */
        .hero-gradient {
            background: linear-gradient(135deg, rgba(124, 58, 237, 0.9) 0%, rgba(79, 70, 229, 0.9) 100%);
        }
        
        .floating-shape {
            animation: float 6s ease-in-out infinite;
        }
        
        @keyframes float {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-20px); }
        }
        
        .grid-pattern {
            background-image: 
                linear-gradient(rgba(255,255,255,0.05) 1px, transparent 1px),
                linear-gradient(90deg, rgba(255,255,255,0.05) 1px, transparent 1px);
            background-size: 50px 50px;
        }
        
        .feature-card {
            transition: all 0.3s ease;
            border-left: 3px solid transparent;
        }
        
        .feature-card:hover {
            transform: translateY(-5px);
            border-left-color: #5B3DF5;
            box-shadow: 0 10px 25px -5px rgba(124, 58, 237, 0.15);
        }
</style>

<script is:inline>
document.addEventListener('DOMContentLoaded',function(){
    const sd=document.getElementById('sd-widget'),tgl=document.getElementById('sd-toggle'),opt=document.getElementById('sd-options');
    let open=false;
    if(sd&&tgl&&opt){
        tgl.addEventListener('click',e=>{
            e.stopPropagation();
            open=!open;
            if(open){
                sd.classList.add('active');
                if(window.innerWidth<768){
                    const b=document.createElement('div');
                    b.id='sd-backdrop',b.className='fixed inset-0 bg-black/10 z-40';
                    b.addEventListener('click',()=>{open=false;sd.classList.remove('active');b.remove()});
                    document.body.appendChild(b)
                }
            }else{
                open=false;sd.classList.remove('active');
                document.getElementById('sd-backdrop')?.remove()
            }
        });
        document.addEventListener('click',e=>{if(open&&!sd.contains(e.target)){open=false;sd.classList.remove('active');document.getElementById('sd-backdrop')?.remove()}});
        document.addEventListener('keydown',e=>{if(e.key==='Escape'&&open){open=false;sd.classList.remove('active');document.getElementById('sd-backdrop')?.remove()}});
        opt.querySelectorAll('a').forEach(o=>{o.addEventListener('click',()=>{open=false;sd.classList.remove('active');document.getElementById('sd-backdrop')?.remove()})})
    }
    const btt=document.getElementById('back-to-top'),btn=document.getElementById('btt-btn');
    if(btt&&btn){
        btn.addEventListener('click',()=>{window.scrollTo({top:0,behavior:'smooth'})});
        window.addEventListener('scroll',()=>{btt.classList.toggle('visible',window.pageYOffset>400)});
        btt.classList.toggle('visible',window.pageYOffset>400)
    }
});

// Simple animations for page elements
    document.addEventListener('DOMContentLoaded', function() {
        // Add intersection observer for fade-in animations
        const observerOptions = {
            threshold: 0.1,
            rootMargin: '0px 0px -50px 0px'
        };
        
        const observer = new IntersectionObserver(function(entries) {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.style.opacity = '1';
                    entry.target.style.transform = 'translateY(0)';
                }
            });
        }, observerOptions);
        
        // Observe feature cards
        document.querySelectorAll('.feature-card').forEach(card => {
            card.style.opacity = '0';
            card.style.transform = 'translateY(20px)';
            card.style.transition = 'opacity 0.6s ease, transform 0.6s ease';
            observer.observe(card);
        });
    });
</script>
