---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="About Fexaris Studio | AI & Digital Growth Consultancy"
  description="Meet Fexaris Studio - an AI & digital growth studio engineering high-converting web infrastructure, acquisition systems, and intelligent workflow automations."
  keywords="digital transformation, web product engineering, ai automation consultancy, technical seo agency, enterprise digital growth"
  canonical="https://fexaris.com/about-us/"
  
  
>
  <!-- End of Navigation-->

<!-- Section 1: Hero Section -->
<section class="min-h-screen text-white relative overflow-hidden pt-20">
    <!-- Background with Pattern -->
    <div class="absolute inset-0 z-0">
        <div class="absolute inset-0 bg-gradient-to-br from-[#12121C] via-[#14122B] to-[#0F1117]"></div>
        <div class="absolute inset-0 grid-pattern"></div>
        <!-- Floating Shapes -->
        <div class="absolute top-1/4 left-1/4 w-20 h-20 bg-purple-500/20 rounded-full floating-shape"></div>
        <div class="absolute top-1/3 right-1/4 w-16 h-16 bg-orange-500/20 rounded-full floating-shape" style="animation-delay: 2s;"></div>
        <div class="absolute bottom-1/4 left-1/3 w-24 h-24 bg-blue-500/20 rounded-full floating-shape" style="animation-delay: 4s;"></div>
    </div>

    <div class="container mx-auto px-4 h-full flex items-center relative z-10">
        <div class="max-w-4xl mx-auto text-center py-16">
            <span class="text-sm font-semibold tracking-widest text-orange-300 mb-4 block">ABOUT FEXARIS STUDIO</span>
            <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6 leading-tight">
                AI & Digital Growth for <span class="text-transparent bg-gradient-to-r from-orange-400 to-purple-400 bg-clip-text">Scale-Minded Businesses</span>
            </h1>
            <p class="text-lg text-body mb-8 max-w-2xl mx-auto">
                Fexaris Studio combines world-class engineering with strategic market intelligence to turn your business into a scalable, revenue-generating machine.
            </p>
            <div class="flex gap-4 justify-center items-center flex-wrap">
                <a href="/getting-started" class="btn-dark-hero btn-lg btn-shimmer">
                    Start Your Journey
                    <i class="fas fa-arrow-right ml-3"></i>
                </a>
                <a href="#story" class="inline-flex items-center px-6 py-3 text-white font-medium rounded-lg border border-white/30 hover:bg-white/10 transition-all duration-300">
                    <i class="fas fa-history mr-2"></i>
                    Our Story
                </a>
            </div>
        </div>
    </div>
</section>
<!-- End of Section 1: Hero Section -->

<!-- Section 2: The Origin Story -->
<section id="story" class="py-20 px-4 lg:px-8 bg-white">
    <div class="max-w-6xl mx-auto">
        <div class="grid lg:grid-cols-2 gap-12 items-center">
            <!-- Content -->
            <div class="space-y-6">
                <span class="text-sm font-semibold tracking-widest text-purple-600">OUR JOURNEY</span>
                <h2 class="text-3xl md:text-4xl font-bold text-gray-900">
                    Ending the Era of <span class="text-orange-500">"Good Enough"</span>
                </h2>
                <div class="space-y-4 text-gray-600 leading-relaxed">
                    <p>
                        Fexaris Studio was established with a singular mission: to engineer high-converting digital infrastructure and intelligent systems that accelerate business growth.
                    </p>
                    <p>
                        We started as a premium web product studio serving clients across the globe. During this time, we saw too many businesses settling for slow, template-based sites that looked okay but failed to drive revenue. We knew there was a better way.
                    </p>
                    <p>
                        Based here in Accra, we treat every project not just as a design task, but as a business asset that must perform, convert, and grow. We are here to build the digital backbone of modern commerce.
                    </p>
                </div>
            </div>
            
            <!-- Image/Visual -->
            <div class="relative">
                <div class="bg-gradient-to-br from-purple-100 to-orange-50 rounded-2xl p-8 aspect-square flex items-center justify-center">
                    <div class="text-center">
                        <div class="w-20 h-20 bg-gradient-to-r from-purple-600 to-orange-500 rounded-full flex items-center justify-center mx-auto mb-4">
                            <i class="fas fa-bolt text-white text-2xl"></i>
                        </div>
                        <h3 class="text-xl font-bold text-gray-900 mb-2">From Vision to Impact</h3>
                        <p class="text-gray-600">Building digital excellence since 2020</p>
                    </div>
                </div>
                <!-- Accent Elements -->
                <div class="absolute -top-4 -right-4 w-8 h-8 bg-orange-500 rounded-full"></div>
                <div class="absolute -bottom-4 -left-4 w-8 h-8 bg-purple-500 rounded-full"></div>
            </div>
        </div>
    </div>
</section>
<!-- End of Section 2: The Origin Story -->

