<script is:inline>
// Simple testimonial navigation
    document.addEventListener('DOMContentLoaded', function() {
        const dots = document.querySelectorAll('.testimonial-dot');
        const grid = document.querySelector('.testimonials-grid');
        const totalSlides = 5;
        
        dots.forEach((dot, index) => {
            dot.addEventListener('click', () => {
                // Update active dot
                dots.forEach(d => d.classList.remove('active'));
                dot.classList.add('active');
                
                // Calculate scroll position for mobile (100% per card)
                if (window.innerWidth < 768) {
                    const scrollAmount = index * 100;
                    grid.style.transform = `translateX(-${scrollAmount}%)`;
                } 
                // For tablet (50% per card)
                else if (window.innerWidth < 1024) {
                    const scrollAmount = index * 50;
                    grid.style.transform = `translateX(-${scrollAmount}%)`;
                }
                // For desktop (33.33% per card)
                else {
                    const scrollAmount = index * 33.33;
                    grid.style.transform = `translateX(-${scrollAmount}%)`;
                }
            });
        });
        
        // Auto-rotate testimonials (optional)
        let currentSlide = 0;
        const autoRotate = setInterval(() => {
            currentSlide = (currentSlide + 1) % totalSlides;
            dots[currentSlide].click();
        }, 5000);
        
        // Pause auto-rotate on hover
        const container = document.querySelector('.testimonials-container');
        container.addEventListener('mouseenter', () => clearInterval(autoRotate));
        container.addEventListener('mouseleave', () => {
            setInterval(() => {
                currentSlide = (currentSlide + 1) % totalSlides;
                dots[currentSlide].click();
            }, 5000);
        });
    });
</script>
