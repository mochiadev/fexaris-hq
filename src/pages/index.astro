  {
    title: 'Digital Marketing',
    description: 'Data-driven marketing campaigns across search, social, and paid media that reach your ideal customers and maximize ROI.',
    href: '/services/digital-marketing',
    icon: 'fa-rocket',
    accentText: 'text-orange-600',
    iconBg: 'bg-orange-500',
    cardTint: 'bg-orange-50',
    cardBorder: 'border-orange-400/40',
    cardHoverBorder: 'hover:border-orange-500',
    bullets: ['LinkedIn & Meta Ads', 'SEO / GEO', 'Conversion Optimization'],
