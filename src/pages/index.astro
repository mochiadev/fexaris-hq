                        <span class={`text-xl font-light leading-none ${service.accentText}`} aria-hidden="true">+</span>
                    </div>

                    <h3 class="mt-5 text-xl sm:text-2xl font-bold text-gray-900">{service.title}</h3>
                    <p class="mt-2 text-sm leading-relaxed text-gray-600">{service.description}</p>

                    <ul class="mt-5 space-y-2 text-sm text-gray-700">
                        {service.bullets.map((bullet) => (
                            <li class="flex items-center gap-2">
                                <i class="fas fa-check text-green-500" aria-hidden="true"></i>
                                <span>{bullet}</span>
                            </li>
                        ))}
                    </ul>

                    <div class="mt-auto self-end pt-6">
                        <a
                            href={service.href}
                            aria-label={`Explore ${service.title}`}
                            class={`flex h-9 w-9 items-center justify-center rounded-full ${service.iconBg} text-white transition-transform duration-300 group-hover:translate-x-0.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-gray-900`}
                        >
