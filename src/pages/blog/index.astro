---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
---

<BaseLayout
  title="Blog | Digital Marketing & AI Automation Studio - Fexaris Studio"
  description="Insights, guides, and trends in digital marketing and AI automation for West African businesses."
  keywords="blog, digital marketing blog, ai automation blog, west africa marketing, ghana seo"
  canonical="https://fexaris.com/blog/"
>

<section class="relative pt-32 pb-20 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-6">
        Fexaris Studio Blog
      </h1>
      <p class="text-xl text-gray-600 max-w-2xl mx-auto">
        Insights, guides, and trends in digital marketing and AI automation for West African businesses.
      </p>
    </div>

    <!-- Newsletter Signup -->
    <div class="bg-gradient-to-r from-[#0F1117] to-[#14122B] rounded-2xl p-8 md:p-12 mb-16 text-center text-white">
      <h2 class="text-3xl font-bold mb-4">Get Marketing & AI Insights</h2>
      <p class="mb-6 text-lg opacity-90">Join 2,000+ business owners getting our weekly insights.</p>
      <form action="https://formsubmit.co/hello@fexaris.com" method="POST" class="max-w-md mx-auto">
        <input type="hidden" name="_subject" value="Blog Newsletter Signup">
        <input type="hidden" name="_template" value="table">
        <div class="flex flex-col sm:flex-row gap-3">
          <input
            type="email"
            name="email"
            placeholder="Your email address"
            required
            class="flex-1 px-4 py-3 rounded-lg text-gray-900 focus:outline-none focus:ring-2 focus:ring-purple-500"
          />
          <button type="submit" class="bg-gradient-to-r from-purple-600 to-blue-600 hover:from-purple-700 hover:to-blue-700 text-white font-semibold px-6 py-3 rounded-lg transition-all">
            Subscribe
          </button>
        </div>
      </form>
    </div>

    <!-- Blog Posts Grid -->
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      {posts.map(post => (
        <article class="bg-white rounded-2xl overflow-hidden shadow-lg hover:shadow-xl transition-shadow duration-300 flex flex-col h-full">
          {post.data.image ? (
            <div class="h-48 overflow-hidden">
              <img
                src={post.data.image}
                alt={post.data.title}
                class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
              />
            </div>
          ) : (
            <div class="h-48 bg-gradient-to-br from-[#0F1117] to-[#14122B] flex items-center justify-center">
              <div class="text-white text-center p-6">
                <i class="fas fa-blog text-4xl mb-2"></i>
                <p class="text-sm opacity-80">Blog Post</p>
              </div>
            </div>
          )}

          <div class="p-6 flex flex-col flex-1">
            <div class="flex items-center gap-3 mb-4 text-sm text-gray-500">
              <span class="flex items-center gap-1">
                <i class="fas fa-calendar"></i>
                {new Date(post.data.pubDate).toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric'
                })}
              </span>
              <span>•</span>
              <span>{post.data.author || 'Fexaris Studio'}</span>
            </div>

            <h3 class="text-xl font-bold text-gray-900 mb-3">
              <a href={`/blog/${post.id}`} class="hover:text-purple-600 transition-colors hover:underline">
                {post.data.title}
              </a>
            </h3>

            <p class="text-gray-600 mb-4 line-clamp-3 flex-1">
              {post.data.description}
            </p>

            {post.data.tags && post.data.tags.length > 0 && (
              <div class="flex flex-wrap gap-2 mt-auto">
                {post.data.tags.map(tag => (
                  <span key={tag} class="px-3 py-1 bg-purple-50 text-purple-600 text-xs font-medium rounded-full">
                    {tag}
                  </span>
                ))}
              </div>
            )}
          </div>
        </article>
      ))}
    </div>

    <div class="text-center mt-16">
      <p class="text-gray-600">New insights every week. <a href="/contact-us" class="text-purple-600 hover:text-purple-700">Contact us</a> with topic suggestions.</p>
    </div>
  </div>
</section>

</BaseLayout>
