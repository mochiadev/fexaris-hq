    <!-- Hero Section -->
    <section class="gradient-bg text-white fade-in pt-16">
        <div class="max-w-7xl mx-auto px-4 py-24 sm:px-6 lg:px-8 text-center">
            <h1 class="text-4xl md:text-5xl font-bold mb-6">Website vs Web App: What Does Your Business Really Need?</h1>
            <p class="text-xl md:text-2xl max-w-3xl mx-auto mb-8">
                Understand the key differences, similarities, and how to choose what fits your goals.
            </p>
            <a href="#expert-form">
                <button class="bg-amber-400 text-gray-900 px-8 py-4 rounded-lg font-bold 
                            hover:bg-amber-500 hover:shadow-[0_0_20px_-5px_rgba(245,158,11,0.5)] 
                            transition-all duration-300">
                    Talk to an Expert
                </button>
            </a>
        </div>
    </section>

    <!-- Rest of your content remains the same -->
    <!-- Key Differences Section -->
    <section class="py-16 px-4 sm:px-6 lg:px-8 fade-in">
        <div class="max-w-7xl mx-auto">
            <h2 class="text-3xl font-bold mb-12 text-center gradient-text">Key Differences</h2>
            <div class="grid md:grid-cols-2 gap-12">
                <!-- Website Card -->
                <div class="card-hover bg-white p-8 rounded-xl shadow-lg">
                    <div class="w-16 h-16 bg-purple-100 rounded-full flex items-center justify-center mb-6">
                        <svg class="w-8 h-8 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                        </svg>
                    </div>
                    <h3 class="text-2xl font-bold text-gray-900 mb-4">Website</h3>
                    <ul class="space-y-3 text-gray-700">
                        <li class="flex items-start">
                            <svg class="w-5 h-5 text-purple-500 mr-2 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                            </svg>
                            <span>Static content presentation</span>
                        </li>
                        <li class="flex items-start">
                            <svg class="w-5 h-5 text-purple-500 mr-2 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                            </svg>
                            <span>Informational, marketing-focused, or portfolio-driven</span>
                        </li>
                        <li class="flex items-start">
                            <svg class="w-5 h-5 text-purple-500 mr-2 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                            </svg>
                            <span>Typically built with CMS like WordPress or static site generators</span>
                        </li>
                        <li class="flex items-start">
                            <svg class="w-5 h-5 text-purple-500 mr-2 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                            </svg>
                            <span>Lower complexity and faster launch timelines</span>
                        </li>
                    </ul>
                </div>

                <!-- Web App Card -->
                <div class="card-hover bg-white p-8 rounded-xl shadow-lg">
                    <div class="w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center mb-6">
                        <svg class="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                        </svg>
                    </div>
                    <h3 class="text-2xl font-bold text-gray-900 mb-4">Web App</h3>
                    <ul class="space-y-3 text-gray-700">
                        <li class="flex items-start">
                            <svg class="w-5 h-5 text-blue-500 mr-2 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                            </svg>
                            <span>Dynamic, interactive functionality</span>
                        </li>
                        <li class="flex items-start">
                            <svg class="w-5 h-5 text-blue-500 mr-2 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                            </svg>
                            <span>Built for functionality, interaction, and user engagement</span>
                        </li>
                        <li class="flex items-start">
                            <svg class="w-5 h-5 text-blue-500 mr-2 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                            </svg>
                            <span>Typically built using frameworks like React, Next.js, Vue</span>
                        </li>
                        <li class="flex items-start">
                            <svg class="w-5 h-5 text-blue-500 mr-2 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                            </svg>
                            <span>Allows for login systems, dashboards, and real-time updates</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </section>

    <!-- Difference in Our Approach -->
    <section class="py-16 px-4 sm:px-6 lg:px-8 bg-gradient-to-br from-purple-700 via-blue-700 to-orange-400 text-white fade-in">
        <div class="max-w-4xl mx-auto">
            <h2 class="text-3xl font-bold mb-8 text-center text-white">Difference in Our Approach</h2>
            <div class="prose prose-lg max-w-none text-white">
                <p>
                    While websites and web apps serve different purposes, our development process follows the same rigorous methodology for both. The key differences lie in:
                </p>
                <ul class="list-disc pl-5">
                    <li><strong>Tools & Technologies:</strong> CMS platforms vs custom JavaScript frameworks</li>
                    <li><strong>Deployment Needs:</strong> Static hosting vs scalable cloud infrastructure</li>
                    <li><strong>User Experience:</strong> Content consumption vs interactive workflows</li>
                </ul>
                <a href="/more/website-design-dev#blueprint"
                    class="inline-block mt-6 font-semibold text-white hover:text-gray-100 underline decoration-2 decoration-orange-300 hover:decoration-purple-300 transition duration-300">
                    → Check out our web blueprint
                </a>
            </div>
        </div>
    </section>

    <!-- What Do I Need Section -->
    <section class="py-16 px-4 sm:px-6 lg:px-8 fade-in">
        <div class="max-w-7xl mx-auto">
            <h2 class="text-3xl font-bold mb-12 text-center gradient-text">What Do I Need for My Business?</h2>
            <div class="bg-white rounded-xl shadow-lg overflow-hidden">
                <div class="grid md:grid-cols-2">
                    <div class="p-8">
                        <h3 class="text-2xl font-bold text-gray-900 mb-4">Choose a Website If:</h3>
                        <ul class="space-y-3 text-gray-700">
                            <li class="flex items-start">
                                <svg class="w-5 h-5 text-purple-500 mr-2 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                                </svg>
                                <span>You need an online brochure or portfolio</span>
                            </li>
                            <li class="flex items-start">
                                <svg class="w-5 h-5 text-purple-500 mr-2 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                                </svg>
                                <span>You need a marketing funnel or SEO-focused content hub</span>
                            </li>
                            <li class="flex items-start">
                                <svg class="w-5 h-5 text-purple-500 mr-2 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                                </svg>
                                <span>Your primary goal is information or lead generation</span>
                            </li>
                        </ul>
                    </div>
                    <div class="p-8 bg-gray-50">
                        <h3 class="text-2xl font-bold text-gray-900 mb-4">Choose a Web App If:</h3>
                        <ul class="space-y-3 text-gray-700">
                            <li class="flex items-start">
                                <svg class="w-5 h-5 text-blue-500 mr-2 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                                </svg>
                                <span>You need user accounts and data processing</span>
                            </li>
                            <li class="flex items-start">
                                <svg class="w-5 h-5 text-blue-500 mr-2 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                                </svg>
                                <span>You need custom dashboards, user accounts, or data storage</span>
                            </li>
                            <li class="flex items-start">
                                <svg class="w-5 h-5 text-blue-500 mr-2 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                                </svg>
                                <span>You want to offer a tool or interactive service (e.g. booking, CRM)</span>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Collapsible Blurring Lines Section -->
    <section class="py-12 px-4 sm:px-6 lg:px-8 fade-in bg-gradient-to-r from-purple-50 to-blue-50">
        <div class="max-w-4xl mx-auto">
            <div class="bg-white/80 backdrop-blur-sm p-6 rounded-xl shadow-sm">
                <h2 class="text-2xl font-bold mb-4 gradient-text">The Evolving Landscape</h2>
                <p class="italic text-purple-800/90 mb-2">
                    "With modern web technologies, the traditional boundaries between websites and web apps are becoming increasingly blurred."
                </p>
                
                <!-- Collapsible Content -->
                <div id="expandable-content" class="hidden">
                    <div class="prose prose-sm text-gray-700 mt-2">
                        <p class="mb-3">
                            The rise of powerful APIs, client-side rendering, and advanced plugins means today's websites can perform many functions once exclusive to web applications.
                            For eg; booking systems can be launched as websites through the use Wordpress Plugins.
                        </p>
                        <p class="italic text-blue-800/90 mb-3">
                            "While the line may blur, intentional design decisions should always align with your specific business goals."
                        </p>
                    </div>
                </div>
                
                <!-- Toggle Button -->
                <button onclick="toggleExpand()" 
                        class="text-purple-600 hover:text-purple-800 text-sm font-medium mt-1 flex items-center">
                    <span id="toggle-text">More...</span>
                    <svg id="toggle-icon" class="w-4 h-4 ml-1 transition-transform duration-200" 
                         fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                    </svg>
                </button>
            </div>
        </div>
    </section>

    <!-- Next Article Navigation -->
<section class="py-12 flex justify-center">
  <div class="max-w-xl w-full border-2 rounded-xl p-5 bg-white shadow-sm relative overflow-hidden"
       style="border-image: linear-gradient(to right, #7C3AED, #3B82F6) 1">
