            <a href="/index#faq" class="no-underline hover:underline underline-offset-4 transition-transform duration-300 transform hover:scale-105">FAQ</a>
            <a href="/privacy-policy" class="no-underline hover:underline underline-offset-4 transition-transform duration-300 transform hover:scale-105">Privacy</a>
