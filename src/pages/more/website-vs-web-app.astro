  hideHeader={true}
  hideFooter={true}
>
  <!-- Fixed Navigation Bar -->
<nav class="fixed top-0 w-full z-50 bg-white shadow-md">
  <div class="max-w-screen-xl mx-auto px-4">
    <div class="flex justify-between items-center h-16">
<!-- Logo and Brand -->
<div class="flex-shrink-0 flex items-center">
  <a href="/" class="flex items-center">
    <!-- Replace the src below with your actual logo path -->
    <img src="../assets/fexalog.png" alt="Fexa Digital Logo"
         class="h-10 w-auto object-contain" />
  </a>
  <div class="ml-2 leading-tight">
    <span class="block text-xl font-bold text-black">FEXA DIGITAL</span>
    <span class="block text-sm text-gray-500 tracking-wide">THE LAST WORD IN DIGITAL</span>
  </div>
</div>
      <!-- Desktop Menu -->
      <div class="hidden md:flex space-x-8">
        <a href="/" class="text-gray-900 hover:text-indigo-600 px-3 py-2 text-sm font-medium transition">Home</a>
