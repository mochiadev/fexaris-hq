      <p class="text-sm text-gray-500 mb-1">Next Article</p>
      <h3 class="text-lg font-semibold text-gray-800 mb-4">
        How SEO and site maintenance affects your Business Growth
      </h3>
      <a href="/more/seo-web-maintenance"
         class="inline-block px-5 py-2 rounded-md bg-gradient-to-r from-purple-600 to-blue-500 text-white font-medium shadow-md hover:opacity-90 transition">
        Learn more →
      </a>
    </div>
  </div>
</section>


    <!-- Final CTA Section -->
    <section class="gradient-cta text-white py-20 px-4 sm:px-6 lg:px-8 fade-in">
        <div class="max-w-4xl mx-auto">
            <h2 class="text-3xl md:text-4xl font-bold mb-6 text-center">Still Not Sure What You Need?</h2>
            <p class="text-xl text-center mb-8 max-w-3xl mx-auto">
                No worries — just describe your project and goals to us. Our team of experts will assess your needs and recommend the best fit for your specific situation.
            </p>
            
            <form id="expert-form" method="POST" action="https://formsubmit.co/hello@fexaris.com" class="max-w-xl mx-auto space-y-6">
    <!-- Hidden FormSubmit config -->
    <input type="hidden" name="_captcha" value="false">
    <input type="hidden" name="_template" value="table">
    <input type="hidden" name="_subject" value="New Expert Help Request from Fexa Digital">

    <!-- Name -->
    <div>
        <input type="text" name="name" placeholder="Your Name" required
            class="w-full px-5 py-3 rounded-lg focus:ring-2 focus:ring-amber-400 focus:border-transparent text-gray-900">
    </div>

    <!-- Email -->
    <div>
        <input type="email" name="email" placeholder="Your Email" required 
            class="w-full px-5 py-3 rounded-lg focus:ring-2 focus:ring-amber-400 focus:border-transparent text-gray-900">
    </div>

    <!-- Phone Number -->
    <div>
        <input type="tel" name="phone" placeholder="Phone (include country code, e.g. +1, +44, +233)" 
            class="w-full px-5 py-3 rounded-lg focus:ring-2 focus:ring-amber-400 focus:border-transparent text-gray-900">
    </div>

    <!-- Message -->
    <div>
        <textarea name="message" placeholder="Tell us about your project" rows="4" required
            class="w-full px-5 py-3 rounded-lg focus:ring-2 focus:ring-amber-400 focus:border-transparent text-gray-900"></textarea>
    </div>

    <!-- Submit Button -->
    <button type="submit"
        class="w-full bg-white text-gray-900 px-8 py-4 rounded-lg font-bold hover:bg-gray-100 hover:shadow-lg transition-all duration-300">
        Get Expert Help
    </button>
</form>

        </div>
    </section>

