        <a href="/website-quote" class="text-gray-900 hover:text-indigo-600 px-3 py-2 text-sm font-medium transition">Request A Quote</a>
        <a href="/index#faq" class="text-gray-900 hover:text-indigo-600 px-3 py-2 text-sm font-medium transition">FAQ</a>
