          <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
            <path d="M12 2.2c3.2 0 3.6 0 4.9.1 1.2.1 2 .2 2.5.4.6.2 1 .4 1.4.8.4.4.6.8.8 1.4.2.5.3 1.3.4 2.5.1 1.3.1 1.7.1 4.9s0 3.6-.1 4.9c-.1 1.2-.2 2-.4 2.5-.2.6-.4 1-.8 1.4-.4.4-.8.6-1.4.8-.5.2-1.3.3-2.5.4-1.3.1-1.7.1-4.9.1s-3.6 0-4.9-.1c-1.2-.1-2-.2-2.5-.4-.6-.2-1-.4-1.4-.8-.4-.4-.6-.8-.8-1.4-.2-.5-.3-1.3-.4-2.5C2.2 15.6 2.2 15.2 2.2 12s0-3.6.1-4.9c.1-1.2.2-2 .4-2.5.2-.6.4-1 .8-1.4.4-.4.8-.6 1.4-.8.5-.2 1.3-.3 2.5-.4C8.4 2.2 8.8 2.2 12 2.2m0-2.2C8.7 0 8.3 0 7 .1 5.7.2 4.7.4 3.9.7c-.9.3-1.7.8-2.5 1.6C.6 3 0 3.9.7 5.2.4 6 0 7.1 0 8.4.1 9.7 0 10.1 0 12c0 1.9.1 2.3.1 3.6.1 1.3.4 2.4.7 3.2.3.9.8 1.7 1.6 2.5.8.8 1.6 1.3 2.5 1.6.8.3 1.9.6 3.2.7 1.3.1 1.7.1 3.6.1s2.3 0 3.6-.1c1.3-.1 2.4-.4 3.2-.7.9-.3 1.7-.8 2.5-1.6.8-.8 1.3-1.6 1.6-2.5.3-.8.6-1.9.7-3.2.1-1.3.1-1.7.1-3.6s0-2.3-.1-3.6c-.1-1.3-.4-2.4-.7-3.2-.3-.9-.8-1.7-1.6-2.5C20.3.6 19.5.1 18.6.7c-.8-.3-1.9-.6-3.2-.7C14.3 0 13.9 0 12 0zM12 5.8c-3.4 0-6.2 2.8-6.2 6.2S8.6 18.2 12 18.2s6.2-2.8 6.2-6.2S15.4 5.8 12 5.8zm0 10.3c-2.3 0-4.1-1.8-4.1-4.1S9.7 7.9 12 7.9s4.1 1.8 4.1 4.1-1.8 4.1-4.1 4.1zm6.4-11.9c0 .8-.7 1.4-1.4 1.4s-1.4-.6-1.4-1.4S16.2 2.8 17 2.8s1.4.6 1.4 1.4z"/>
          </svg>
        </a>

        <!-- GitHub -->
        <a href="https://github.com/fexadigital/" target="_blank" aria-label="GitHub"
          class="text-white transition-transform duration-300 hover:-translate-y-1 hover:scale-105">
          <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
            <path d="M12 .5C5.37.5 0 5.87 0 12.5c0 5.29 3.438 9.77 8.205 11.363.6.112.82-.26.82-.577v-2.234c-3.338.727-4.033-1.416-4.033-1.416-.546-1.386-1.333-1.755-1.333-1.755-1.089-.745.083-.729.083-.729 1.205.084 1.84 1.24 1.84 1.24 1.07 1.834 2.807 1.304 3.492.997.108-.776.418-1.305.76-1.605-2.665-.305-5.467-1.332-5.467-5.93 0-1.31.467-2.38 1.235-3.22-.124-.304-.535-1.528.117-3.184 0 0 1.008-.322 3.3 1.23a11.52 11.52 0 013.005-.404c1.02.004 2.048.138 3.005.404 2.29-1.552 3.297-1.23 3.297-1.23.653 1.656.242 2.88.12 3.184.77.84 1.233 1.91 1.233 3.22 0 4.61-2.807 5.623-5.48 5.92.43.372.814 1.103.814 2.222v3.293c0 .32.218.694.825.576C20.565 22.27 24 17.79 24 12.5 24 5.87 18.63.5 12 .5z"/>
