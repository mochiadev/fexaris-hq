<script>
  // Add this script if not already present
  document.addEventListener('DOMContentLoaded', function() {
    const blobs = document.querySelectorAll('.blob');
    if (blobs.length > 0) {
      let angle = 0;
      const radius = 10;
      const centerX = window.innerWidth / 2;
      const centerY = window.innerHeight / 2;
      
      function animateBlobs() {
        angle += 0.002;
        
        blobs.forEach((blob, index) => {
          const offsetAngle = angle + (index * Math.PI * 2 / blobs.length);
          const x = centerX + Math.cos(offsetAngle) * radius * 20;
          const y = centerY + Math.sin(offsetAngle) * radius * 20;
          
          blob.style.transform = `translate(${x - centerX}px, ${y - centerY}px)`;
        });
        
        requestAnimationFrame(animateBlobs);
      }
      
      animateBlobs();
    }
  });
</script>
  

