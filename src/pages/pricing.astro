    // DOM Elements
    const pricingContainer = document.getElementById('pricingContainer');
    const currencyTabs = document.querySelectorAll('.currency-tab');
    const selfManagedToggle = document.getElementById('selfManagedToggle');

    // Current State
    let currentCurrency = 'ghs';
    let isSelfManaged = false;

    // Initialize
    renderPricingCards();

    // Event Listeners
    currencyTabs.forEach(tab => {
      tab.addEventListener('click', () => {
        currencyTabs.forEach(t => t.classList.remove('active', 'bg-gradient-to-r', 'from-violet-600', 'to-blue-500', 'text-white'));
        tab.classList.add('active', 'bg-gradient-to-r', 'from-violet-600', 'to-blue-500', 'text-white');
        currentCurrency = tab.dataset.currency;
        renderPricingCards();
      });
    });

    selfManagedToggle.addEventListener('change', () => {
      isSelfManaged = selfManagedToggle.checked;
      renderPricingCards();
    });

    function startPlan(plan, currencySymbol) {
      const symbolToCodeMap = {
        'GH₵': 'ghs',
        '$': 'usd'
      };

      const currencyCode = symbolToCodeMap[currencySymbol] || currencySymbol.toLowerCase();
      const price = plan.price?.[currencyCode];

      if (!price) {
        console.error("Price not available for currency:", currencyCode);
        alert("Price not available for selected currency");
        return;
      }

      const message = `Hi Fexaris Studio! I'm interested in the ${plan.title} package (${currencySymbol}${price}, one-time). Please share more details.`;
      const whatsappUrl = `https://wa.me/233549694956?text=${encodeURIComponent(message)}`;
      window.open(whatsappUrl, '_blank', 'noopener,noreferrer');
    }

    function renderPricingCards() {
      const currencySymbol = currentCurrency === 'ghs' ? 'GH₵' : '$';
      // Switch between Managed and Advanced Offers
      const plans = isSelfManaged ? pricingData.advancedOffers : pricingData.managed;

      pricingContainer.innerHTML = '';

      // Render pricing cards
      Object.entries(plans).forEach(([key, plan]) => {
        const price = plan.price[currentCurrency];
        // Renewal removed from display

        // Determine card border style based on plan type
        let borderStyle = '';
        if (isSelfManaged) {
          borderStyle = 'border-2 border-dashed border-purple-300';
        } else {
          if (plan.title.toLowerCase().includes('startup')) {
            borderStyle = 'border-2 border-blue-200';
          } else if (plan.title.toLowerCase().includes('ecommerce')) {
            borderStyle = 'border-2 border-violet-500';
          } else if (plan.popular) {
            borderStyle = 'border-2 border-orange-500';
          } else {
            borderStyle = 'border border-gray-200';
          }
        }

        const card = document.createElement('div');
        card.className = `pricing-card bg-white rounded-xl overflow-hidden ${borderStyle} transition-all duration-300 hover:shadow-lg flex flex-col`;

        card.innerHTML = `
          <div class="p-6 flex-grow">
            ${plan.popular ? '<span class="popular-tag text-white text-xs font-bold px-3 py-1 rounded-full mb-2 inline-block">MOST POPULAR</span>' : ''}
            <h3 class="text-2xl font-bold text-gray-900 mb-1">${plan.title}</h3>
            <p class="text-gray-600 mb-4 h-10 overflow-hidden">${plan.tagline}</p>

            <div class="mb-6">
              <span class="text-4xl font-bold">${currencySymbol}${price}</span>
              <span class="text-gray-500 ml-2 text-sm font-medium">one-time</span>
            </div>

            <ul class="space-y-3 mb-8">
              ${plan.features.map(feature => `
                <li class="flex items-start">
                  <svg class="w-5 h-5 text-green-500 mt-0.5 mr-2 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                  </svg>
                  <div class="relative feature-info">
                    <span>${feature.text}</span>
                    ${feature.tooltip ? `
                    <div class="feature-tooltip absolute left-0 bottom-full mb-2 w-48 bg-gray-800 text-white text-xs rounded p-2 shadow-lg transform translate-y-1 z-20">
                      ${feature.tooltip}
                      <svg class="absolute text-gray-800 h-2 w-full left-0 top-full" x="0px" y="0px" viewBox="0 0 255 255"><polygon class="fill-current" points="0,0 127.5,127.5 255,0"/></svg>
                    </div>
                    ` : ''}
                  </div>
                </li>
              `).join('')}
            </ul>
          </div>
          <div class="p-6 pt-0 mt-auto">
             <a href="#"
               class="cta-button block w-full text-center bg-gradient-to-r from-violet-600 to-blue-500 text-white font-semibold py-3 px-6 rounded-lg hover:from-violet-700 hover:to-blue-600 transition-all"
               data-plan-key="${key}">
              ${plan.cta}
            </a>
          </div>
        `;

        pricingContainer.appendChild(card);

        // Bind CTA button to startPlan function
        const ctaButton = card.querySelector('.cta-button');
        ctaButton.addEventListener('click', (e) => {
          e.preventDefault();
          startPlan(plan, currencySymbol);
        });
      });
    }
