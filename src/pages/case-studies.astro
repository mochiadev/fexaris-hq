---
import BaseLayout from '../layouts/BaseLayout.astro';
import CaseStudyCard from '../components/CaseStudyCard.astro';
import { allCaseStudies } from '../data/case-studies';

const categories = [
  { id: 'all', label: 'All Work' },
  { id: 'websites', label: 'Websites' },
  { id: 'seo', label: 'SEO' },
  { id: 'ai-automation', label: 'AI Automation' },
];
---

<BaseLayout
  title="Case Studies | Fexaris Studio"
  description="Real results from growing businesses that stopped guessing and started measuring. See how Fexaris Studio drives growth."
  keywords="case studies, web development case study, seo case study, ai automation case study, ghana digital agency"
  canonical="https://fexaris.com/case-studies/"
>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-[#0F1117] px-4 pb-16 pt-32 text-white sm:px-6 lg:px-8">
    <div
      class="absolute inset-0 bg-[radial-gradient(circle_at_20%_20%,rgba(91,61,245,0.28),transparent_45%),radial-gradient(circle_at_85%_10%,rgba(20,216,196,0.18),transparent_40%)]"
      aria-hidden="true"
    >
    </div>
    <div class="relative mx-auto max-w-4xl text-center">
      <span class="text-sm font-semibold uppercase tracking-widest text-cyan-300">Case Studies</span>
      <h1 class="mt-4 text-4xl font-bold leading-tight md:text-5xl lg:text-6xl">
        Results That{' '}
        <span class="bg-gradient-to-r from-purple-400 to-cyan-400 bg-clip-text text-transparent">
          Speak for Themselves
        </span>
      </h1>
      <p class="mx-auto mt-5 max-w-2xl text-lg text-body">
        Real results from growing businesses that stopped guessing and started measuring what actually drives revenue.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a href="/contact-us" class="btn-primary btn-md">
          <i class="fas fa-calendar-check mr-2" aria-hidden="true"></i>
          Book a Strategy Call
        </a>
        <a href="/#services" class="btn-ghost btn-md">See Our Services</a>
      </div>
    </div>
  </section>

  <!-- Case studies grid -->
  <section class="bg-white py-16 md:py-24">
    <div class="mx-auto max-w-6xl px-4 md:px-6">
      <div class="mb-10 flex flex-wrap gap-2" role="tablist" aria-label="Filter case studies">
        {
          categories.map((cat) => (
            <button
              type="button"
              data-filter={cat.id}
              class="rounded-full border border-gray-200 px-4 py-2 text-sm font-medium text-gray-600 transition-colors hover:border-purple-400 hover:text-purple-600"
              role="tab"
              aria-selected="false"
            >
              {cat.label}
            </button>
          ))
        }
      </div>

      <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3" id="case-studies-grid">
        {
          allCaseStudies.map((study) => (
            <div data-category={study.category}>
              <CaseStudyCard
                title={study.title}
                category={study.category}
                thumbnail={study.thumbnail}
                summary={study.summary}
                metrics={study.metrics}
                slug={study.slug}
              />
            </div>
          ))
        }
      </div>

      <p id="case-studies-empty" class="hidden py-12 text-center text-gray-500">
        No case studies in this category yet.
      </p>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-gradient-to-br from-purple-50 to-blue-50 px-4 py-16 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-4xl rounded-3xl bg-gradient-to-br from-[#0F1117] to-[#14122B] p-10 text-center text-white shadow-xl md:p-14">
      <h2 class="text-3xl font-bold md:text-4xl">
        Ready to{' '}
        <span class="bg-gradient-to-r from-purple-400 to-cyan-400 bg-clip-text text-transparent">Join Them</span>?
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-body">
        Book a 30-minute strategy call. We will audit your pipeline and show you exactly where you are leaking revenue.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a href="/contact-us" class="btn-primary btn-md">
          Book Your Strategy Call
          <i class="fas fa-arrow-right ml-2" aria-hidden="true"></i>
        </a>
        <a href="/#services" class="btn-ghost btn-md">See Our Services</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (() => {
    const filterButtons = document.querySelectorAll('[data-filter]');
    const cards = document.querySelectorAll('[data-category]');
    const emptyState = document.getElementById('case-studies-empty');

    const applyFilter = (filter) => {
      let visible = 0;

      filterButtons.forEach((button) => {
        const isActive = button.getAttribute('data-filter') === filter;
        button.classList.toggle('bg-purple-600', isActive);
        button.classList.toggle('text-white', isActive);
        button.classList.toggle('border-purple-600', isActive);
        button.classList.toggle('border-gray-200', !isActive);
        button.setAttribute('aria-selected', isActive ? 'true' : 'false');
      });

      cards.forEach((card) => {
        const show = filter === 'all' || card.getAttribute('data-category') === filter;
        card.style.display = show ? '' : 'none';
        if (show) visible += 1;
      });

      if (emptyState) {
        emptyState.classList.toggle('hidden', visible > 0);
      }
    };

    filterButtons.forEach((button) => {
      button.addEventListener('click', () => {
        applyFilter(button.getAttribute('data-filter') || 'all');
      });
    });

    applyFilter('all');
  })();
</script>
