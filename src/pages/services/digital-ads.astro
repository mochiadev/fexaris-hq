---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Digital Marketing & AI Automation | Fexaris Studio"
  description="Predictable growth through paid acquisition (LinkedIn & Meta Ads), technical SEO architecture, life-cycle email funnels, and AI workflow automation."
  keywords="digital marketing & AI automation, performance marketing agency, paid advertising linkedin meta, technical seo architecture, conversion funnel strategy"
  canonical="https://fexaris.com/services/digital-ads/"
  
  
>
  <!-- End of Navigation-->


    <!-- Hero Section: Split Screen with Background -->
<section class="min-h-screen relative overflow-hidden bg-gradient-to-br from-[#12121C] via-[#14122B] to-[#10162E]">
    <!-- Background Image -->
    <div class="absolute inset-0 z-0">
        <img 
            src="../assets/ads-hero.webp" 
            alt="Digital Advertising Analytics Dashboard"
            class="w-full h-full object-cover"
        >
        <div class="absolute inset-0 bg-gradient-to-r from-[#0F1117]/90 to-[#10162E]/80"></div>
    </div>
    
    <!-- Floating Elements -->
    <div class="absolute inset-0 overflow-hidden">
        <div class="absolute top-20 left-20 w-6 h-6 bg-orange-400 rounded-full animate-pulse"></div>
        <div class="absolute bottom-32 right-32 w-4 h-4 bg-green-400 rounded-full animate-pulse" style="animation-delay: 1s;"></div>
        <div class="absolute top-1/2 left-1/3 w-3 h-3 bg-purple-400 rounded-full animate-pulse" style="animation-delay: 2s;"></div>
    </div>
    
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid lg:grid-cols-2 gap-12 items-center min-h-screen py-20">
            <!-- Left Content -->
            <div class="text-white" data-aos="fade-right">
                <div class="inline-flex items-center gap-3 px-5 py-2 bg-white/10 backdrop-blur-sm rounded-full border border-white/20 mb-8">
                    <div class="w-2 h-2 bg-green-400 rounded-full animate-pulse"></div>
                    <span class="text-sm font-semibold">Digital Marketing & Acquisition</span>
                </div>
                
                <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold mb-6 leading-tight">
                    Stop Guessing.
                    <span class="block text-transparent bg-clip-text bg-gradient-to-r from-orange-300 to-green-300">
                        Start Growing.
                    </span>
                </h1>
                
                <p class="text-xl text-body mb-8 max-w-xl leading-relaxed">
                    Unlock <strong class="text-white">Predictable Revenue</strong> with digital ads that actually convert. Data-driven campaigns that deliver measurable ROI.
                </p>
                
                <div class="flex flex-col sm:flex-row gap-4">
                    <a href="/contact-us" class="btn btn-dark-hero btn-lg w-full sm:w-auto text-center">
                        Get Free SEO Audit
                        <i class="fas fa-arrow-right ml-3"></i>
                    </a>
                    <a href="#process" class="inline-flex items-center justify-center px-8 py-4 bg-transparent text-white font-bold rounded-xl border-2 border-white/30 hover:border-white/60 hover:bg-white/10 transition-all duration-300">
                        <i class="fas fa-chart-line mr-3"></i>
                        How it Works
                    </a>
                </div>
				
				
                
                <!-- Social Proof -->
                <div class="mt-12 grid grid-cols-3 gap-6 max-w-md">
                    <div class="text-center">
                        <p class="text-2xl font-bold text-white">+42%</p>
                        <p class="text-sm text-gray-300">ROAS</p>
                    </div>
                    <div class="text-center">
                        <p class="text-2xl font-bold text-white">-31%</p>
                        <p class="text-sm text-gray-300">CPA</p>
                    </div>
                    <div class="text-center">
                        <p class="text-2xl font-bold text-white">24/7</p>
                        <p class="text-sm text-gray-300">Optimization</p>
                    </div>
                </div>
            </div>
            
            <!-- Right Side - Empty for background image -->
            <div class="relative" data-aos="fade-left" data-aos-delay="300">
                <!-- Additional floating elements can go here -->
            </div>
        </div>
    </div>
</section>
<!-- End of Hero Section -->
    <!-- End of Hero Section -->

<!-- Solutions Section: CSS 3D Feature Cards -->
<section id="solutions" class="py-20 bg-[#F9F9FB] overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-16">
            <span class="inline-block px-5 py-2 bg-orange-100 text-orange-900/70 rounded-full border border-orange-200 text-sm font-semibold mb-6" data-aos="fade-up">
                The State of AI in Marketing 2026
            </span>
            <h2 class="text-4xl sm:text-5xl font-bold tracking-tight text-gray-900 mb-6 leading-tight" data-aos="fade-up" data-aos-delay="50">
                Solutions built for
                <span class="block">modern growth</span>
            </h2>
            <p class="text-lg text-gray-600 mx-auto leading-relaxed" data-aos="fade-up" data-aos-delay="100">
                Strategic marketing and creative solutions designed to help brands scale faster, improve visibility, and drive measurable business results.
            </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <!-- Card 1: Performance Marketing -->
            <div class="group relative bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-md hover:-translate-y-1 transition-all duration-300 border border-gray-100" data-aos="fade-up" data-aos-delay="100">
                <div class="relative h-64 bg-orange-100 overflow-hidden rounded-t-2xl">
                    <div class="absolute top-6 left-6 z-10">
                        <h3 class="text-2xl font-bold text-gray-900 tracking-tight">Performance Marketing</h3>
                    </div>
                    <div class="absolute bottom-0 right-6 solution-folder-wrap group-hover:scale-105 group-hover:-rotate-2 transition-transform duration-300">
                        <i class="fas fa-folder-open solution-folder-back text-orange-300"></i>
                        <i class="fas fa-folder-open solution-folder-front text-orange-400"></i>
                        <div class="solution-doc">
                            <i class="fas fa-bullseye text-orange-500"></i>
                        </div>
                    </div>
                </div>
                <div class="p-6 bg-gradient-to-b from-orange-50 to-orange-100/40 flex flex-col">
                    <p class="text-gray-600 leading-relaxed">
                        Data-driven paid acquisition across Meta & LinkedIn Ads, conversion-funnel engineering with precise ad tracking, and email & lifecycle marketing — automated nurture sequences, segmentation, and retention campaigns.
                    </p>
                    <a href="/contact-us" class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-orange-600 hover:text-orange-700 transition-colors">
                        Contact <span class="transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5">&nearr;</span>
                    </a>
                </div>
            </div>

            <!-- Card 2: Content & Organic Social -->
            <div class="group relative bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-md hover:-translate-y-1 transition-all duration-300 border border-gray-100" data-aos="fade-up" data-aos-delay="200">
                <div class="relative h-64 bg-emerald-100 overflow-hidden rounded-t-2xl">
                    <div class="absolute top-6 left-6 z-10">
                        <h3 class="text-2xl font-bold text-gray-900 tracking-tight">Content &amp; Organic Social</h3>
                    </div>
                    <div class="absolute bottom-0 right-6 solution-folder-wrap group-hover:scale-105 group-hover:-rotate-2 transition-transform duration-300">
                        <i class="fas fa-folder-open solution-folder-back text-emerald-200"></i>
                        <i class="fas fa-folder-open solution-folder-front text-emerald-400"></i>
                        <div class="solution-doc">
                            <i class="fas fa-layer-group text-emerald-600"></i>
                        </div>
                    </div>
                </div>
                <div class="p-6 bg-gradient-to-b from-emerald-50 to-emerald-100/40 flex flex-col">
                    <p class="text-gray-600 leading-relaxed">
                        Strategic copywriting and conversion asset creation, organic social strategy with brand positioning, plus B2B case studies and educational content that build authority and trust.
                    </p>
                    <a href="/contact-us" class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-emerald-700 hover:text-emerald-800 transition-colors">
                        Contact <span class="transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5">&nearr;</span>
                    </a>
                </div>
            </div>

            <!-- Card 3: SEO Optimization -->
            <div class="group relative bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-md hover:-translate-y-1 transition-all duration-300 border border-gray-100" data-aos="fade-up" data-aos-delay="300">
                <div class="relative h-64 bg-indigo-100 overflow-hidden rounded-t-2xl">
                    <div class="absolute top-6 left-6 z-10">
                        <h3 class="text-2xl font-bold text-gray-900 tracking-tight">SEO Optimization</h3>
                    </div>
                    <div class="absolute bottom-0 right-6 solution-folder-wrap group-hover:scale-105 group-hover:-rotate-2 transition-transform duration-300">
                        <i class="fas fa-folder-open solution-folder-back text-indigo-200"></i>
                        <i class="fas fa-folder-open solution-folder-front text-indigo-400"></i>
                        <div class="solution-doc">
                            <i class="fas fa-search text-indigo-500"></i>
                        </div>
                    </div>
                </div>
                <div class="p-6 bg-gradient-to-b from-indigo-50 to-indigo-100/40 flex flex-col">
                    <p class="text-gray-600 leading-relaxed">
                        Technical & web SEO (site speed, Core Web Vitals, architecture), generative engine optimization for AI-search visibility, and local SEO that builds sustainable organic growth.
                    </p>
                    <a href="/contact-us" class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-indigo-600 hover:text-indigo-700 transition-colors">
                        Contact <span class="transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5">&nearr;</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- End of Solutions Section -->

    <!-- Process Section: Interactive Bento Grid -->
<section id="process" class="py-20 bg-[#F9F9FB] overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-16">
            <span class="inline-block px-5 py-2 bg-orange-100 text-orange-900/70 rounded-full border border-orange-200 text-sm font-semibold mb-6" data-aos="fade-up">
                Our Process
            </span>
            <h2 class="text-4xl sm:text-5xl font-bold tracking-tight text-gray-900 mb-6 leading-tight" data-aos="fade-up" data-aos-delay="50">
                Our proven process for
                <span class="block">brand growth</span>
            </h2>
            <p class="text-lg text-gray-600 mx-auto leading-relaxed" data-aos="fade-up" data-aos-delay="100">
                A systematic, data-led approach that turns strategy into scalable, measurable business results.
            </p>
        </div>

        <div class="grid lg:grid-cols-12 gap-6">
            <!-- Left Column: Featured Image Card -->
            <div class="lg:col-span-5" data-aos="fade-right">
                <div class="relative h-full min-h-[420px] rounded-2xl overflow-hidden shadow-sm">
                    <img
                        src="https://images.unsplash.com/photo-1552664730-d307ca884978?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1200&q=80"
                        alt="Fexaris team collaborating on a growth strategy"
                        class="absolute inset-0 w-full h-full object-cover"
                        loading="lazy"
                    >
                    <div class="absolute inset-0 bg-gradient-to-t from-indigo-950/70 via-indigo-900/10 to-transparent"></div>
                    <div class="absolute bottom-6 left-6 right-6">
                        <div class="inline-flex items-center gap-2 px-4 py-2 bg-white/90 backdrop-blur-sm rounded-full text-sm font-semibold text-indigo-700 shadow-sm">
                            <i class="fas fa-bullseye text-xs"></i>
                            Strategy in action
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Column: 2x2 Interactive Step Cards -->
            <div class="lg:col-span-7 grid grid-cols-1 md:grid-cols-2 gap-5">
                <!-- Step 1 (Active) -->
                <button type="button" class="bento-step bento-active group text-left rounded-2xl border bg-[#F5F5F7] p-6 transition-all duration-300" data-step="0" data-aos="fade-up" data-aos-delay="100">
                    <div class="flex items-start justify-between gap-4">
                        <h3 class="text-xl font-bold text-gray-900 tracking-tight">Discovery &amp; Research</h3>
                        <span class="bento-arrow flex-shrink-0 w-10 h-10 rounded-full border-2 border-gray-300 text-gray-900 items-center justify-center transition-all duration-300">
                            <i class="fas fa-arrow-up"></i>
                        </span>
                    </div>
                    <div class="bento-desc overflow-hidden transition-all duration-300 ease-in-out">
                        <p class="mt-4 text-gray-600 leading-relaxed">
                            We analyze business goals, audience insights, and market opportunities strategically.
                        </p>
                    </div>
                </button>

                <!-- Step 2 -->
                <button type="button" class="bento-step group text-left rounded-2xl border bg-[#F5F5F7] p-6 transition-all duration-300" data-step="1" data-aos="fade-up" data-aos-delay="150">
                    <div class="flex items-start justify-between gap-4">
                        <h3 class="text-xl font-bold text-gray-900 tracking-tight">Strategy &amp; Planning</h3>
                        <span class="bento-arrow flex-shrink-0 w-10 h-10 rounded-full border border-gray-300 text-gray-900 items-center justify-center transition-all duration-300">
                            <i class="fas fa-arrow-up"></i>
                        </span>
                    </div>
                    <div class="bento-desc overflow-hidden transition-all duration-300 ease-in-out">
                        <p class="mt-4 text-gray-600 leading-relaxed">
                            We build a data-backed growth roadmap — messaging, channel mix, and measurable budget targets.
                        </p>
                    </div>
                </button>

                <!-- Step 3 -->
                <button type="button" class="bento-step group text-left rounded-2xl border bg-[#F5F5F7] p-6 transition-all duration-300" data-step="2" data-aos="fade-up" data-aos-delay="200">
                    <div class="flex items-start justify-between gap-4">
                        <h3 class="text-xl font-bold text-gray-900 tracking-tight">Creative Execution</h3>
                        <span class="bento-arrow flex-shrink-0 w-10 h-10 rounded-full border border-gray-300 text-gray-900 items-center justify-center transition-all duration-300">
                            <i class="fas fa-arrow-up"></i>
                        </span>
                    </div>
                    <div class="bento-desc overflow-hidden transition-all duration-300 ease-in-out">
                        <p class="mt-4 text-gray-600 leading-relaxed">
                            We craft conversion-focused creative and campaigns across ad formats and landing experiences.
                        </p>
                    </div>
                </button>

                <!-- Step 4 -->
                <button type="button" class="bento-step group text-left rounded-2xl border bg-[#F5F5F7] p-6 transition-all duration-300" data-step="3" data-aos="fade-up" data-aos-delay="250">
                    <div class="flex items-start justify-between gap-4">
                        <h3 class="text-xl font-bold text-gray-900 tracking-tight">Optimization &amp; Growth</h3>
                        <span class="bento-arrow flex-shrink-0 w-10 h-10 rounded-full border border-gray-300 text-gray-900 items-center justify-center transition-all duration-300">
                            <i class="fas fa-arrow-up"></i>
                        </span>
                    </div>
                    <div class="bento-desc overflow-hidden transition-all duration-300 ease-in-out">
                        <p class="mt-4 text-gray-600 leading-relaxed">
                            We test, learn, and scale what works, compounding returns across your full funnel.
                        </p>
                    </div>
                </button>
            </div>
        </div>
    </div>
</section>
<!-- End of Process Section -->

<!-- Multi-Platform Advertising Section -->
<!-- Multi-Platform Advertising Section -->
<section class="py-16 lg:py-20 bg-gradient-to-br from-indigo-50 to-purple-50 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
            
            <!-- Left Side: Content -->
            <div data-aos="fade-right">
                <div class="inline-flex items-center gap-3 px-4 py-2 bg-white text-indigo-600 rounded-full text-sm font-semibold shadow-lg mb-6">
                    <i class="fas fa-globe-americas"></i>
                    Multi-Platform Mastery
                </div>
                
                <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-gray-900 mb-6 leading-tight">
                    We Meet Your Customers <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-600 to-purple-600">Where They Are</span>
                </h2>
                
                <p class="text-lg sm:text-xl text-gray-600 mb-8 leading-relaxed">
                    We don't push platforms—we pull customers. Strategic platform selection based on where your ideal audience actually spends time, with messaging that speaks their language.
                </p>

                <!-- Platform Strategy Cards -->
                <div class="space-y-4 sm:space-y-6">
                    <!-- Facebook Strategy -->
                    <div class="bg-white rounded-xl sm:rounded-2xl p-4 sm:p-6 shadow-lg border border-gray-100 hover:shadow-xl transition-all duration-300" data-aos="fade-up" data-aos-delay="200">
                        <div class="flex items-start gap-3 sm:gap-4">
                            <div class="w-10 h-10 sm:w-12 sm:h-12 bg-blue-100 rounded-lg sm:rounded-xl flex items-center justify-center flex-shrink-0">
                                <i class="fab fa-facebook text-blue-600 text-lg sm:text-xl"></i>
                            </div>
                            <div class="flex-1">
                                <h4 class="text-lg sm:text-xl font-bold text-gray-900 mb-2">Facebook & Meta</h4>
                                <p class="text-gray-600 mb-3 text-sm sm:text-base">Relationship-building and hyper-detailed audience targeting for proven conversions.</p>
                                <div class="flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-4 text-xs sm:text-sm">
                                    <span class="inline-flex items-center gap-2 text-blue-600 font-semibold">
                                        <i class="fas fa-check text-xs"></i>
                                        Advanced demographic targeting
                                    </span>
                                    <span class="inline-flex items-center gap-2 text-blue-600 font-semibold">
                                        <i class="fas fa-check text-xs"></i>
                                        Retargeting campaigns
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- TikTok Strategy -->
                    <div class="bg-white rounded-xl sm:rounded-2xl p-4 sm:p-6 shadow-lg border border-gray-100 hover:shadow-xl transition-all duration-300" data-aos="fade-up" data-aos-delay="300">
                        <div class="flex items-start gap-3 sm:gap-4">
                            <div class="w-10 h-10 sm:w-12 sm:h-12 bg-black rounded-lg sm:rounded-xl flex items-center justify-center flex-shrink-0">
                                <i class="fab fa-tiktok text-white text-lg sm:text-xl"></i>
                            </div>
                            <div class="flex-1">
                                <h4 class="text-lg sm:text-xl font-bold text-gray-900 mb-2">TikTok</h4>
                                <p class="text-gray-600 mb-3 text-sm sm:text-base">Viral potential and authentic storytelling that captures Gen Z and Millennial audiences.</p>
                                <div class="flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-4 text-xs sm:text-sm">
                                    <span class="inline-flex items-center gap-2 text-gray-700 font-semibold">
                                        <i class="fas fa-check text-xs"></i>
                                        Trend-driven content
                                    </span>
                                    <span class="inline-flex items-center gap-2 text-gray-700 font-semibold">
                                        <i class="fas fa-check text-xs"></i>
                                        Viral reach optimization
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Instagram Strategy -->
                    <div class="bg-white rounded-xl sm:rounded-2xl p-4 sm:p-6 shadow-lg border border-gray-100 hover:shadow-xl transition-all duration-300" data-aos="fade-up" data-aos-delay="400">
                        <div class="flex items-start gap-3 sm:gap-4">
                            <div class="w-10 h-10 sm:w-12 sm:h-12 bg-gradient-to-br from-purple-500 to-pink-500 rounded-lg sm:rounded-xl flex items-center justify-center flex-shrink-0">
                                <i class="fab fa-instagram text-white text-lg sm:text-xl"></i>
                            </div>
                            <div class="flex-1">
                                <h4 class="text-lg sm:text-xl font-bold text-gray-900 mb-2">Instagram</h4>
                                <p class="text-gray-600 mb-3 text-sm sm:text-base">Visual storytelling and influencer synergy that builds brand love and drives action.</p>
                                <div class="flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-4 text-xs sm:text-sm">
                                    <span class="inline-flex items-center gap-2 text-pink-600 font-semibold">
                                        <i class="fas fa-check text-xs"></i>
                                        Visual-first campaigns
                                    </span>
                                    <span class="inline-flex items-center gap-2 text-pink-600 font-semibold">
                                        <i class="fas fa-check text-xs"></i>
                                        Influencer partnerships
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Cross-Platform Benefit -->
                <div class="mt-6 sm:mt-8 bg-gradient-to-r from-indigo-500 to-purple-600 rounded-xl sm:rounded-2xl p-4 sm:p-6 text-white" data-aos="fade-up" data-aos-delay="500">
                    <div class="flex items-center gap-3 sm:gap-4">
                        <div class="w-10 h-10 sm:w-12 sm:h-12 bg-white/20 rounded-lg sm:rounded-xl flex items-center justify-center flex-shrink-0">
                            <i class="fas fa-sync-alt text-lg sm:text-xl"></i>
                        </div>
                        <div>
                            <h4 class="text-base sm:text-lg font-bold mb-1">Cross-Platform Retargeting</h4>
                            <p class="text-indigo-100 text-xs sm:text-sm">Follow your customers across platforms with unified messaging that drives conversions.</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Side: Platform Image -->
            <div class="relative" data-aos="fade-left" data-aos-delay="150">
                <div class="relative">
                    <!-- Main Image Container - Borderless -->
                    <div class="rounded-2xl sm:rounded-3xl overflow-hidden shadow-2xl">
                        <img 
                            src="../assets/paid-ad1.jpg" 
                            alt="Multi-Platform Advertising Campaign" 
                            class="w-full h-auto object-cover"
                        >
                    </div>
                    
                    <!-- Floating Platform Icons - Mobile Adjusted -->
                    <div class="absolute -top-2 -left-2 sm:-top-4 sm:-left-4 bg-white rounded-xl sm:rounded-2xl p-3 sm:p-4 shadow-xl border border-gray-100" data-aos="zoom-in" data-aos-delay="400">
                        <div class="flex items-center gap-2 sm:gap-3">
                            <div class="w-8 h-8 sm:w-10 sm:h-10 bg-blue-100 rounded-lg sm:rounded-xl flex items-center justify-center">
                                <i class="fab fa-facebook text-blue-600 text-sm sm:text-lg"></i>
                            </div>
                            <div>
                                <p class="text-xs text-gray-500">Facebook</p>
                                <p class="text-sm font-bold text-gray-900">2.9B+</p>
                            </div>
                        </div>
                    </div>
                    
                    <div class="absolute -top-2 -right-2 sm:-top-4 sm:-right-4 bg-white rounded-xl sm:rounded-2xl p-3 sm:p-4 shadow-xl border border-gray-100" data-aos="zoom-in" data-aos-delay="500">
                        <div class="flex items-center gap-2 sm:gap-3">
                            <div class="w-8 h-8 sm:w-10 sm:h-10 bg-black rounded-lg sm:rounded-xl flex items-center justify-center">
                                <i class="fab fa-tiktok text-white text-sm sm:text-lg"></i>
                            </div>
                            <div>
                                <p class="text-xs text-gray-500">TikTok</p>
                                <p class="text-sm font-bold text-gray-900">1B+</p>
                            </div>
                        </div>
                    </div>
                    
                    <div class="absolute -bottom-2 -left-2 sm:-bottom-4 sm:-left-4 bg-white rounded-xl sm:rounded-2xl p-3 sm:p-4 shadow-xl border border-gray-100" data-aos="zoom-in" data-aos-delay="600">
