---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Digital Advertising Services: Google Ads & Social Media | Fexa Digital"
  description="Drive immediate sales with targeted digital advertising campaigns. We specialize in Google Search, Social Media Ads (Meta/Instagram), and performance marketing for small businesses."
  keywords="digital advertising agency, google ads management, social media advertising, performance marketing, ppc services, ghana digital ads"
  canonical="https://fexadigital.com/services/digital-ads.html"
  
  
>
  <!-- End of Navigation-->


    <!-- Hero Section: Split Screen with Background -->
<section class="min-h-screen relative overflow-hidden bg-gradient-to-br from-indigo-900 via-purple-900 to-blue-900">
    <!-- Background Image -->
    <div class="absolute inset-0 z-0">
        <img 
            src="../assets/ads-hero.webp" 
            alt="Digital Advertising Analytics Dashboard"
            class="w-full h-full object-cover"
        >
        <div class="absolute inset-0 bg-gradient-to-r from-indigo-900/90 to-blue-900/80"></div>
    </div>
    
    <!-- Floating Elements -->
    <div class="absolute inset-0 overflow-hidden">
        <div class="absolute top-20 left-20 w-6 h-6 bg-orange-400 rounded-full animate-pulse"></div>
        <div class="absolute bottom-32 right-32 w-4 h-4 bg-green-400 rounded-full animate-pulse" style="animation-delay: 1s;"></div>
        <div class="absolute top-1/2 left-1/3 w-3 h-3 bg-purple-400 rounded-full animate-pulse" style="animation-delay: 2s;"></div>
    </div>
    
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid lg:grid-cols-2 gap-12 items-center min-h-screen py-20">
            <!-- Left Content -->
            <div class="text-white" data-aos="fade-right">
                <div class="inline-flex items-center gap-3 px-5 py-2 bg-white/10 backdrop-blur-sm rounded-full border border-white/20 mb-8">
                    <div class="w-2 h-2 bg-green-400 rounded-full animate-pulse"></div>
                    <span class="text-sm font-semibold">Performance-Driven Advertising</span>
                </div>
                
                <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold mb-6 leading-tight">
                    Stop Guessing.
                    <span class="block text-transparent bg-clip-text bg-gradient-to-r from-orange-300 to-green-300">
                        Start Growing.
                    </span>
                </h1>
                
                <p class="text-xl text-gray-200 mb-8 max-w-xl leading-relaxed">
                    Unlock <strong class="text-white">Predictable Revenue</strong> with digital ads that actually convert. Data-driven campaigns that deliver measurable ROI.
                </p>
                
                <div class="flex flex-col sm:flex-row gap-4">
                    <a href="/contact-us" class="btn btn-dark-hero btn-lg w-full sm:w-auto text-center">
                        Get Free Strategy Session
                        <i class="fas fa-arrow-right ml-3"></i>
                    </a>
                    <a href="#process" class="inline-flex items-center justify-center px-8 py-4 bg-transparent text-white font-bold rounded-xl border-2 border-white/30 hover:border-white/60 hover:bg-white/10 transition-all duration-300">
                        <i class="fas fa-chart-line mr-3"></i>
                        How it Works
                    </a>
                </div>
				
				
                
                <!-- Social Proof -->
                <div class="mt-12 grid grid-cols-3 gap-6 max-w-md">
                    <div class="text-center">
                        <p class="text-2xl font-bold text-white">+42%</p>
                        <p class="text-sm text-gray-300">ROAS</p>
                    </div>
                    <div class="text-center">
                        <p class="text-2xl font-bold text-white">-31%</p>
                        <p class="text-sm text-gray-300">CPA</p>
                    </div>
                    <div class="text-center">
                        <p class="text-2xl font-bold text-white">24/7</p>
                        <p class="text-sm text-gray-300">Optimization</p>
                    </div>
                </div>
            </div>
            
            <!-- Right Side - Empty for background image -->
            <div class="relative" data-aos="fade-left" data-aos-delay="300">
                <!-- Additional floating elements can go here -->
            </div>
        </div>
    </div>
</section>
<!-- End of Hero Section -->
    <!-- End of Hero Section -->

<!-- Benefits Section: Interactive Card Grid -->
<section class="py-20 bg-gradient-to-br from-gray-50 to-white overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
            <span class="inline-block px-4 py-2 bg-indigo-100 text-indigo-700 rounded-full text-sm font-semibold mb-4" data-aos="fade-up">
                Measurable Results
            </span>
            <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-gray-900 mb-6" data-aos="fade-up">
                The Growth Engine <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-600 to-purple-600">You Deserve</span>
            </h2>
            <p class="text-xl text-gray-600 max-w-3xl mx-auto" data-aos="fade-up" data-aos-delay="100">
                Stop guessing, start growing. We deliver tangible business outcomes through data-driven advertising strategies.
            </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mt-16">
            <!-- Benefit 1 -->
            <div class="group relative bg-white rounded-2xl p-8 shadow-lg hover:shadow-2xl transition-all duration-500 border border-gray-100 hover:border-indigo-200" data-aos="fade-up" data-aos-delay="200">
                <div class="absolute -top-6 left-1/2 transform -translate-x-1/2">
                    <div class="w-14 h-14 bg-gradient-to-br from-indigo-500 to-purple-600 rounded-2xl flex items-center justify-center group-hover:scale-110 group-hover:rotate-6 transition-all duration-300 shadow-lg">
                        <i class="fas fa-chart-line text-2xl text-white"></i>
                    </div>
                </div>
                <div class="pt-8 text-center">
                    <h3 class="text-2xl font-bold text-gray-900 mb-4 group-hover:text-indigo-600 transition-colors">Predictable Revenue</h3>
                    <p class="text-gray-600 mb-6 leading-relaxed">
                        Stop worrying about where your next customer is coming from. Our ads create a steady, reliable pipeline of qualified leads.
                    </p>
                    <div class="bg-gradient-to-r from-indigo-50 to-purple-50 rounded-xl p-4 border border-indigo-100">
                        <p class="text-3xl font-bold text-indigo-600">+42%</p>
                        <p class="text-sm text-indigo-700 font-medium">Average ROAS Increase</p>
                    </div>
                </div>
            </div>

            <!-- Benefit 2 -->
            <div class="group relative bg-white rounded-2xl p-8 shadow-lg hover:shadow-2xl transition-all duration-500 border border-gray-100 hover:border-blue-200" data-aos="fade-up" data-aos-delay="300">
                <div class="absolute -top-6 left-1/2 transform -translate-x-1/2">
                    <div class="w-14 h-14 bg-gradient-to-br from-blue-500 to-cyan-600 rounded-2xl flex items-center justify-center group-hover:scale-110 group-hover:rotate-6 transition-all duration-300 shadow-lg">
                        <i class="fas fa-hand-holding-dollar text-2xl text-white"></i>
                    </div>
                </div>
                <div class="pt-8 text-center">
                    <h3 class="text-2xl font-bold text-gray-900 mb-4 group-hover:text-blue-600 transition-colors">Lower Acquisition Costs</h3>
                    <p class="text-gray-600 mb-6 leading-relaxed">
                        We constantly optimize targeting to find your best customers at the lowest possible cost, maximizing your advertising ROI.
                    </p>
                    <div class="bg-gradient-to-r from-blue-50 to-cyan-50 rounded-xl p-4 border border-blue-100">
                        <p class="text-3xl font-bold text-blue-600">-31%</p>
                        <p class="text-sm text-blue-700 font-medium">Customer Acquisition Cost</p>
                    </div>
                </div>
            </div>

            <!-- Benefit 3 -->
            <div class="group relative bg-white rounded-2xl p-8 shadow-lg hover:shadow-2xl transition-all duration-500 border border-gray-100 hover:border-orange-200" data-aos="fade-up" data-aos-delay="400">
                <div class="absolute -top-6 left-1/2 transform -translate-x-1/2">
                    <div class="w-14 h-14 bg-gradient-to-br from-orange-500 to-red-500 rounded-2xl flex items-center justify-center group-hover:scale-110 group-hover:rotate-6 transition-all duration-300 shadow-lg">
                        <i class="fas fa-clock text-2xl text-white"></i>
                    </div>
                </div>
                <div class="pt-8 text-center">
                    <h3 class="text-2xl font-bold text-gray-900 mb-4 group-hover:text-orange-600 transition-colors">Focus on Growth</h3>
                    <p class="text-gray-600 mb-6 leading-relaxed">
                        Let us handle the complex world of ad management while you focus on running your business and serving happy customers.
                    </p>
                    <div class="bg-gradient-to-r from-orange-50 to-red-50 rounded-xl p-4 border border-orange-100">
                        <p class="text-3xl font-bold text-orange-600">15+</p>
                        <p class="text-sm text-orange-700 font-medium">Hours Saved Weekly</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- End of Benefits Section -->

    <!-- Process Section: Refined Step-by-Step Visualization -->
<section id="process" class="py-20 bg-white overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid lg:grid-cols-2 gap-16 items-center">
            
            <!-- Left Side: Concise Process Steps -->
            <div data-aos="fade-right">
                <div class="inline-flex items-center gap-3 px-4 py-2 bg-indigo-100 text-indigo-700 rounded-full text-sm font-semibold mb-6">
                    <i class="fas fa-sitemap"></i>
                    Our 3-Step Process
                </div>
                <h2 class="text-4xl sm:text-5xl font-extrabold text-gray-900 mb-6 leading-tight">
                    From <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-600 to-purple-600">Data to Dollars</span>
                </h2>
                <p class="text-xl text-gray-600 mb-8 leading-relaxed">
                    A systematic approach that transforms your advertising investment into measurable business growth and predictable revenue.
                </p>
                
                <!-- Process Steps Container -->
                <div class="bg-gradient-to-br from-gray-50 to-indigo-50/30 rounded-2xl p-8 border border-gray-100">
                    <div class="space-y-8">
                        <!-- Step 1 -->
                        <div class="flex items-start gap-6 group" data-aos="fade-up" data-aos-delay="200">
                            <div class="flex-shrink-0">
                                <div class="w-12 h-12 bg-white border-2 border-indigo-200 rounded-xl flex items-center justify-center shadow-sm group-hover:shadow-md group-hover:border-indigo-300 transition-all duration-300">
                                    <div class="w-8 h-8 bg-gradient-to-br from-indigo-500 to-purple-600 rounded-lg flex items-center justify-center">
                                        <i class="fas fa-bullseye text-white text-sm"></i>
                                    </div>
                                </div>
                            </div>
                            <div class="flex-1">
                                <h4 class="text-xl font-bold text-gray-900 mb-3 group-hover:text-indigo-600 transition-colors">Precision Targeting</h4>
                                <p class="text-gray-600 leading-relaxed mb-4">
                                    Laser-focused audience targeting that reaches only your ideal customers, eliminating wasted ad spend.
                                </p>
                               
                            </div>
                        </div>

                        <!-- Step 2 -->
                        <div class="flex items-start gap-6 group" data-aos="fade-up" data-aos-delay="300">
                            <div class="flex-shrink-0">
                                <div class="w-12 h-12 bg-white border-2 border-blue-200 rounded-xl flex items-center justify-center shadow-sm group-hover:shadow-md group-hover:border-blue-300 transition-all duration-300">
                                    <div class="w-8 h-8 bg-gradient-to-br from-blue-500 to-cyan-600 rounded-lg flex items-center justify-center">
                                        <i class="fas fa-chart-line text-white text-sm"></i>
                                    </div>
                                </div>
                            </div>
                            <div class="flex-1">
                                <h4 class="text-xl font-bold text-gray-900 mb-3 group-hover:text-blue-600 transition-colors">Data-Driven Optimization</h4>
                                <p class="text-gray-600 leading-relaxed mb-4">
                                    Real-time performance monitoring and continuous optimization to maximize your return on ad spend.
                                </p>
                              
                            </div>
                        </div>

                        <!-- Step 3 -->
                        <div class="flex items-start gap-6 group" data-aos="fade-up" data-aos-delay="400">
                            <div class="flex-shrink-0">
                                <div class="w-12 h-12 bg-white border-2 border-green-200 rounded-xl flex items-center justify-center shadow-sm group-hover:shadow-md group-hover:border-green-300 transition-all duration-300">
                                    <div class="w-8 h-8 bg-gradient-to-br from-green-500 to-emerald-600 rounded-lg flex items-center justify-center">
                                        <i class="fas fa-rocket text-white text-sm"></i>
                                    </div>
                                </div>
                            </div>
                            <div class="flex-1">
                                <h4 class="text-xl font-bold text-gray-900 mb-3 group-hover:text-green-600 transition-colors">Scalable Growth</h4>
                                <p class="text-gray-600 leading-relaxed mb-4">
                                    Strategic scaling of successful campaigns to drive sustainable growth and predictable revenue streams.
                                </p>
                               
                            </div>
                        </div>
                    </div>

                </div>
            </div>

            <!-- Right Side: Enhanced Image with Metrics -->
            <div class="relative" data-aos="fade-left" data-aos-delay="150">
                <div class="relative">
                    <!-- Main Image with Gradient Border -->
                    <div class="bg-gradient-to-br from-indigo-400 to-purple-500 rounded-3xl p-1 shadow-2xl">
                        <div class="bg-white rounded-2xl overflow-hidden relative">
                            <img 
                                src="../assets/ads-dash.png" 
                                alt="Digital Marketing Analytics Dashboard" 
                                class="w-full h-auto object-cover"
                            >
                            <!-- Overlay Stats -->
                            <div class="absolute inset-0 bg-gradient-to-t from-black/20 to-transparent rounded-2xl"></div>
                        </div>
                    </div>
                    
                    <!-- Animated Metric Dots -->
                    <div class="absolute top-6 left-6 bg-white/90 backdrop-blur-sm rounded-2xl p-4 shadow-lg border border-white/20">
                        <div class="flex items-center gap-3">
                            <div class="w-3 h-3 bg-green-500 rounded-full animate-pulse"></div>
                            <div>
                                <p class="text-xs text-gray-500">Live Conversions</p>
                                <p class="text-lg font-bold text-gray-900">12 Today</p>
                            </div>
                        </div>
                    </div>
                    
                    <div class="absolute top-6 right-6 bg-white/90 backdrop-blur-sm rounded-2xl p-4 shadow-lg border border-white/20">
                        <div class="flex items-center gap-3">
                            <div class="w-3 h-3 bg-blue-500 rounded-full animate-pulse"></div>
                            <div>
                                <p class="text-xs text-gray-500">ROAS</p>
                                <p class="text-lg font-bold text-gray-900">4.2x</p>
                            </div>
                        </div>
                    </div>
                    
                    <div class="absolute bottom-6 left-1/2 transform -translate-x-1/2 bg-white/90 backdrop-blur-sm rounded-2xl p-4 shadow-lg border border-white/20">
                        <div class="text-center">
                            <p class="text-xs text-gray-500">Campaign Health</p>
                            <div class="flex items-center gap-2">
                                <div class="w-2 h-2 bg-green-500 rounded-full"></div>
                                <p class="text-sm font-bold text-gray-900">Optimal</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- End of Process Section -->

<!-- Multi-Platform Advertising Section -->
<!-- Multi-Platform Advertising Section -->
<section class="py-16 lg:py-20 bg-gradient-to-br from-indigo-50 to-purple-50 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
            
            <!-- Left Side: Content -->
            <div data-aos="fade-right">
                <div class="inline-flex items-center gap-3 px-4 py-2 bg-white text-indigo-600 rounded-full text-sm font-semibold shadow-lg mb-6">
                    <i class="fas fa-globe-americas"></i>
                    Multi-Platform Mastery
                </div>
                
                <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-gray-900 mb-6 leading-tight">
                    We Meet Your Customers <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-600 to-purple-600">Where They Are</span>
                </h2>
                
                <p class="text-lg sm:text-xl text-gray-600 mb-8 leading-relaxed">
                    We don't push platforms—we pull customers. Strategic platform selection based on where your ideal audience actually spends time, with messaging that speaks their language.
                </p>

                <!-- Platform Strategy Cards -->
                <div class="space-y-4 sm:space-y-6">
                    <!-- Facebook Strategy -->
                    <div class="bg-white rounded-xl sm:rounded-2xl p-4 sm:p-6 shadow-lg border border-gray-100 hover:shadow-xl transition-all duration-300" data-aos="fade-up" data-aos-delay="200">
                        <div class="flex items-start gap-3 sm:gap-4">
                            <div class="w-10 h-10 sm:w-12 sm:h-12 bg-blue-100 rounded-lg sm:rounded-xl flex items-center justify-center flex-shrink-0">
                                <i class="fab fa-facebook text-blue-600 text-lg sm:text-xl"></i>
                            </div>
                            <div class="flex-1">
                                <h4 class="text-lg sm:text-xl font-bold text-gray-900 mb-2">Facebook & Meta</h4>
                                <p class="text-gray-600 mb-3 text-sm sm:text-base">Relationship-building and hyper-detailed audience targeting for proven conversions.</p>
                                <div class="flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-4 text-xs sm:text-sm">
                                    <span class="inline-flex items-center gap-2 text-blue-600 font-semibold">
                                        <i class="fas fa-check text-xs"></i>
                                        Advanced demographic targeting
                                    </span>
                                    <span class="inline-flex items-center gap-2 text-blue-600 font-semibold">
                                        <i class="fas fa-check text-xs"></i>
                                        Retargeting campaigns
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- TikTok Strategy -->
                    <div class="bg-white rounded-xl sm:rounded-2xl p-4 sm:p-6 shadow-lg border border-gray-100 hover:shadow-xl transition-all duration-300" data-aos="fade-up" data-aos-delay="300">
                        <div class="flex items-start gap-3 sm:gap-4">
                            <div class="w-10 h-10 sm:w-12 sm:h-12 bg-black rounded-lg sm:rounded-xl flex items-center justify-center flex-shrink-0">
                                <i class="fab fa-tiktok text-white text-lg sm:text-xl"></i>
                            </div>
                            <div class="flex-1">
                                <h4 class="text-lg sm:text-xl font-bold text-gray-900 mb-2">TikTok</h4>
                                <p class="text-gray-600 mb-3 text-sm sm:text-base">Viral potential and authentic storytelling that captures Gen Z and Millennial audiences.</p>
                                <div class="flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-4 text-xs sm:text-sm">
                                    <span class="inline-flex items-center gap-2 text-gray-700 font-semibold">
                                        <i class="fas fa-check text-xs"></i>
                                        Trend-driven content
                                    </span>
                                    <span class="inline-flex items-center gap-2 text-gray-700 font-semibold">
                                        <i class="fas fa-check text-xs"></i>
                                        Viral reach optimization
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Instagram Strategy -->
                    <div class="bg-white rounded-xl sm:rounded-2xl p-4 sm:p-6 shadow-lg border border-gray-100 hover:shadow-xl transition-all duration-300" data-aos="fade-up" data-aos-delay="400">
                        <div class="flex items-start gap-3 sm:gap-4">
                            <div class="w-10 h-10 sm:w-12 sm:h-12 bg-gradient-to-br from-purple-500 to-pink-500 rounded-lg sm:rounded-xl flex items-center justify-center flex-shrink-0">
                                <i class="fab fa-instagram text-white text-lg sm:text-xl"></i>
                            </div>
                            <div class="flex-1">
                                <h4 class="text-lg sm:text-xl font-bold text-gray-900 mb-2">Instagram</h4>
                                <p class="text-gray-600 mb-3 text-sm sm:text-base">Visual storytelling and influencer synergy that builds brand love and drives action.</p>
                                <div class="flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-4 text-xs sm:text-sm">
                                    <span class="inline-flex items-center gap-2 text-pink-600 font-semibold">
                                        <i class="fas fa-check text-xs"></i>
                                        Visual-first campaigns
                                    </span>
                                    <span class="inline-flex items-center gap-2 text-pink-600 font-semibold">
                                        <i class="fas fa-check text-xs"></i>
                                        Influencer partnerships
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Cross-Platform Benefit -->
                <div class="mt-6 sm:mt-8 bg-gradient-to-r from-indigo-500 to-purple-600 rounded-xl sm:rounded-2xl p-4 sm:p-6 text-white" data-aos="fade-up" data-aos-delay="500">
                    <div class="flex items-center gap-3 sm:gap-4">
                        <div class="w-10 h-10 sm:w-12 sm:h-12 bg-white/20 rounded-lg sm:rounded-xl flex items-center justify-center flex-shrink-0">
                            <i class="fas fa-sync-alt text-lg sm:text-xl"></i>
                        </div>
                        <div>
                            <h4 class="text-base sm:text-lg font-bold mb-1">Cross-Platform Retargeting</h4>
                            <p class="text-indigo-100 text-xs sm:text-sm">Follow your customers across platforms with unified messaging that drives conversions.</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Side: Platform Image -->
            <div class="relative" data-aos="fade-left" data-aos-delay="150">
                <div class="relative">
                    <!-- Main Image Container - Borderless -->
                    <div class="rounded-2xl sm:rounded-3xl overflow-hidden shadow-2xl">
                        <img 
                            src="../assets/paid-ad1.jpg" 
                            alt="Multi-Platform Advertising Campaign" 
                            class="w-full h-auto object-cover"
                        >
                    </div>
                    
                    <!-- Floating Platform Icons - Mobile Adjusted -->
                    <div class="absolute -top-2 -left-2 sm:-top-4 sm:-left-4 bg-white rounded-xl sm:rounded-2xl p-3 sm:p-4 shadow-xl border border-gray-100" data-aos="zoom-in" data-aos-delay="400">
                        <div class="flex items-center gap-2 sm:gap-3">
                            <div class="w-8 h-8 sm:w-10 sm:h-10 bg-blue-100 rounded-lg sm:rounded-xl flex items-center justify-center">
                                <i class="fab fa-facebook text-blue-600 text-sm sm:text-lg"></i>
                            </div>
                            <div>
                                <p class="text-xs text-gray-500">Facebook</p>
                                <p class="text-sm font-bold text-gray-900">2.9B+</p>
                            </div>
                        </div>
                    </div>
                    
                    <div class="absolute -top-2 -right-2 sm:-top-4 sm:-right-4 bg-white rounded-xl sm:rounded-2xl p-3 sm:p-4 shadow-xl border border-gray-100" data-aos="zoom-in" data-aos-delay="500">
                        <div class="flex items-center gap-2 sm:gap-3">
                            <div class="w-8 h-8 sm:w-10 sm:h-10 bg-black rounded-lg sm:rounded-xl flex items-center justify-center">
                                <i class="fab fa-tiktok text-white text-sm sm:text-lg"></i>
                            </div>
                            <div>
                                <p class="text-xs text-gray-500">TikTok</p>
                                <p class="text-sm font-bold text-gray-900">1B+</p>
                            </div>
                        </div>
                    </div>
                    
                    <div class="absolute -bottom-2 -left-2 sm:-bottom-4 sm:-left-4 bg-white rounded-xl sm:rounded-2xl p-3 sm:p-4 shadow-xl border border-gray-100" data-aos="zoom-in" data-aos-delay="600">
                        <div class="flex items-center gap-2 sm:gap-3">
                            <div class="w-8 h-8 sm:w-10 sm:h-10 bg-gradient-to-br from-purple-500 to-pink-500 rounded-lg sm:rounded-xl flex items-center justify-center">
                                <i class="fab fa-instagram text-white text-sm sm:text-lg"></i>
                            </div>
                            <div>
                                <p class="text-xs text-gray-500">Instagram</p>
