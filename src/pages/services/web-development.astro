<style is:global>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@300;400;500;600;700&display=swap');
        
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f8fafc;
            overflow-x: hidden;
        }
        
        /* Fexa Digital Signature Gradient Text */
        .gradient-text {
            background: linear-gradient(135deg, #c084fc 0%, #60a5fa 50%, #fbbf24 100%); /* Purple-Blue-Amber */
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            background-size: 200% auto;
            animation: gradient-shift 5s ease-in-out infinite;
        }

        /* Darker Hero Gradient */
        .hero-bg {
            background: linear-gradient(to bottom right, #1e1b4b, #312e81, #1e3a8a); /* Slate-900 to Indigo-900 */
        }

        @keyframes gradient-shift {
            0%, 100% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
        }
        
        /* Floating Animation for Images */
        .floating {
            animation: floating 4s ease-in-out infinite;
        }
        
        @keyframes floating {
            0% { transform: translate(0, 0px); }
            50% { transform: translate(0, -20px); }
            100% { transform: translate(0, -0px); }
        }
        
        /* Card Hover Effects */
        .card-hover {
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }
        
        .card-hover:hover {
            transform: translateY(-8px);
            box-shadow: 0 25px 50px -12px rgba(79, 70, 229, 0.15); /* Indigo shadow */
            border-color: #818cf8;
        }

        /* Abstract Pattern Background for Hero */
        .pattern-grid {
            background-image: linear-gradient(rgba(255, 255, 255, 0.05) 1px, transparent 1px),
            linear-gradient(90deg, rgba(255, 255, 255, 0.05) 1px, transparent 1px);
            background-size: 40px 40px;
        }

        /* Digital Pattern for Services */
        .digital-pattern {
            background-image: radial-gradient(circle at 1px 1px, rgba(0, 0, 0, 0.05) 1px, transparent 0);
            background-size: 20px 20px;
        }
</style>

<script is:inline>
document.addEventListener('DOMContentLoaded',function(){
    const sd=document.getElementById('sd-widget'),tgl=document.getElementById('sd-toggle'),opt=document.getElementById('sd-options');
    let open=false;
    if(sd&&tgl&&opt){
        tgl.addEventListener('click',e=>{
            e.stopPropagation();
            open=!open;
            if(open){
                sd.classList.add('active');
                if(window.innerWidth<768){
                    const b=document.createElement('div');
                    b.id='sd-backdrop',b.className='fixed inset-0 bg-black/10 z-40';
                    b.addEventListener('click',()=>{open=false;sd.classList.remove('active');b.remove()});
                    document.body.appendChild(b)
                }
            }else{
                open=false;sd.classList.remove('active');
                document.getElementById('sd-backdrop')?.remove()
            }
        });
        document.addEventListener('click',e=>{if(open&&!sd.contains(e.target)){open=false;sd.classList.remove('active');document.getElementById('sd-backdrop')?.remove()}});
        document.addEventListener('keydown',e=>{if(e.key==='Escape'&&open){open=false;sd.classList.remove('active');document.getElementById('sd-backdrop')?.remove()}});
        opt.querySelectorAll('a').forEach(o=>{o.addEventListener('click',()=>{open=false;sd.classList.remove('active');document.getElementById('sd-backdrop')?.remove()})})
    }
    const btt=document.getElementById('back-to-top'),btn=document.getElementById('btt-btn');
    if(btt&&btn){
        btn.addEventListener('click',()=>{window.scrollTo({top:0,behavior:'smooth'})});
        window.addEventListener('scroll',()=>{btt.classList.toggle('visible',window.pageYOffset>400)});
        btt.classList.toggle('visible',window.pageYOffset>400)
    }
});
</script>
