---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Custom Web Development & Design Services in Africa | Fexa Digital"
  description="We build high-performance, custom websites and web applications designed for speed, security, and scalability. Specializing in modern frameworks and local market needs."
  keywords="custom web development, web design agency, high-performance websites, web applications, full-stack development, ghana website development"
  canonical="https://fexadigital.com/services/web-development.html"
  
  
>
  <!-- End of Navigation-->


<!-- Hero Section -->
<section class="hero-bg text-white pt-20 pb-20 md:pt-32 md:pb-24 relative overflow-hidden" style="min-height: 50vh;">
    <!-- Background Image -->
    <div class="absolute inset-0 bg-cover bg-center bg-no-repeat" style="background-image: url('https://images.unsplash.com/photo-1555066931-4365d14bab8c?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80')"></div>
    
    <!-- Dark Overlay -->
    <div class="absolute inset-0 bg-black opacity-40"></div>
    
    <!-- Background Pattern -->
    <div class="absolute inset-0 pattern-grid opacity-50"></div>
    
    <!-- Glow Effects -->
    <div class="absolute top-0 right-0 -mt-20 -mr-20 w-96 h-96 bg-purple-600 rounded-full opacity-20 blur-3xl"></div>
    <div class="absolute bottom-0 left-0 -mb-20 -ml-20 w-96 h-96 bg-blue-600 rounded-full opacity-20 blur-3xl"></div>

    <div class="container mx-auto px-6 relative z-10 h-full flex items-center">
        <div class="max-w-5xl mx-auto text-center">
            <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold mb-6 tracking-tight" data-aos="fade-up">
                <span class="gradient-text">Web Development</span> Services
            </h1>
            <p class="text-lg md:text-xl text-indigo-100 max-w-3xl mx-auto leading-relaxed" data-aos="fade-up" data-aos-delay="100">
                Transform your digital presence with our comprehensive web development solutions tailored to your business needs.
            </p>
        </div>
    </div>
</section>

<!-- Web Services Overview (Grid) -->
<section class="py-20 px-4 lg:px-8 font-['Outfit'] digital-pattern bg-white" id="services">
    <div class="max-w-7xl mx-auto">
        <div class="text-center mb-16" data-aos="fade-up">
            <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold mt-2 text-gray-900">Comprehensive Web Solutions</h2>
            <p class="max-w-2xl mx-auto mt-4 text-gray-600 text-lg">We provide end-to-end web development services to help your business thrive in the digital landscape.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="services-container">
            <!-- Web Design Card -->
            <a href="#design" class="service-card block bg-white rounded-2xl p-8 shadow-lg border border-gray-100 group relative overflow-hidden" data-aos="fade-up" data-aos-delay="100">
                <div class="absolute top-0 right-0 w-32 h-32 bg-purple-50 rounded-full -mr-16 -mt-16 transition-transform group-hover:scale-150"></div>
                <div class="relative z-10">
                    <div class="w-14 h-14 rounded-xl bg-purple-100 p-3 text-purple-600 mb-6 flex items-center justify-center">
                        <span class="material-icons text-3xl">design_services</span>
                    </div>
                    <h3 class="text-2xl font-bold text-gray-900 mb-3 group-hover:text-purple-600 transition-colors">Web Design & UI/UX</h3>
                    <p class="text-gray-600 mb-5 leading-relaxed">
                        Modern, user-friendly websites tailored to your specific business goals. Built to convert visitors into customers.
                    </p>
                    <span class="text-purple-600 font-semibold text-sm flex items-center">
                        Learn More <i class="fas fa-arrow-right ml-2 text-xs transition-transform group-hover:translate-x-1"></i>
                    </span>
                </div>
            </a>

            <!-- Web App Development Card -->
            <a href="#webapp" class="service-card block bg-white rounded-2xl p-8 shadow-lg border border-gray-100 group relative overflow-hidden" data-aos="fade-up" data-aos-delay="200">
                <div class="absolute top-0 right-0 w-32 h-32 bg-blue-50 rounded-full -mr-16 -mt-16 transition-transform group-hover:scale-150"></div>
                <div class="relative z-10">
                    <div class="w-14 h-14 rounded-xl bg-blue-100 p-3 text-blue-600 mb-6 flex items-center justify-center">
                        <span class="material-icons text-3xl">code</span>
                    </div>
                    <h3 class="text-2xl font-bold text-gray-900 mb-3 group-hover:text-blue-600 transition-colors">Custom Web Apps</h3>
                    <p class="text-gray-600 mb-5 leading-relaxed">
                        Robust, high-performance web apps using React, Node.js and Next.js. Scalable software for your unique needs.
                    </p>
                    <span class="text-blue-600 font-semibold text-sm flex items-center">
                        Learn More <i class="fas fa-arrow-right ml-2 text-xs transition-transform group-hover:translate-x-1"></i>
                    </span>
                </div>
            </a>

            <!-- SEO Card -->
            <a href="#seo" class="service-card block bg-white rounded-2xl p-8 shadow-lg border border-gray-100 group relative overflow-hidden" data-aos="fade-up" data-aos-delay="300">
                <div class="absolute top-0 right-0 w-32 h-32 bg-green-50 rounded-full -mr-16 -mt-16 transition-transform group-hover:scale-150"></div>
                <div class="relative z-10">
                    <div class="w-14 h-14 rounded-xl bg-green-100 p-3 text-green-600 mb-6 flex items-center justify-center">
                        <span class="material-icons text-3xl">trending_up</span>
                    </div>
                    <h3 class="text-2xl font-bold text-gray-900 mb-3 group-hover:text-green-600 transition-colors">SEO Optimization</h3>
                    <p class="text-gray-600 mb-5 leading-relaxed">
                        Dominate search rankings and drive organic traffic. Technical audits, content strategy, and keyword growth.
                    </p>
                    <span class="text-green-600 font-semibold text-sm flex items-center">
                        Learn More <i class="fas fa-arrow-right ml-2 text-xs transition-transform group-hover:translate-x-1"></i>
                    </span>
                </div>
            </a>
        </div>
    </div>
</section>

<!-- Design & User Experience (UX/UI) Section -->
<section id="design" class="py-24 bg-gray-50 overflow-hidden relative">
    <div class="absolute left-0 top-0 w-1/3 h-full bg-gradient-to-r from-purple-50 to-transparent opacity-50"></div>
    <div class="container mx-auto px-6 relative z-10">
        <div class="flex flex-col lg:flex-row gap-16">
            
            <!-- Left Column: Content -->
            <div class="lg:w-5/12" data-aos="fade-right">
                <span class="inline-flex items-center px-4 py-1.5 bg-indigo-100 text-indigo-800 rounded-full text-sm font-bold mb-6">
                    <i class="fas fa-paint-brush mr-2 text-xs"></i> User-Centric Design
                </span>
                <h2 class="text-4xl lg:text-5xl font-extrabold text-gray-900 mb-6 leading-tight">
                    Design that <span class="text-indigo-600">Converts</span>
                </h2>
                <p class="text-lg text-gray-600 mb-6 leading-relaxed">
                    We start every project with a <strong>user-centric design</strong> philosophy. We don't just build websites; we create intuitive digital experiences that guide visitors through a logical journey, transforming casual browsers into valuable leads.
                </p>
                <p class="text-lg text-gray-600 mb-8 leading-relaxed">
                    Our designs are engineered for <strong>accessibility</strong> and <strong>usability</strong>, ensuring your content reaches everyone, regardless of device or ability.
                </p>
                
                <a href="/website-quote" class="inline-flex items-center px-8 py-4 bg-indigo-600 text-white font-bold rounded-xl hover:bg-indigo-700 transition-all shadow-lg hover:shadow-indigo-500/30 group">
                    Start Your Design Project
                    <i class="fas fa-arrow-right ml-2 group-hover:translate-x-1 transition-transform"></i>
                </a>
            </div>
            
            <!-- Right Column: Features Grid -->
            <div class="lg:w-7/12 grid grid-cols-1 md:grid-cols-2 gap-6" data-aos="fade-left">
                <!-- Feature 1 -->
                <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 hover:shadow-md transition-shadow md:col-span-2">
                    <div class="flex items-start gap-4">
                        <div class="w-12 h-12 rounded-lg bg-indigo-50 text-indigo-600 flex items-center justify-center flex-shrink-0">
                            <i class="fas fa-mobile-alt text-xl"></i>
                        </div>
                        <div>
                            <h4 class="text-xl font-bold text-gray-900 mb-2">Mobile-First Responsiveness</h4>
                            <p class="text-gray-600 text-sm">
                                We guarantee full responsiveness. Your site will look stellar and function perfectly on every screen size, from 4K desktops to smartphones. This is crucial for maintaining excellent search rankings (SEO) and user retention.
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Feature 2 -->
                <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 hover:shadow-md transition-shadow">
                    <div class="w-12 h-12 rounded-lg bg-pink-50 text-pink-600 flex items-center justify-center mb-4">
                        <i class="fas fa-bullseye text-xl"></i>
                    </div>
                    <h4 class="text-xl font-bold text-gray-900 mb-2">Conversion Optimized</h4>
                    <p class="text-gray-600 text-sm">
                        Strategic layouts with high-impact Call-to-Actions (CTAs) and simplified navigation to maximize ROI.
                    </p>
                </div>

                <!-- Feature 3 -->
                <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 hover:shadow-md transition-shadow">
                    <div class="w-12 h-12 rounded-lg bg-teal-50 text-teal-600 flex items-center justify-center mb-4">
                        <i class="fas fa-bolt text-xl"></i>
                    </div>
                    <h4 class="text-xl font-bold text-gray-900 mb-2">Performance First</h4>
                    <p class="text-gray-600 text-sm">
                        We balance stunning visuals with exceptional speed. Fast loading times decrease bounce rates and boost SEO.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Custom Web App Section -->
<section id="webapp" class="py-24 bg-white">
    <div class="container mx-auto px-6">
        <div class="flex flex-col lg:flex-row items-center gap-16">
            <!-- Visual Representation -->
            <div class="lg:w-1/2 order-2 lg:order-1 hidden lg:block" data-aos="fade-right">
                <div class="bg-gradient-to-br from-slate-800 to-indigo-900 rounded-3xl p-8 shadow-2xl relative overflow-hidden group">
                    <div class="absolute top-0 right-0 p-10 opacity-10">
                        <i class="fas fa-code text-9xl text-white"></i>
                    </div>
                    <!-- Mockup -->
                    <div class="bg-slate-900 rounded-xl border border-slate-700 p-4 mb-6 shadow-xl transform group-hover:translate-y-[-5px] transition-transform duration-500">
                        <div class="flex gap-2 mb-4 border-b border-slate-700 pb-4">
                            <div class="w-3 h-3 bg-red-500 rounded-full"></div>
                            <div class="w-3 h-3 bg-yellow-500 rounded-full"></div>
                            <div class="w-3 h-3 bg-green-500 rounded-full"></div>
                        </div>
                        <div class="space-y-3">
                            <div class="flex gap-4">
                                <div class="w-1/4 h-24 bg-slate-800 rounded-lg animate-pulse"></div>
                                <div class="w-3/4 space-y-3">
                                    <div class="h-4 bg-slate-700 rounded w-full"></div>
                                    <div class="h-4 bg-slate-700 rounded w-5/6"></div>
                                    <div class="h-20 bg-indigo-900/30 rounded border border-indigo-500/20 mt-2"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- Tech Stack Icons -->
                    <div class="flex justify-between items-center px-4">
                        <i class="fab fa-react text-blue-400 text-3xl"></i>
                        <i class="fab fa-node text-green-500 text-3xl"></i>
                        <i class="fas fa-database text-yellow-500 text-3xl"></i>
                        <i class="fab fa-aws text-orange-500 text-3xl"></i>
                    </div>
                </div>
            </div>
            
            <!-- Content -->
            <div class="lg:w-1/2 order-1 lg:order-2" data-aos="fade-left">
                <span class="inline-flex items-center px-4 py-1.5 bg-blue-100 text-blue-800 rounded-full text-sm font-bold mb-6">
                    <i class="fas fa-cogs mr-2 text-xs"></i> Application Development
                </span>
                <h2 class="text-4xl font-extrabold text-gray-900 mb-6">Custom Web Applications</h2>
                <p class="text-xl text-gray-600 mb-8">We build powerful, scalable web applications tailored to solve your specific business challenges. From MVPs to full SaaS platforms.</p>
                
                <div class="space-y-6 mb-10">
                    <div class="group flex items-start">
                        <div class="w-10 h-10 rounded-full bg-blue-50 text-blue-600 flex items-center justify-center mr-4 flex-shrink-0">
                            <i class="fas fa-layer-group"></i>
                        </div>
                        <div>
                            <h4 class="text-lg font-bold text-gray-900 mb-1">Full-Stack Development</h4>
                            <p class="text-gray-600 text-sm">End-to-end solutions using modern stacks (MERN, Next.js).</p>
                        </div>
                    </div>
                    
                    <div class="group flex items-start">
                        <div class="w-10 h-10 rounded-full bg-blue-50 text-blue-600 flex items-center justify-center mr-4 flex-shrink-0">
                            <i class="fas fa-plug"></i>
                        </div>
                        <div>
                            <h4 class="text-lg font-bold text-gray-900 mb-1">API Integration</h4>
                            <p class="text-gray-600 text-sm">Seamless connection with third-party services (Stripe, CRMs, etc).</p>
                        </div>
                    </div>
                    
                    <div class="group flex items-start">
                        <div class="w-10 h-10 rounded-full bg-blue-50 text-blue-600 flex items-center justify-center mr-4 flex-shrink-0">
                            <i class="fas fa-database"></i>
                        </div>
                        <div>
                            <h4 class="text-lg font-bold text-gray-900 mb-1">Secure Database Design</h4>
                            <p class="text-gray-600 text-sm">Optimized data structures for performance, security, and scalability.</p>
                        </div>
                    </div>
                </div>
                
                <a href="/contact-us#contact-form" class="inline-flex items-center px-8 py-4 bg-blue-600 text-white font-bold rounded-xl hover:bg-blue-700 transition-all shadow-lg hover:shadow-blue-500/30 group">
                    Discuss Your Project
                    <i class="fas fa-arrow-right ml-2 group-hover:translate-x-1 transition-transform"></i>
                </a>
            </div>
        </div>
    </div>
</section>

<!-- SEO Optimization Section -->
<section id="seo" class="py-24 bg-gray-50 relative">
    <div class="absolute inset-0 pattern-grid opacity-5"></div>
    <div class="container mx-auto px-6 relative z-10">
        <div class="text-center max-w-3xl mx-auto mb-16" data-aos="fade-up">
            <span class="inline-flex items-center px-4 py-1.5 bg-green-100 text-green-800 rounded-full text-sm font-bold mb-6">
                <i class="fas fa-chart-line mr-2 text-xs"></i> Organic Growth
            </span>
            <h2 class="text-4xl lg:text-5xl font-extrabold text-gray-900 mb-6">Full-Spectrum SEO</h2>
            <p class="text-xl text-gray-600">
                Acquire qualified, free organic traffic by ensuring your business is found on the first page of Google. Our data-driven strategies turn your website into a long-term customer acquisition machine.
            </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" data-aos="fade-up" data-aos-delay="100">
            <!-- SEO Feature 1 -->
            <div class="bg-white p-8 rounded-2xl shadow-sm border border-gray-100 hover:border-green-400 transition-colors">
                <div class="w-12 h-12 bg-green-50 text-green-600 rounded-lg flex items-center justify-center mb-6 text-xl">
                    <i class="fas fa-search"></i>
                </div>
                <h4 class="text-lg font-bold text-gray-900 mb-3">Keyword Strategy</h4>
                <p class="text-gray-600 text-sm leading-relaxed">
                    We uncover profitable keywords for your niche that can be attained within a reasonable timeframe, going beyond the obvious search terms.
                </p>
            </div>

            <!-- SEO Feature 2 -->
            <div class="bg-white p-8 rounded-2xl shadow-sm border border-gray-100 hover:border-green-400 transition-colors">
                <div class="w-12 h-12 bg-green-50 text-green-600 rounded-lg flex items-center justify-center mb-6 text-xl">
                    <i class="fas fa-bug"></i>
                </div>
                <h4 class="text-lg font-bold text-gray-900 mb-3">Technical Audit</h4>
                <p class="text-gray-600 text-sm leading-relaxed">
                    We resolve technical issues across 130+ categories: crawlability, indexing, schema markup, and ensuring strict HTTPS security.
                </p>
            </div>

            <!-- SEO Feature 3 -->
            <div class="bg-white p-8 rounded-2xl shadow-sm border border-gray-100 hover:border-green-400 transition-colors">
                <div class="w-12 h-12 bg-green-50 text-green-600 rounded-lg flex items-center justify-center mb-6 text-xl">
                    <i class="fas fa-pencil-alt"></i>
                </div>
                <h4 class="text-lg font-bold text-gray-900 mb-3">On-Page Optimization</h4>
                <p class="text-gray-600 text-sm leading-relaxed">
                    We refine your content to answer customer questions, optimizing titles, meta descriptions, and internal linking structures.
                </p>
            </div>

            <!-- SEO Feature 4 -->
            <div class="bg-white p-8 rounded-2xl shadow-sm border border-gray-100 hover:border-green-400 transition-colors">
                <div class="w-12 h-12 bg-green-50 text-green-600 rounded-lg flex items-center justify-center mb-6 text-xl">
                    <i class="fas fa-link"></i>
                </div>
                <h4 class="text-lg font-bold text-gray-900 mb-3">Backlink Analysis</h4>
                <p class="text-gray-600 text-sm leading-relaxed">
                    We monitor your profile and competitor rankings to build an authority strategy that unseats them from top spots.
                </p>
            </div>

            <!-- SEO Feature 5 -->
            <div class="bg-white p-8 rounded-2xl shadow-sm border border-gray-100 hover:border-green-400 transition-colors">
                <div class="w-12 h-12 bg-green-50 text-green-600 rounded-lg flex items-center justify-center mb-6 text-xl">
                    <i class="fas fa-tachometer-alt"></i>
                </div>
                <h4 class="text-lg font-bold text-gray-900 mb-3">Core Web Vitals</h4>
                <p class="text-gray-600 text-sm leading-relaxed">
                    Speed is a ranking factor. We optimize code, images, and server response times to meet Google's performance standards.
                </p>
            </div>

            <!-- SEO Feature 6 -->
            <div class="bg-white p-8 rounded-2xl shadow-sm border border-gray-100 hover:border-green-400 transition-colors">
                <div class="w-12 h-12 bg-green-50 text-green-600 rounded-lg flex items-center justify-center mb-6 text-xl">
                    <i class="fas fa-file-invoice"></i>
                </div>
                <h4 class="text-lg font-bold text-gray-900 mb-3">Monthly Reporting</h4>
                <p class="text-gray-600 text-sm leading-relaxed">
                    Transparent ROI. We provide regular keyword ranking reports to clearly demonstrate performance and traffic growth.
                </p>
            </div>
        </div>
        
        <div class="mt-16 text-center">
            <a href="/contact-us#contact-form" class="inline-flex items-center px-8 py-4 bg-green-600 text-white font-bold rounded-xl hover:bg-green-700 transition-all shadow-lg hover:shadow-green-500/30 group">
                Request SEO Service
                <i class="fas fa-arrow-right ml-2 group-hover:translate-x-1 transition-transform"></i>
            </a>
        </div>
    </div>
</section>

<!-- Website Maintenance Section -->
<section id="maintain" class="py-24 bg-slate-900 text-white relative overflow-hidden">
    <!-- Dark Background Effects -->
    <div class="absolute top-0 right-0 w-96 h-96 bg-orange-600/10 rounded-full blur-3xl"></div>
    <div class="absolute bottom-0 left-0 w-96 h-96 bg-blue-600/10 rounded-full blur-3xl"></div>
    
    <div class="container mx-auto px-6 relative z-10">
        <div class="flex flex-col lg:flex-row gap-16 items-start">
            
            <!-- Left Column: Info -->
            <div class="lg:w-5/12 sticky top-24" data-aos="fade-right">
                <span class="inline-flex items-center px-4 py-1.5 bg-orange-900/30 border border-orange-500/30 text-orange-400 rounded-full text-sm font-bold mb-6">
                    <i class="fas fa-shield-alt mr-2 text-xs"></i> 24/7 Protection
                </span>
                <h2 class="text-4xl font-extrabold mb-6">Website Care & Maintenance</h2>
                <p class="text-slate-300 text-lg mb-8 leading-relaxed">
                    Protect your digital investment. With the average website being attacked frequently, proactive security is non-negotiable. We keep your site secure, updated, and fast.
                </p>
                
                <ul class="space-y-4 mb-10">
                    <li class="flex items-start">
                        <i class="fas fa-check-circle text-orange-500 mt-1 mr-3"></i>
                        <div>
                            <strong class="block text-white">Proactive Security Scanning</strong>
                            <span class="text-slate-400 text-sm">Malware, virus, and SQL injection protection.</span>
                        </div>
                    </li>
                    <li class="flex items-start">
                        <i class="fas fa-check-circle text-orange-500 mt-1 mr-3"></i>
                        <div>
                            <strong class="block text-white">Reliable Backups</strong>
                            <span class="text-slate-400 text-sm">Daily/Hourly off-site backups for instant recovery.</span>
                        </div>
                    </li>
                    <li class="flex items-start">
                        <i class="fas fa-check-circle text-orange-500 mt-1 mr-3"></i>
                        <div>
                            <strong class="block text-white">Performance Tuning</strong>
                            <span class="text-slate-400 text-sm">Uptime monitoring and speed optimizations.</span>
                        </div>
                    </li>
                </ul>
                
                <a href="/contact-us" class="text-orange-400 font-bold hover:text-orange-300 flex items-center group">
                    Talk to an Expert <i class="fas fa-arrow-right ml-2 group-hover:translate-x-1 transition-transform"></i>
                </a>
            </div>

            <!-- Right Column: Maintenance Plans -->
            <div class="lg:w-7/12 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 xl:grid-cols-2 gap-6" data-aos="fade-left">
                <!-- Plan 1 -->
                <div class="bg-slate-800 rounded-2xl p-6 border border-slate-700 hover:border-orange-500/50 transition-colors">
                    <h4 class="text-xl font-bold text-white mb-2">Basic Plan</h4>
                    <p class="text-slate-400 text-sm mb-4">Essential security for personal sites.</p>
                    <div class="text-3xl font-bold text-white mb-6">GH¢300<span class="text-sm text-slate-500 font-normal">/mo</span></div>
                    <ul class="space-y-3 text-sm text-slate-300 mb-6">
                        <li class="flex items-center"><i class="fas fa-check text-green-500 mr-2"></i> Weekly Backups</li>
                        <li class="flex items-center"><i class="fas fa-check text-green-500 mr-2"></i> Theme & Plugin Updates</li>
                        <li class="flex items-center"><i class="fas fa-check text-green-500 mr-2"></i> Malware Scans</li>
                        <li class="flex items-center"><i class="fas fa-clock text-orange-400 mr-2"></i> 2 Hours Website Edits</li>
                    </ul>
                    <a href="#" class="block w-full py-2 border border-slate-600 rounded-lg text-center text-white hover:bg-slate-700 transition-colors">Choose Basic</a>
                </div>

                <!-- Plan 2 (Featured) -->
                <div class="bg-gradient-to-b from-slate-800 to-slate-900 rounded-2xl p-6 border-2 border-orange-500 relative transform md:-translate-y-4">
                    <div class="absolute top-0 right-0 bg-orange-500 text-white text-xs font-bold px-3 py-1 rounded-bl-lg rounded-tr-lg">POPULAR</div>
                    <h4 class="text-xl font-bold text-white mb-2">Standard Plan</h4>
                    <p class="text-slate-400 text-sm mb-4">Perfect for growing businesses.</p>
                    <div class="text-3xl font-bold text-white mb-6">GH¢700<span class="text-sm text-slate-500 font-normal">/mo</span></div>
                    <ul class="space-y-3 text-sm text-slate-300 mb-6">
