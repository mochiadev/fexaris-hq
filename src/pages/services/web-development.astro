---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Web & Product Development Services | Fexaris Studio"
  description="Custom corporate websites, SaaS applications, client portals, and UX/UI design systems engineered for conversion and scalability."
  keywords="web product engineering, custom web application development, cms development webflow framer, saas development agency, ux ui design systems"
  canonical="https://fexadigital.com/services/web-development.html"
  
  
>
  <!-- End of Navigation-->


<!-- Hero Section -->
<section class="hero-bg text-white pt-20 pb-20 md:pt-32 md:pb-24 relative overflow-hidden" style="min-height: 50vh;">
    <!-- Background Image -->
    <div class="absolute inset-0 bg-cover bg-center bg-no-repeat" style="background-image: url('https://images.unsplash.com/photo-1555066931-4365d14bab8c?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80')"></div>
    
    <!-- Dark Overlay -->
    <div class="absolute inset-0 bg-black opacity-40"></div>
    
    <!-- Background Pattern -->
    <div class="absolute inset-0 pattern-grid opacity-50"></div>
    
    <!-- Glow Effects -->
    <div class="absolute top-0 right-0 -mt-20 -mr-20 w-96 h-96 bg-purple-600 rounded-full opacity-20 blur-3xl"></div>
    <div class="absolute bottom-0 left-0 -mb-20 -ml-20 w-96 h-96 bg-blue-600 rounded-full opacity-20 blur-3xl"></div>

    <div class="container mx-auto px-6 relative z-10 h-full flex items-center">
        <div class="max-w-5xl mx-auto text-center">
            <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold mb-6 tracking-tight" data-aos="fade-up">
                <span class="gradient-text">Web & Product Development</span>
            </h1>
            <p class="text-lg md:text-xl text-indigo-100 max-w-3xl mx-auto leading-relaxed" data-aos="fade-up" data-aos-delay="100">
                We engineer custom websites, SaaS platforms, and client portals designed for speed, security, and conversion — built to perform, convert, and scale.
            </p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center items-center mb-10" data-aos="fade-up" data-aos-delay="200">
                <a href="/website-quote" class="btn-dark-hero btn-lg btn-shimmer">
                    Get Your Free Quote
                    <i class="fas fa-arrow-right ml-3"></i>
                </a>
                <a href="#process" class="btn-ghost btn-lg">
                    <i class="fas fa-sitemap mr-2"></i>
                    How It Works
                </a>
            </div>
            <div class="grid grid-cols-3 gap-6 max-w-lg mx-auto" data-aos="fade-up" data-aos-delay="300">
                <div class="text-center">
                    <p class="text-2xl sm:text-3xl font-bold text-white">90+</p>
                    <p class="text-sm text-indigo-100">Lighthouse Performance</p>
                </div>
                <div class="text-center">
                    <p class="text-2xl sm:text-3xl font-bold text-white">100+</p>
                    <p class="text-sm text-indigo-100">Projects Built</p>
                </div>
                <div class="text-center">
                    <p class="text-2xl sm:text-3xl font-bold text-white">50+</p>
                    <p class="text-sm text-indigo-100">Businesses Served</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Web Services Overview (Grid) -->
<section class="py-20 px-4 lg:px-8 font-sans digital-pattern bg-white" id="services">
    <div class="max-w-7xl mx-auto">
        <div class="text-center mb-16" data-aos="fade-up">
            <span class="inline-block px-4 py-2 bg-purple-100 text-purple-700 rounded-full text-sm font-semibold mb-4">What We Build</span>
            <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold mt-2 text-gray-900">End-to-End Web Solutions</h2>
            <p class="max-w-2xl mx-auto mt-4 text-gray-600 text-lg">From high-converting marketing sites to full web products, we deliver every layer of your digital presence.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8" id="services-container">
            <!-- WordPress Development Card -->
            <div class="service-card block bg-white rounded-2xl p-8 shadow-lg border border-gray-100 group relative overflow-hidden" data-aos="fade-up" data-aos-delay="100">
                <div class="absolute top-0 right-0 w-32 h-32 bg-purple-50 rounded-full -mr-16 -mt-16 transition-transform group-hover:scale-150"></div>
                <div class="relative z-10">
                    <div class="w-14 h-14 rounded-xl bg-purple-100 p-3 text-purple-600 mb-6 flex items-center justify-center">
                        <i class="fab fa-wordpress text-3xl"></i>
                    </div>
                    <h3 class="text-2xl font-bold text-gray-900 mb-3 group-hover:text-purple-600 transition-colors">WordPress Development</h3>
                    <p class="text-gray-600 mb-5 leading-relaxed">
                        Custom theme and plugin development, headless WordPress, and full site migrations — engineered for speed, security, and easy self-management.
                    </p>
                    <ul class="space-y-2 text-gray-600 text-sm mb-6">
                        <li class="flex items-center"><i class="fas fa-check text-green-500 mr-3"></i>Custom Themes & Plugins</li>
                        <li class="flex items-center"><i class="fas fa-check text-green-500 mr-3"></i>Headless WordPress (Next.js / React)</li>
                        <li class="flex items-center"><i class="fas fa-check text-green-500 mr-3"></i>Speed & Security Optimization</li>
                    </ul>
                    <a href="/website-quote" class="btn-secondary btn-md">
                        Get This Service <i class="fas fa-arrow-right ml-2 text-xs transition-transform group-hover:translate-x-1"></i>
                    </a>
                </div>
            </div>

            <!-- Webflow Development Card -->
            <div class="service-card block bg-white rounded-2xl p-8 shadow-lg border border-gray-100 group relative overflow-hidden" data-aos="fade-up" data-aos-delay="200">
                <div class="absolute top-0 right-0 w-32 h-32 bg-blue-50 rounded-full -mr-16 -mt-16 transition-transform group-hover:scale-150"></div>
                <div class="relative z-10">
                    <div class="w-14 h-14 rounded-xl bg-blue-100 p-3 text-blue-600 mb-6 flex items-center justify-center">
                        <svg class="w-7 h-7 fill-current" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="m24 4.515-7.658 14.97H9.149l3.205-6.204h-.144C9.566 16.713 5.621 18.973 0 19.485v-6.118s3.596-.213 5.71-2.435H0V4.515h6.417v5.278l.144-.001 2.622-5.277h4.854v5.244h.144l2.72-5.244H24Z"/></svg>
                    </div>
                    <h3 class="text-2xl font-bold text-gray-900 mb-3 group-hover:text-blue-600 transition-colors">Webflow Development</h3>
                    <p class="text-gray-600 mb-5 leading-relaxed">
                        Bespoke, conversion-focused Webflow builds with clean CMS collections, refined interactions, and seamless third-party integrations.
                    </p>
                    <ul class="space-y-2 text-gray-600 text-sm mb-6">
                        <li class="flex items-center"><i class="fas fa-check text-green-500 mr-3"></i>Custom Webflow Site Builds</li>
                        <li class="flex items-center"><i class="fas fa-check text-green-500 mr-3"></i>CMS Collections & Dynamic Content</li>
                        <li class="flex items-center"><i class="fas fa-check text-green-500 mr-3"></i>Site Migrations & Optimization</li>
                    </ul>
                    <a href="/website-quote" class="btn-secondary btn-md">
                        Get This Service <i class="fas fa-arrow-right ml-2 text-xs transition-transform group-hover:translate-x-1"></i>
                    </a>
                </div>
            </div>

            <!-- UI/UX Design Card -->
            <div class="service-card block bg-white rounded-2xl p-8 shadow-lg border border-gray-100 group relative overflow-hidden" data-aos="fade-up" data-aos-delay="300">
                <div class="absolute top-0 right-0 w-32 h-32 bg-indigo-50 rounded-full -mr-16 -mt-16 transition-transform group-hover:scale-150"></div>
                <div class="relative z-10">
                    <div class="w-14 h-14 rounded-xl bg-indigo-100 p-3 text-indigo-600 mb-6 flex items-center justify-center">
                        <span class="material-icons text-3xl">palette</span>
                    </div>
                    <h3 class="text-2xl font-bold text-gray-900 mb-3 group-hover:text-indigo-600 transition-colors">UI/UX Design</h3>
                    <p class="text-gray-600 mb-5 leading-relaxed">
                        Complete design systems, user flows, and high-quality web & mobile app UI deliverables — available standalone or included in any build.
                    </p>
                    <ul class="space-y-2 text-gray-600 text-sm mb-6">
                        <li class="flex items-center"><i class="fas fa-check text-green-500 mr-3"></i>Figma Design Systems & UI Kits</li>
                        <li class="flex items-center"><i class="fas fa-check text-green-500 mr-3"></i>Web & Mobile App Interfaces</li>
                        <li class="flex items-center"><i class="fas fa-check text-green-500 mr-3"></i>Interactive Prototypes</li>
                    </ul>
                    <a href="/website-quote" class="btn-secondary btn-md">
                        Get This Service <i class="fas fa-arrow-right ml-2 text-xs transition-transform group-hover:translate-x-1"></i>
                    </a>
                </div>
            </div>

            <!-- Full-Stack Development Card -->
            <div class="service-card block bg-white rounded-2xl p-8 shadow-lg border border-gray-100 group relative overflow-hidden" data-aos="fade-up" data-aos-delay="400">
                <div class="absolute top-0 right-0 w-32 h-32 bg-teal-50 rounded-full -mr-16 -mt-16 transition-transform group-hover:scale-150"></div>
                <div class="relative z-10">
                    <div class="w-14 h-14 rounded-xl bg-teal-100 p-3 text-teal-600 mb-6 flex items-center justify-center">
                        <span class="material-icons text-3xl">layer_group</span>
                    </div>
                    <h3 class="text-2xl font-bold text-gray-900 mb-3 group-hover:text-teal-600 transition-colors">Full-Stack Development</h3>
                    <p class="text-gray-600 mb-5 leading-relaxed">
                        Custom web applications, client portals, and headless CMS platforms built on React, Node.js, and Python — purpose-built to scale with your business.
                    </p>
                    <ul class="space-y-2 text-gray-600 text-sm mb-6">
                        <li class="flex items-center"><i class="fas fa-check text-green-500 mr-3"></i>Custom Web Apps & SaaS</li>
                        <li class="flex items-center"><i class="fas fa-check text-green-500 mr-3"></i>Client Portals & Dashboards</li>
                        <li class="flex items-center"><i class="fas fa-check text-green-500 mr-3"></i>Headless CMS & API Architectures</li>
                    </ul>
                    <a href="/website-quote" class="btn-secondary btn-md">
                        Get This Service <i class="fas fa-arrow-right ml-2 text-xs transition-transform group-hover:translate-x-1"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Process Section -->
<section id="process" class="py-20 bg-white overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid lg:grid-cols-2 gap-16 items-center">
            <div data-aos="fade-right">
                <div class="inline-flex items-center gap-3 px-4 py-2 bg-purple-100 text-purple-700 rounded-full text-sm font-semibold mb-6">
                    <i class="fas fa-sitemap"></i>
                    Our 3-Step Process
                </div>
                <h2 class="text-4xl sm:text-5xl font-extrabold text-gray-900 mb-6 leading-tight">
                    From <span class="text-transparent bg-clip-text bg-gradient-to-r from-purple-600 to-cyan-500">Idea to Impact</span>
                </h2>
                <p class="text-xl text-gray-600 mb-8 leading-relaxed">
                    A transparent, collaborative process that turns your vision into a high-performing web asset — on time and on budget.
                </p>

                <div class="bg-gradient-to-br from-gray-50 to-purple-50/30 rounded-2xl p-8 border border-gray-100">
                    <div class="space-y-8">
                        <div class="flex items-start gap-6 group" data-aos="fade-up" data-aos-delay="200">
                            <div class="flex-shrink-0">
                                <div class="w-12 h-12 bg-white border-2 border-purple-200 rounded-xl flex items-center justify-center shadow-sm group-hover:shadow-md group-hover:border-purple-300 transition-all duration-300">
                                    <div class="w-8 h-8 bg-gradient-to-br from-purple-600 to-cyan-500 rounded-lg flex items-center justify-center">
                                        <i class="fas fa-pen-ruler text-white text-sm"></i>
                                    </div>
                                </div>
                            </div>
                            <div class="flex-1">
                                <h4 class="text-xl font-bold text-gray-900 mb-3 group-hover:text-purple-600 transition-colors">Discover & Design</h4>
                                <p class="text-gray-600 leading-relaxed mb-4">
                                    We map your goals, users, and brand, then design a user-centric interface that turns visitors into leads.
                                </p>
                            </div>
                        </div>

                        <div class="flex items-start gap-6 group" data-aos="fade-up" data-aos-delay="300">
                            <div class="flex-shrink-0">
                                <div class="w-12 h-12 bg-white border-2 border-blue-200 rounded-xl flex items-center justify-center shadow-sm group-hover:shadow-md group-hover:border-blue-300 transition-all duration-300">
                                    <div class="w-8 h-8 bg-gradient-to-br from-blue-500 to-cyan-600 rounded-lg flex items-center justify-center">
                                        <i class="fas fa-code text-white text-sm"></i>
                                    </div>
                                </div>
                            </div>
                            <div class="flex-1">
                                <h4 class="text-xl font-bold text-gray-900 mb-3 group-hover:text-blue-600 transition-colors">Build & Launch</h4>
                                <p class="text-gray-600 leading-relaxed mb-4">
                                    We engineer clean, scalable code and deploy your site with best-in-class security, speed, and reliability.
                                </p>
                            </div>
                        </div>

                        <div class="flex items-start gap-6 group" data-aos="fade-up" data-aos-delay="400">
                            <div class="flex-shrink-0">
                                <div class="w-12 h-12 bg-white border-2 border-green-200 rounded-xl flex items-center justify-center shadow-sm group-hover:shadow-md group-hover:border-green-300 transition-all duration-300">
                                    <div class="w-8 h-8 bg-gradient-to-br from-green-500 to-emerald-600 rounded-lg flex items-center justify-center">
                                        <i class="fas fa-rocket text-white text-sm"></i>
                                    </div>
                                </div>
                            </div>
                            <div class="flex-1">
                                <h4 class="text-xl font-bold text-gray-900 mb-3 group-hover:text-green-600 transition-colors">Optimize & Maintain</h4>
                                <p class="text-gray-600 leading-relaxed mb-4">
                                    We keep your website fast, secure, and continuously improving — so it keeps converting long after launch.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="relative" data-aos="fade-left" data-aos-delay="150">
                <div class="relative">
                    <div class="bg-gradient-to-br from-purple-500 to-cyan-500 rounded-3xl p-1 shadow-2xl">
                        <div class="bg-white rounded-2xl overflow-hidden relative">
                            <img src="../assets/web-illus.png" alt="Web Development Process Illustration" class="w-full h-auto object-cover">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Design & User Experience (UX/UI) Section -->
<section id="design" class="py-24 bg-gray-50 overflow-hidden relative">
    <div class="absolute left-0 top-0 w-1/3 h-full bg-gradient-to-r from-purple-50 to-transparent opacity-50"></div>
    <div class="container mx-auto px-6 relative z-10">
        <div class="flex flex-col lg:flex-row gap-16">
            
            <!-- Left Column: Content -->
            <div class="lg:w-5/12" data-aos="fade-right">
                <span class="inline-flex items-center px-4 py-1.5 bg-indigo-100 text-indigo-800 rounded-full text-sm font-bold mb-6">
                    <i class="fas fa-paint-brush mr-2 text-xs"></i> User-Centric Design
                </span>
                <h2 class="text-4xl lg:text-5xl font-extrabold text-gray-900 mb-6 leading-tight">
                    Design that <span class="text-indigo-600">Converts</span>
                </h2>
                <p class="text-lg text-gray-600 mb-6 leading-relaxed">
                    We start every project with a <strong>user-centric design</strong> philosophy — it's <strong>included as a standard layer of every build</strong>. We create intuitive experiences that guide visitors through a logical journey, transforming casual browsers into valuable leads.
                </p>
                <p class="text-lg text-gray-600 mb-8 leading-relaxed">
                    Need design before code? Our UI/UX services are available <strong>standalone</strong> for web and mobile — delivering high-quality interfaces, design systems, and interactive prototypes you can hand off to any development team.
                </p>
                
                <a href="/website-quote" class="btn-primary btn-lg">
                    Start Your Design Project
                    <i class="fas fa-arrow-right ml-2 transition-transform group-hover:translate-x-1"></i>
                </a>
            </div>
            
            <!-- Right Column: Features Grid -->
            <div class="lg:w-7/12 grid grid-cols-1 md:grid-cols-2 gap-6" data-aos="fade-left">
                <!-- Feature 1 -->
                <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 hover:shadow-md transition-shadow md:col-span-2">
                    <div class="flex items-start gap-4">
                        <div class="w-12 h-12 rounded-lg bg-indigo-50 text-indigo-600 flex items-center justify-center flex-shrink-0">
                            <i class="fas fa-mobile-alt text-xl"></i>
                        </div>
                        <div>
                            <h4 class="text-xl font-bold text-gray-900 mb-2">Mobile-First Responsiveness</h4>
                            <p class="text-gray-600 text-sm">
                                We guarantee full responsiveness. Your site will look stellar and function perfectly on every screen size, from 4K desktops to smartphones. This is crucial for maintaining excellent search rankings (SEO) and user retention.
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Feature 2 -->
                <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 hover:shadow-md transition-shadow">
                    <div class="w-12 h-12 rounded-lg bg-pink-50 text-pink-600 flex items-center justify-center mb-4">
                        <i class="fas fa-bullseye text-xl"></i>
                    </div>
                    <h4 class="text-xl font-bold text-gray-900 mb-2">Conversion Optimized</h4>
                    <p class="text-gray-600 text-sm">
                        Strategic layouts with high-impact Call-to-Actions (CTAs) and simplified navigation to maximize ROI.
                    </p>
                </div>

                <!-- Feature 3 -->
                <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 hover:shadow-md transition-shadow">
                    <div class="w-12 h-12 rounded-lg bg-teal-50 text-teal-600 flex items-center justify-center mb-4">
                        <i class="fas fa-bolt text-xl"></i>
                    </div>
                    <h4 class="text-xl font-bold text-gray-900 mb-2">Performance First</h4>
                    <p class="text-gray-600 text-sm">
                        We balance stunning visuals with exceptional speed. Fast loading times decrease bounce rates and boost SEO.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Technology Expertise Section -->
<section id="webapp" class="py-20 px-4 lg:px-8 bg-gradient-to-br from-slate-50 to-blue-50">
    <div class="max-w-7xl mx-auto">
        <div class="text-center mb-16" data-aos="fade-up">
            <span class="text-sm font-semibold tracking-widest text-purple-600">TECHNOLOGY EXPERTISE</span>
            <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold mt-2 text-gray-900">Enterprise-Grade Web & Product Engineering</h2>
            <p class="text-xl text-gray-600 mt-6 max-w-3xl mx-auto">
                We engineer beyond templates, delivering custom SaaS platforms, client portals, and secure API integrations built on robust backend architectures for ultimate speed, security, and scalability.
            </p>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-5 gap-8" data-aos="zoom-in">
            <div class="flex flex-col items-center text-center">
                <div class="w-16 h-16 bg-white rounded-xl shadow-sm flex items-center justify-center mb-4">
                    <i class="fab fa-react text-3xl text-cyan-500"></i>
                </div>
                <span class="font-semibold text-gray-800 text-sm">React</span>
            </div>
            <div class="flex flex-col items-center text-center">
                <div class="w-16 h-16 bg-white rounded-xl shadow-sm flex items-center justify-center mb-4">
                    <i class="fab fa-node-js text-3xl text-green-500"></i>
                </div>
                <span class="font-semibold text-gray-800 text-sm">Node.js</span>
            </div>
            <div class="flex flex-col items-center text-center">
                <div class="w-16 h-16 bg-white rounded-xl shadow-sm flex items-center justify-center mb-4">
                    <i class="fab fa-js text-3xl text-yellow-500"></i>
                </div>
                <span class="font-semibold text-gray-800 text-sm">JavaScript</span>
            </div>
            <div class="flex flex-col items-center text-center">
                <div class="w-16 h-16 bg-white rounded-xl shadow-sm flex items-center justify-center mb-4">
                    <i class="fab fa-aws text-3xl text-orange-500"></i>
                </div>
                <span class="font-semibold text-gray-800 text-sm">AWS</span>
            </div>
            <div class="flex flex-col items-center text-center">
                <div class="w-16 h-16 bg-white rounded-xl shadow-sm flex items-center justify-center mb-4">
                    <i class="fas fa-database text-3xl text-blue-500"></i>
                </div>
                <span class="font-semibold text-gray-800 text-sm">MongoDB</span>
            </div>
            <div class="flex flex-col items-center text-center">
                <div class="w-16 h-16 bg-white rounded-xl shadow-sm flex items-center justify-center mb-4">
                    <i class="fab fa-git-alt text-3xl text-orange-600"></i>
                </div>
                <span class="font-semibold text-gray-800 text-sm">Git</span>
            </div>
            <div class="flex flex-col items-center text-center">
                <div class="w-16 h-16 bg-white rounded-xl shadow-sm flex items-center justify-center mb-4">
                    <i class="fab fa-figma text-3xl text-pink-500"></i>
                </div>
                <span class="font-semibold text-gray-800 text-sm">Figma</span>
            </div>
            <div class="flex flex-col items-center text-center">
                <div class="w-16 h-16 bg-white rounded-xl shadow-sm flex items-center justify-center mb-4">
                    <i class="fab fa-wordpress text-3xl text-blue-600"></i>
                </div>
                <span class="font-semibold text-gray-800 text-sm">WordPress</span>
            </div>
            <div class="flex flex-col items-center text-center">
                <div class="w-16 h-16 bg-white rounded-xl shadow-sm flex items-center justify-center mb-4">
                    <i class="fab fa-python text-3xl text-blue-500"></i>
                </div>
                <span class="font-semibold text-gray-800 text-sm">Python</span>
            </div>
            <div class="flex flex-col items-center text-center">
                <div class="w-16 h-16 bg-white rounded-xl shadow-sm flex items-center justify-center mb-4">
                    <svg class="w-7 h-7 fill-current text-blue-600" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="m24 4.515-7.658 14.97H9.149l3.205-6.204h-.144C9.566 16.713 5.621 18.973 0 19.485v-6.118s3.596-.213 5.71-2.435H0V4.515h6.417v5.278l.144-.001 2.622-5.277h4.854v5.244h.144l2.72-5.244H24Z"/></svg>
                </div>
                <span class="font-semibold text-gray-800 text-sm">Webflow</span>
            </div>
        </div>
    </div>
</section>

<!-- SEO Optimization Section -->
<section id="seo" class="py-24 bg-gray-50 relative">
    <div class="absolute inset-0 pattern-grid opacity-5"></div>
    <div class="container mx-auto px-6 relative z-10">
        <div class="text-center max-w-3xl mx-auto mb-16" data-aos="fade-up">
