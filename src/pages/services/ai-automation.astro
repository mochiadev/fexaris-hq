<script is:inline>
document.addEventListener('DOMContentLoaded',function(){
    const sd=document.getElementById('sd-widget'),tgl=document.getElementById('sd-toggle'),opt=document.getElementById('sd-options');
    let open=false;
    if(sd&&tgl&&opt){
        tgl.addEventListener('click',e=>{
            e.stopPropagation();
            open=!open;
            if(open){
                sd.classList.add('active');
                if(window.innerWidth<768){
                    const b=document.createElement('div');
                    b.id='sd-backdrop',b.className='fixed inset-0 bg-black/10 z-40';
                    b.addEventListener('click',()=>{open=false;sd.classList.remove('active');b.remove()});
                    document.body.appendChild(b)
                }
            }else{
                open=false;sd.classList.remove('active');
                document.getElementById('sd-backdrop')?.remove()
            }
        });
        document.addEventListener('click',e=>{if(open&&!sd.contains(e.target)){open=false;sd.classList.remove('active');document.getElementById('sd-backdrop')?.remove()}});
        document.addEventListener('keydown',e=>{if(e.key==='Escape'&&open){open=false;sd.classList.remove('active');document.getElementById('sd-backdrop')?.remove()}});
        opt.querySelectorAll('a').forEach(o=>{o.addEventListener('click',()=>{open=false;sd.classList.remove('active');document.getElementById('sd-backdrop')?.remove()})})
    }
    const btt=document.getElementById('back-to-top'),btn=document.getElementById('btt-btn');
    if(btt&&btn){
        btn.addEventListener('click',()=>{window.scrollTo({top:0,behavior:'smooth'})});
        window.addEventListener('scroll',()=>{btt.classList.toggle('visible',window.pageYOffset>400)});
        btt.classList.toggle('visible',window.pageYOffset>400)
    }
});
</script>

<script is:inline>
const perfTabs = {
  automate: {
    title: "Automate Repetitive Workflows",
    desc: "We reduce manual effort by automating repetitive and time-consuming processes end-to-end, so your team stays focused on high-impact work.",
    features: ["Workflow automation", "Task optimization", "AI-powered decision flows", "Process efficiency"],
    stat: "-60%",
    label: "Reduction in manual workload.",
    pct: 60
  },
  intelligence: {
    title: "Intelligence Across Your Data",
    desc: "We connect your business data to AI models that surface insights, predict outcomes, and turn information into better decisions.",
    features: ["Customer insight analytics", "Predictive decision-making", "Smart reporting dashboards", "Data-driven strategy"],
    stat: "+40%",
    label: "Faster, better-informed decisions.",
    pct: 40
  },
  "build-ai": {
    title: "Build AI-Powered Assistants",
    desc: "We design and deploy custom AI agents and chatbots that answer questions, qualify leads, and convert around the clock.",
    features: ["Custom AI agents & chatbots", "24/7 instant responses", "Human-like interactions", "CRM & channel integrations"],
    stat: "-70%",
    label: "Reduction in support costs.",
    pct: 70
  },
  "scale-ai": {
    title: "Scale AI Across Your Business",
    desc: "We help you expand proven automations across teams and departments while keeping quality, security, and governance tight.",
    features: ["Multi-department workflows", "Growth-ready infrastructure", "Ongoing fine-tuning", "Vendor & tool integrations"],
    stat: "3x",
    label: "Faster team output.",
    pct: 75
  }
};
document.addEventListener('DOMContentLoaded',function(){
  var ring=document.getElementById('perf-ring');
  if(!ring) return;
  var stat=document.getElementById('perf-stat'),statLabel=document.getElementById('perf-stat-label'),
      title=document.getElementById('perf-title'),desc=document.getElementById('perf-desc'),
      features=document.getElementById('perf-features'),
      tabs=Array.prototype.slice.call(document.querySelectorAll('.perf-tab')),
      CIRC=326.7;
  function escapeHtml(s){
    var div=document.createElement('div');
    div.textContent=s;
    return div.innerHTML;
  }
  function render(key){
    var d=perfTabs[key];
    title.textContent=d.title;
    desc.textContent=d.desc;
    features.innerHTML=d.features.map(function(f){
      return '<li class="flex items-center gap-3 text-body"><span class="w-6 h-6 rounded-full bg-green-500/15 text-emerald-400 flex items-center justify-center flex-shrink-0"><i class="fas fa-check text-xs"></i></span>'+escapeHtml(f)+'</li>';
    }).join('');
    stat.textContent=d.stat;
    statLabel.textContent=d.label;
    ring.style.strokeDashoffset=String(CIRC*(1-d.pct/100));
    tabs.forEach(function(t){
      var active=t.getAttribute('data-perf')===key;
      t.classList.toggle('perf-tab-active',active);
      t.setAttribute('aria-selected',active?'true':'false');
    });
  }
  tabs.forEach(function(t){
    t.addEventListener('click',function(){render(t.getAttribute('data-perf'));});
  });
});
</script>