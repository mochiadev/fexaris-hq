---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="AI & Workflow Integration | Fexaris Studio"
  description="Streamline operations and drive productivity with custom business process automations, CRM synchronization, smart AI support assistants, and digital marketing integration."
  keywords="AI & workflow integration, business process automation make zapier, custom ai chatbots support, crm lifecycle synchronization, operational automation"
  canonical="https://fexaris.com/services/ai-automation/"
  
  
>
  <!-- End of Navigation-->


    <!-- Hero Section -->
<section class="min-h-screen relative overflow-hidden bg-gray-900">
    <!-- Background Image with Overlay -->
    <div class="absolute inset-0 z-0">
        <img 
            src="/assets/logos/ai-chat.png" 
            alt="AI Customer Service Automation"
            class="w-full h-full object-cover"
        >
        <div class="absolute inset-0 bg-gradient-to-br from-[#0A3A2E]/80 via-[#10162E]/70 to-[#14122B]/80"></div>
    </div>
    
    <!-- Animated Background Elements -->
    <div class="absolute inset-0 overflow-hidden">
        <div class="absolute top-1/4 left-1/4 w-4 h-4 bg-emerald-400 rounded-full animate-pulse"></div>
        <div class="absolute top-3/4 right-1/3 w-3 h-3 bg-blue-400 rounded-full animate-pulse" style="animation-delay: 1s;"></div>
        <div class="absolute bottom-1/3 left-1/3 w-2 h-2 bg-purple-400 rounded-full animate-pulse" style="animation-delay: 2s;"></div>
    </div>
    
    <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center min-h-screen flex items-center justify-center py-20">
        <div data-aos="fade-up">
            <div class="inline-block px-6 py-3 bg-white/10 backdrop-blur-sm rounded-full border border-white/20 mb-8">
                <span class="text-emerald-300 font-semibold text-sm">🚀 AI & Workflow Integration</span>
            </div>
            
            <h1 class="text-5xl sm:text-6xl lg:text-7xl font-bold text-white mb-6 leading-tight">
                24/7 Service
                <span class="block text-transparent bg-clip-text bg-gradient-to-r from-emerald-300 to-blue-300">
                    Without Limits
                </span>
            </h1>
            
            <p class="text-xl sm:text-2xl text-body mb-10 max-w-3xl mx-auto leading-relaxed">
                Transform customer support with intelligent AI automation that works while you sleep. 
                <strong class="text-white">Fast, accurate, and always available.</strong>
            </p>
            
            <div class="flex flex-col sm:flex-row gap-6 justify-center items-center">
                <a href="#cta" class="btn-dark-hero btn-lg btn-shimmer">
                    Start Now
                    <i class="fas fa-arrow-right ml-3"></i>
                </a>
                <a href="#process" class="btn-ghost btn-lg">
                    <i class="fas fa-play-circle mr-3"></i>
                    How it works
                </a>
            </div>
            
            <!-- Social Proof -->
            <div class="mt-16 grid grid-cols-3 gap-8 max-w-2xl mx-auto">
                <div class="text-center">
                    <p class="text-3xl font-bold text-white">2.3s</p>
                    <p class="text-sm text-gray-300">Avg Response</p>
                </div>
                <div class="text-center">
                    <p class="text-3xl font-bold text-white">98%</p>
                    <p class="text-sm text-gray-300">Accuracy</p>
                </div>
                <div class="text-center">
                    <p class="text-3xl font-bold text-white">24/7</p>
                    <p class="text-sm text-gray-300">Availability</p>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Scroll Indicator -->
    <div class="absolute bottom-8 left-1/2 transform -translate-x-1/2" data-aos="fade-up" data-aos-delay="1000">
        <div class="animate-bounce">
            <i class="fas fa-chevron-down text-white text-2xl"></i>
        </div>
    </div>
</section>
<!-- End of Hero Section -->

<!-- How We Drive Performance (Interactive Tabs) -->
    <section id="performance" class="py-20 bg-bg-dark overflow-hidden relative">
        <!-- Decorative Glows -->
        <div class="absolute top-1/4 -left-10 w-72 h-72 bg-green-500/10 rounded-full blur-3xl"></div>
        <div class="absolute bottom-1/4 -right-10 w-72 h-72 bg-purple-500/10 rounded-full blur-3xl"></div>

        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
            <!-- Heading -->
            <div class="text-center mb-16" data-aos="fade-up">
                <span class="inline-block px-4 py-2 bg-green-500/10 text-emerald-400 rounded-full text-sm font-semibold mb-4">Our Approach</span>
                <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white">
                    How We <span class="text-transparent bg-clip-text bg-gradient-to-r from-green-400 to-emerald-600">Drive Performance</span>
                </h2>
                <p class="mt-4 text-lg text-body max-w-2xl lg:mx-auto">
                    Four focus areas that turn AI from a trend into measurable business results.
                </p>
            </div>

            <div class="grid lg:grid-cols-12 gap-10">
                <!-- Left: Tabs -->
                <div class="lg:col-span-4 xl:col-span-3" data-aos="fade-right">
                    <div id="perf-tabs" class="flex flex-col gap-3" role="tablist" aria-orientation="vertical">
                        <button type="button" id="tab-automate" data-perf="automate" role="tab" aria-selected="true" class="perf-tab perf-tab-active flex items-center justify-between w-full px-5 py-4 rounded-2xl text-left transition-all duration-300">
                            <span class="font-bold">Automate</span>
                            <span class="perf-arrow w-8 h-8 rounded-full flex items-center justify-center flex-shrink-0">
                                <i class="fas fa-arrow-right text-xs"></i>
                            </span>
                        </button>
                        <button type="button" id="tab-intelligence" data-perf="intelligence" role="tab" aria-selected="false" class="perf-tab flex items-center justify-between w-full px-5 py-4 rounded-2xl text-left transition-all duration-300">
                            <span class="font-bold">Intelligence</span>
                            <span class="perf-arrow w-8 h-8 rounded-full flex items-center justify-center flex-shrink-0">
                                <i class="fas fa-arrow-right text-xs"></i>
                            </span>
                        </button>
                        <button type="button" id="tab-build-ai" data-perf="build-ai" role="tab" aria-selected="false" class="perf-tab flex items-center justify-between w-full px-5 py-4 rounded-2xl text-left transition-all duration-300">
                            <span class="font-bold">Build AI</span>
                            <span class="perf-arrow w-8 h-8 rounded-full flex items-center justify-center flex-shrink-0">
                                <i class="fas fa-arrow-right text-xs"></i>
                            </span>
                        </button>
                        <button type="button" id="tab-scale-ai" data-perf="scale-ai" role="tab" aria-selected="false" class="perf-tab flex items-center justify-between w-full px-5 py-4 rounded-2xl text-left transition-all duration-300">
                            <span class="font-bold">Scale AI</span>
                            <span class="perf-arrow w-8 h-8 rounded-full flex items-center justify-center flex-shrink-0">
                                <i class="fas fa-arrow-right text-xs"></i>
                            </span>
                        </button>
                    </div>
                    <p class="mt-6 text-sm text-muted leading-relaxed">
                        Choose a focus area to see how our team approaches strategy, execution, and ongoing optimization.
                    </p>
                </div>

                <!-- Middle: Content -->
                <div class="lg:col-span-5 xl:col-span-6" data-aos="fade-up" data-aos-delay="100">
                    <h3 id="perf-title" class="text-2xl sm:text-3xl font-bold text-white mb-4">Automate Repetitive Workflows</h3>
                    <p id="perf-desc" class="text-body mb-6 leading-relaxed">
                        We reduce manual effort by automating repetitive and time-consuming processes end-to-end, so your team stays focused on high-impact work.
                    </p>
                    <ul id="perf-features" class="space-y-3">
                        <li class="flex items-center gap-3 text-body">
                            <span class="w-6 h-6 rounded-full bg-green-500/15 text-emerald-400 flex items-center justify-center flex-shrink-0"><i class="fas fa-check text-xs"></i></span>
                            Workflow automation
                        </li>
                        <li class="flex items-center gap-3 text-body">
                            <span class="w-6 h-6 rounded-full bg-green-500/15 text-emerald-400 flex items-center justify-center flex-shrink-0"><i class="fas fa-check text-xs"></i></span>
                            Task optimization
                        </li>
                        <li class="flex items-center gap-3 text-body">
                            <span class="w-6 h-6 rounded-full bg-green-500/15 text-emerald-400 flex items-center justify-center flex-shrink-0"><i class="fas fa-check text-xs"></i></span>
                            AI-powered decision flows
                        </li>
                        <li class="flex items-center gap-3 text-body">
                            <span class="w-6 h-6 rounded-full bg-green-500/15 text-emerald-400 flex items-center justify-center flex-shrink-0"><i class="fas fa-check text-xs"></i></span>
                            Process efficiency
                        </li>
                    </ul>
                    <a id="perf-link" href="/contact-us" class="mt-6 inline-flex items-center gap-2 text-emerald-400 hover:text-emerald-300 font-semibold transition-colors">
                        <i class="fas fa-link"></i>
                        Explore how we apply it
                        <i class="fas fa-arrow-right text-xs"></i>
                    </a>
                </div>

                <!-- Right: Stat Card -->
                <div class="lg:col-span-3" data-aos="fade-left" data-aos-delay="200">
                    <div class="bg-surface border border-surface-border rounded-3xl p-8 flex flex-col items-center text-center shadow-2xl">
                        <div class="relative w-36 h-36">
                            <svg class="w-full h-full -rotate-90" viewBox="0 0 120 120" aria-hidden="true">
                                <defs>
                                    <linearGradient id="perfGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                                        <stop offset="0%" stop-color="#00E6A5"/>
                                        <stop offset="100%" stop-color="#00C892"/>
                                    </linearGradient>
                                </defs>
                                <circle cx="60" cy="60" r="52" fill="none" stroke="#2A2F3D" stroke-width="10"/>
                                <circle id="perf-ring" cx="60" cy="60" r="52" fill="none" stroke="url(#perfGrad)" stroke-width="10" stroke-linecap="round" stroke-dasharray="326.7" stroke-dashoffset="167"/>
                            </svg>
                            <div class="absolute inset-0 flex items-center justify-center">
                                <span id="perf-stat" class="text-3xl font-extrabold text-white">-60%</span>
                            </div>
                        </div>
                        <p id="perf-stat-label" class="mt-4 text-sm text-muted">Reduction in manual workload.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- End of How We Drive Performance -->

<!-- Tools We Use Section -->
    <section id="process" class="py-20 bg-gray-50 overflow-hidden ai-circuit-pattern">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-14" data-aos="fade-up">
                <span class="text-sm font-semibold uppercase text-emerald-600">The Technology That Works</span>
                <h2 class="text-4xl sm:text-5xl font-extrabold text-gray-900 mt-2 mb-6">
                    Tools We Use
                </h2>
                <p class="text-xl text-gray-600 max-w-3xl mx-auto">
                    We build on a battle-tested stack of automation and AI platforms, so your workflows are reliable, scalable, and ready to grow.
                </p>
            </div>

            <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-8" data-aos="zoom-in">
                <div class="flex flex-col items-center text-center">
                    <div class="w-16 h-16 bg-white rounded-xl shadow-sm flex items-center justify-center mb-4">
                        <svg class="w-7 h-7 fill-current text-gray-900" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M21.4737 5.6842c-1.1772 0-2.1663.8051-2.4468 1.8947h-2.8955c-1.235 0-2.289.893-2.492 2.111l-.1038.623a1.263 1.263 0 0 1-1.246 1.0555H11.289c-.2805-1.0896-1.2696-1.8947-2.4468-1.8947s-2.1663.8051-2.4467 1.8947H4.973c-.2805-1.0896-1.2696-1.8947-2.4468-1.8947C1.1311 9.4737 0 10.6047 0 12s1.131 2.5263 2.5263 2.5263c1.1772 0 2.1663-.8051 2.4468-1.8947h1.4223c.2804 1.0896 1.2696 1.8947 2.4467 1.8947 1.1772 0 2.1663-.8051 2.4468-1.8947h1.0008a1.263 1.263 0 0 1 1.2459 1.0555l.1038.623c.203 1.218 1.257 2.111 2.492 2.111h.3692c.2804 1.0895 1.2696 1.8947 2.4468 1.8947 1.3952 0 2.5263-1.131 2.5263-2.5263s-1.131-2.5263-2.5263-2.5263c-1.1772 0-2.1664.805-2.4468 1.8947h-.3692a1.263 1.263 0 0 1-1.246-1.0555l-.1037-.623A2.52 2.52 0 0 0 13.9607 12a2.52 2.52 0 0 0 .821-1.4794l.1038-.623a1.263 1.263 0 0 1 1.2459-1.0555h2.8955c.2805 1.0896 1.2696 1.8947 2.4468 1.8947 1.3952 0 2.5263-1.131 2.5263-2.5263s-1.131-2.5263-2.5263-2.5263m0 1.2632a1.263 1.263 0 0 1 1.2631 1.2631 1.263 1.263 0 0 1-1.2631 1.2632 1.263 1.263 0 0 1-1.2632-1.2632 1.263 1.263 0 0 1 1.2632-1.2631M2.5263 10.7368A1.263 1.263 0 0 1 3.7895 12a1.263 1.263 0 0 1-1.2632 1.2632A1.263 1.263 0 0 1 1.2632 12a1.263 1.263 0 0 1 1.2631-1.2632m6.3158 0A1.263 1.263 0 0 1 10.1053 12a1.263 1.263 0 0 1-1.2632 1.2632A1.263 1.263 0 0 1 7.579 12a1.263 1.263 0 0 1 1.2632-1.2632m10.1053 3.7895a1.263 1.263 0 0 1 1.2631 1.2632 1.263 1.263 0 0 1-1.2631 1.2631 1.263 1.263 0 0 1-1.2632-1.2631 1.263 1.263 0 0 1 1.2632-1.2632"/></svg>
                    </div>
                    <span class="font-semibold text-gray-800 text-sm">n8n</span>
                </div>

                <div class="flex flex-col items-center text-center">
                    <div class="w-16 h-16 bg-white rounded-xl shadow-sm flex items-center justify-center mb-4">
                        <svg class="w-7 h-7 fill-current text-orange-500" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M4.157 0A4.151 4.151 0 0 0 0 4.161v15.678A4.151 4.151 0 0 0 4.157 24h15.682A4.152 4.152 0 0 0 24 19.839V4.161A4.152 4.152 0 0 0 19.839 0H4.157Zm10.61 8.761h.03a.577.577 0 0 1 .23.038.585.585 0 0 1 .201.124.63.63 0 0 1 .162.431.612.612 0 0 1-.162.435.58.58 0 0 1-.201.128.58.58 0 0 1-.23.042.529.529 0 0 1-.235-.042.585.585 0 0 1-.332-.328.559.559 0 0 1-.038-.235.613.613 0 0 1 .17-.431.59.59 0 0 1 .405-.162Zm2.853 1.572c.03.004.061.004.095.004.325-.011.646.064.937.219.238.144.431.355.552.609.128.279.189.582.185.888v.193a2 2 0 0 1 0 .219h-2.498c.003.227.075.45.204.642a.78.78 0 0 0 .646.265.714.714 0 0 0 .484-.136.642.642 0 0 0 .23-.318l.915.257a1.398 1.398 0 0 1-.28.537c-.14.159-.321.284-.521.355a2.234 2.234 0 0 1-.836.136 1.923 1.923 0 0 1-1.001-.245 1.618 1.618 0 0 1-.665-.703 2.221 2.221 0 0 1-.227-1.036 1.95 1.95 0 0 1 .48-1.398 1.9 1.9 0 0 1 1.3-.488Zm-9.607.023c.162.004.325.026.48.079.207.065.4.174.563.314.26.302.393.692.366 1.088v2.276H8.53l-.109-.711h-.065c-.064.163-.155.31-.272.439a1.122 1.122 0 0 1-.374.264 1.023 1.023 0 0 1-.453.083 1.334 1.334 0 0 1-.866-.264.965.965 0 0 1-.329-.801.993.993 0 0 1 .076-.431 1.02 1.02 0 0 1 .242-.363 1.478 1.478 0 0 1 1.043-.303h.952v-.181a.696.696 0 0 0-.136-.454.553.553 0 0 0-.438-.154.695.695 0 0 0-.378.086.48.48 0 0 0-.193.254l-.99-.144a1.26 1.26 0 0 1 .257-.563c.14-.174.321-.302.533-.378.261-.091.54-.136.82-.129.053-.003.106-.007.163-.007Zm4.384.007c.174 0 .347.038.506.114.182.083.34.211.458.374.257.423.377.911.351 1.406a2.53 2.53 0 0 1-.355 1.448 1.148 1.148 0 0 1-1.009.517c-.204 0-.401-.045-.582-.136a1.052 1.052 0 0 1-.48-.457 1.298 1.298 0 0 1-.114-.234h-.045l.004 1.784h-1.059v-4.713h.904l.117.805h.057c.068-.208.177-.401.328-.56a1.129 1.129 0 0 1 .843-.344h.076v-.004Zm7.559.084h.903l.113.805h.053a1.37 1.37 0 0 1 .235-.484.813.813 0 0 1 .313-.242.82.82 0 0 1 .39-.07