                                <p class="text-gray-600 text-sm">We seamlessly switch traffic to your new high-performance environment.</p>
                            </div>
                        </div>
                        
                        <div class="flex items-start gap-4">
                            <div class="w-10 h-10 bg-blue-500 text-white rounded-full flex items-center justify-center flex-shrink-0">
                                <span class="font-bold">4</span>
                            </div>
