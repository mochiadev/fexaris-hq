                            Request Cloud Migration & Audit
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Core Hosting Product -->
    <section class="py-16 px-4 bg-gray-50">
        <div class="max-w-6xl mx-auto">
