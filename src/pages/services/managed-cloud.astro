---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Managed Cloud Hosting & Migration Services | Fexa Digital"
  description="Secure and reliable managed cloud hosting, migration, and infrastructure solutions. Get seamless, stress-free cloud transition and 24/7 management for guaranteed uptime."
  keywords="managed cloud hosting, cloud migration services, aws management, azure support, secure cloud infrastructure, devops services ghana"
  canonical="https://fexadigital.com/services/managed-cloud.html"
  
  
>
  <!-- End of Navigation-->

    <!-- Modern Hero Section -->
    <section class="pt-24 pb-20 hero-section text-white">
        <div class="max-w-6xl mx-auto px-4">
            <div class="grid lg:grid-cols-2 gap-12 items-center">
                <!-- Left Content -->
                <div class="text-left" data-aos="fade-right">
                    <div class="inline-flex items-center gap-2 bg-white/10 backdrop-blur-sm text-white px-4 py-2 rounded-full text-sm font-medium mb-6">
                        <i class="fas fa-cloud-arrow-up"></i>
                        <span>Expert Server Management So You Only See Results</span>
                    </div>
                    
                    <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6 leading-tight">
                        Stop Managing 
                        <span class="gradient-text">Servers</span>
                    </h1>
                    
                    <p class="text-xl text-gray-200 mb-8 leading-relaxed">
                        Focus on your business while we handle the technical backend. Our premium managed hosting delivers speed, security, and scalability without the complexity.
                    </p>
                    
                    <div class="flex flex-col sm:flex-row gap-4 mb-8">
                        <a href="#migration" class="bg-white text-purple-600 px-8 py-4 rounded-lg font-semibold hover:bg-gray-100 transition-all duration-300 transform hover:-translate-y-1 flex items-center justify-center gap-2">
                            <i class="fas fa-truck-loading"></i>
                            Get Free Migration & Audit
                        </a>
                        <a href="#pricing" class="border-2 border-white text-white px-8 py-4 rounded-lg font-semibold hover:bg-white hover:text-purple-600 transition-all duration-300 flex items-center justify-center gap-2">
                            <i class="fas fa-eye"></i>
                            View Plans
                        </a>
                    </div>
                    
                    <!-- Trust Indicators -->
                    <div class="flex flex-wrap items-center gap-6 text-sm text-gray-300">
                        <div class="flex items-center gap-2">
                            <i class="fas fa-shield-alt text-green-400"></i>
                            <span>Zero-Downtime Migration</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <i class="fas fa-clock text-blue-400"></i>
                            <span>24/7 Expert Support</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <i class="fas fa-sync text-purple-400"></i>
                            <span>WordPress & Custom Apps</span>
                        </div>
                    </div>
                </div>
                
                <!-- Right Content - Stats/Features - Hidden on mobile -->
                <div class="hidden lg:block bg-white/10 backdrop-blur-sm rounded-2xl p-8 border border-white/20" data-aos="fade-left" data-aos-delay="200">
                    <h3 class="text-2xl font-bold mb-6 text-center">Why Fexa Cloud Stands Out</h3>
                    
                    <div class="space-y-6">
                        <div class="flex items-start gap-4">
                            <div class="w-12 h-12 bg-blue-500/20 rounded-lg flex items-center justify-center text-blue-300 text-xl flex-shrink-0">
                                <i class="fab fa-wordpress-simple"></i>
                            </div>
                            <div>
                                <h4 class="font-bold text-white mb-1">WordPress & Beyond</h4>
                                <p class="text-gray-300 text-sm">Expertly optimized for WordPress AND custom apps (Node.js, Laravel, Python, Next.js).</p>
                            </div>
                        </div>
                        
                        <div class="flex items-start gap-4">
                            <div class="w-12 h-12 bg-green-500/20 rounded-lg flex items-center justify-center text-green-300 text-xl flex-shrink-0">
