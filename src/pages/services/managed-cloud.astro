                                    <i class="fas fa-check text-xs"></i>
                                </div>
                                <div>
                                    <h4 class="font-semibold">For External Clients</h4>
                                    <p class="text-gray-600 text-sm">Hassle-free migration from your current host with guaranteed compatibility.</p>
                                </div>
