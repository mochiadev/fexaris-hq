---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Get Started with Digital Marketing & AI Automation | Fexaris Studio"
  
  
  canonical="https://fexaris.com/getting-started/"
  
  
>
  <!-- End of Navigation-->

    <!-- Hero Section -->
    <section class="relative min-h-screen flex items-center justify-center overflow-hidden bg-gradient-to-br from-[#12121C] via-[#14122B] to-[#10162E]">
        <div class="absolute inset-0 z-0">
            <img src="https://images.unsplash.com/photo-1552664730-d307ca884978?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80" 
                 alt="Digital Transformation" class="w-full h-full object-cover opacity-40">
            <div class="absolute inset-0 bg-gradient-to-r from-[#0F1117]/90 to-[#10162E]/80"></div>
        </div>
        
        <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center text-white">
            <div class="inline-flex items-center gap-3 px-6 py-3 bg-white/10 backdrop-blur-sm rounded-full border border-white/20 mb-8">
                <div class="w-2 h-2 bg-green-400 rounded-full animate-pulse"></div>
                <span class="text-sm font-semibold">Transform Your Business Digitally</span>
            </div>
            
            <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold mb-6 leading-tight">
                Ready to Transform Your
                <span class="block text-transparent bg-clip-text bg-gradient-to-r from-orange-300 via-purple-300 to-blue-300">
                    Business?
                </span>
            </h1>
            
            <p class="text-xl text-body mb-8 max-w-3xl mx-auto leading-relaxed">
                Whether you need a stunning website, AI automation, digital advertising, or cloud solutions - we have the expertise to bring your vision to life.
            </p>
            
            <div class="flex flex-col sm:flex-row gap-4 justify-center">
                <a href="#contact-options" class="inline-flex items-center justify-center px-8 py-4 bg-white text-indigo-700 font-bold rounded-xl hover:bg-gray-100 transition-all duration-300 transform hover:scale-105 shadow-2xl">
                    Get Started Today
                    <i class="fas fa-arrow-right ml-3"></i>
                </a>
                <a href="/index#services" class="inline-flex items-center justify-center px-8 py-4 bg-transparent text-white font-bold rounded-xl border-2 border-white/30 hover:border-white/60 hover:bg-white/10 transition-all duration-300">
                    <i class="fas fa-eye mr-3"></i>
                    View Our Services
                </a>
            </div>
        </div>
    </section>
    <style>
        .hero-pattern {
            background-image: radial-gradient(circle at 25% 25%, rgba(255,255,255,0.1) 0%, transparent 55%);
        }
    </style>
    <!--end-section-hero-->
<!-- How It Works Section -->
<section class="py-20 bg-gradient-to-br from-gray-50 to-white overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
            <span class="inline-block px-4 py-2 bg-indigo-100 text-indigo-700 rounded-full text-sm font-semibold mb-4" data-aos="fade-up">
                Simple 3-Step Process
            </span>
            <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-gray-900 mb-6" data-aos="fade-up">
                Getting Started Is <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-600 to-purple-600">Effortless</span>
            </h2>
            <p class="text-xl text-gray-600 max-w-3xl mx-auto" data-aos="fade-up" data-aos-delay="100">
                From initial contact to outstanding results - our streamlined process ensures your digital success journey is smooth and predictable.
            </p>
        </div>

        <!-- Process Steps -->
        <div class="grid lg:grid-cols-3 gap-8 mt-16">
            <!-- Step 1: Choose Your Plan -->
            <div class="group relative" data-aos="fade-up" data-aos-delay="200">
                <div class="relative bg-white rounded-2xl p-8 shadow-lg hover:shadow-2xl transition-all duration-500 border border-gray-100 hover:border-indigo-200 h-full">
                    <!-- Step Number -->
                    <div class="absolute -top-6 left-1/2 transform -translate-x-1/2">
                        <div class="w-14 h-14 bg-gradient-to-br from-indigo-500 to-purple-600 rounded-2xl flex items-center justify-center group-hover:scale-110 group-hover:rotate-6 transition-all duration-300 shadow-lg">
                            <span class="text-white font-bold text-xl">1</span>
                        </div>
                    </div>
                    
                    <!-- Content -->
                    <div class="pt-8 text-center">
                        <div class="w-16 h-16 bg-indigo-100 rounded-2xl flex items-center justify-center mx-auto mb-6 group-hover:scale-110 transition-transform duration-300">
                            <i class="fas fa-clipboard-list text-2xl text-indigo-600"></i>
                        </div>
                        
                        <h3 class="text-2xl font-bold text-gray-900 mb-4 group-hover:text-indigo-600 transition-colors">
                            Choose Your Solution
                        </h3>
                        
                        <p class="text-gray-600 mb-6 leading-relaxed">
                            Select your preferred service package that aligns with your business goals and budget. We offer tailored solutions for every stage of growth.
                        </p>
                                              
                        <a href="/index#services" class="inline-flex items-center gap-2 bg-indigo-600 text-white px-6 py-3 rounded-xl font-semibold hover:bg-indigo-700 transition-colors group-hover:scale-105 transform transition-transform">
                            <i class="fas fa-external-link-alt text-sm"></i>
                            Explore Service Plans
                        </a>
                    </div>
                </div>
                
                <!-- Connecting Arrow -->
                <div class="hidden lg:block absolute top-1/2 -right-4 transform -translate-y-1/2 z-10">
                    <i class="fas fa-arrow-right text-2xl text-indigo-300 group-hover:text-indigo-500 transition-colors"></i>
                </div>
            </div>

            <!-- Step 2: Connect With Us -->
            <div class="group relative" data-aos="fade-up" data-aos-delay="300">
                <div class="relative bg-white rounded-2xl p-8 shadow-lg hover:shadow-2xl transition-all duration-500 border border-gray-100 hover:border-blue-200 h-full">
                    <!-- Step Number -->
                    <div class="absolute -top-6 left-1/2 transform -translate-x-1/2">
                        <div class="w-14 h-14 bg-gradient-to-br from-blue-500 to-cyan-600 rounded-2xl flex items-center justify-center group-hover:scale-110 group-hover:rotate-6 transition-all duration-300 shadow-lg">
                            <span class="text-white font-bold text-xl">2</span>
                        </div>
                    </div>
                    
                    <!-- Content -->
                    <div class="pt-8 text-center">
                        <div class="w-16 h-16 bg-blue-100 rounded-2xl flex items-center justify-center mx-auto mb-6 group-hover:scale-110 transition-transform duration-300">
                            <i class="fas fa-handshake text-2xl text-blue-600"></i>
                        </div>
                        
                        <h3 class="text-2xl font-bold text-gray-900 mb-4 group-hover:text-blue-600 transition-colors">
                            Connect & Strategize
                        </h3>
                        
                        <p class="text-gray-600 mb-6 leading-relaxed">
                            Let's discuss your vision! Book a free consultation where we'll analyze your needs and craft a customized strategy together.
                        </p>
                        
                        <!-- Contact Options -->
                        <div class="space-y-4 mb-6">
                            <div class="flex items-center justify-center gap-4">
                                <a href="#cta" class="w-10 h-10 bg-green-500 rounded-full flex items-center justify-center hover:scale-110 transition-transform">
                                    <i class="fab fa-whatsapp text-white text-sm"></i>
                                </a>
                                <a href="tel:+233549694956" class="w-10 h-10 bg-blue-500 rounded-full flex items-center justify-center hover:scale-110 transition-transform">
                                    <i class="fas fa-phone text-white text-sm"></i>
                                </a>
                                <a href="mailto:hello@fexaris.com" class="w-10 h-10 bg-purple-500 rounded-full flex items-center justify-center hover:scale-110 transition-transform">
                                    <i class="fas fa-envelope text-white text-sm"></i>
                                </a>
                            </div>
                            <p class="text-sm text-gray-500">Multiple ways to reach us</p>
                        </div>
                        
                        <div class="bg-gradient-to-r from-blue-50 to-cyan-50 rounded-xl p-4 border border-blue-100">
                            <p class="text-sm text-blue-700 font-medium">
                                <i class="fas fa-clock mr-2"></i>
                                Free 30-minute strategy session included
