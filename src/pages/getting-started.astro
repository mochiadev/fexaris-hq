                                </p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Right Side: Image -->
                <div class="relative">
                    <div class="bg-gradient-to-br from-indigo-400 to-purple-500 rounded-3xl p-1 shadow-2xl">
