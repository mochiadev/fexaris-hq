<style>
#back-to-top.visible{opacity:1;pointer-events:auto}#btt-btn:hover{transform:translateY(-2px) scale(1.05)}
.sd-whatsapp { font-size: 1.3rem; }
.sd-option{width:3rem;height:3rem;border-radius:9999px;display:flex;align-items:center;justify-content:center;color:white;box-shadow:0 10px 15px -3px rgba(0,0,0,0.1);transition:all .3s ease;position:relative}
.sd-tooltip{position:absolute;right:3.5rem;padding:.5rem .75rem;background-color:#1f2937;color:white;font-size:.875rem;border-radius:.5rem;white-space:nowrap;opacity:0;pointer-events:none;transition:all .2s ease;transform:translateX(.5rem)}
.sd-tooltip::after{content:'';position:absolute;top:50%;right:-.25rem;width:.5rem;height:.5rem;background-color:#1f2937;transform:translateY(-50%) rotate(45deg)}
#sd-widget.active #sd-options{opacity:1;pointer-events:auto;transform:translateY(0)}#sd-widget.active .sd-option{transform:translateY(0);opacity:1}
#sd-widget.active .sd-open-icon{opacity:0;transform:rotate(90deg) scale(0.5)}
#sd-widget.active .sd-close-icon{opacity:1;transform:rotate(0deg) scale(1)}
.sd-option:hover{transform:translateY(-2px) scale(1.1)}.group:hover .sd-tooltip{opacity:1;transform:translateX(0)}
@media (max-width:640px){#sd-widget{bottom:1rem;right:1rem}#back-to-top{bottom:1rem;left:1rem}.sd-tooltip{display:none}.sd-option{width:2.75rem;height:2.75rem}}
</style>

<script>
document.addEventListener('DOMContentLoaded',function(){
    const sd=document.getElementById('sd-widget'),tgl=document.getElementById('sd-toggle'),opt=document.getElementById('sd-options');
    let open=false;
    if(sd&&tgl&&opt){
        tgl.addEventListener('click',e=>{
            e.stopPropagation();
            open=!open;
            if(open){
                sd.classList.add('active');
                if(window.innerWidth<768){
                    const b=document.createElement('div');
                    b.id='sd-backdrop',b.className='fixed inset-0 bg-black/10 z-40';
                    b.addEventListener('click',()=>{open=false;sd.classList.remove('active');b.remove()});
                    document.body.appendChild(b)
                }
            }else{
                open=false;sd.classList.remove('active');
                document.getElementById('sd-backdrop')?.remove()
            }
        });
        document.addEventListener('click',e=>{if(open&&!sd.contains(e.target)){open=false;sd.classList.remove('active');document.getElementById('sd-backdrop')?.remove()}});
        document.addEventListener('keydown',e=>{if(e.key==='Escape'&&open){open=false;sd.classList.remove('active');document.getElementById('sd-backdrop')?.remove()}});
        opt.querySelectorAll('a').forEach(o=>{o.addEventListener('click',()=>{open=false;sd.classList.remove('active');document.getElementById('sd-backdrop')?.remove()})})
    }
    const btt=document.getElementById('back-to-top'),btn=document.getElementById('btt-btn');
    if(btt&&btn){
        btn.addEventListener('click',()=>{window.scrollTo({top:0,behavior:'smooth'})});
        window.addEventListener('scroll',()=>{btt.classList.toggle('visible',window.pageYOffset>400)});
        btt.classList.toggle('visible',window.pageYOffset>400)
    }
});
</script>
