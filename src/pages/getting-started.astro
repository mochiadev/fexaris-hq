<!-- Green Speed Dial Widget -->
<div id="speed-dial-widget" class="fixed bottom-6 right-6 z-50">
    <!-- Main Toggle Button -->
    <button id="speed-dial-toggle" class="w-14 h-14 bg-gradient-to-r from-green-500 to-emerald-600 rounded-full shadow-lg hover:shadow-xl transition-all duration-300 transform hover:scale-110 flex items-center justify-center text-white group">
        <i class="fas fa-comment-alt text-lg transition-transform duration-300"></i>
        <i class="fas fa-times text-lg absolute opacity-0 transition-all duration-300 transform rotate-90 scale-50"></i>
    </button>

    <!-- Speed Dial Options -->
    <div id="speed-dial-options" class="absolute bottom-16 right-0 space-y-3 opacity-0 pointer-events-none transition-all duration-300 transform translate-y-4">
        <!-- WhatsApp Option -->
        <a href="https://wa.me/233549694956" target="_blank" class="speed-dial-option group bg-green-500 hover:bg-green-600 transform translate-y-8 opacity-0 transition-all duration-300 delay-75">
            <i class="fab fa-whatsapp text-sm"></i>
            <span class="speed-dial-tooltip">Message Us</span>
        </a>

        <!-- Phone Option -->
        <a href="tel:+233549694956" class="speed-dial-option group bg-blue-500 hover:bg-blue-600 transform translate-y-8 opacity-0 transition-all duration-300 delay-150">
            <i class="fas fa-phone text-sm"></i>
            <span class="speed-dial-tooltip">Call Us</span>
        </a>

        <!-- Email Option -->
        <a href="mailto:hello@fexaris.com" class="speed-dial-option group bg-purple-500 hover:bg-purple-600 transform translate-y-8 opacity-0 transition-all duration-300 delay-225">
            <i class="fas fa-envelope text-sm"></i>
            <span class="speed-dial-tooltip">Email Us</span>
        </a>
    </div>

    <!-- Pulse Animation -->
    <div class="absolute inset-0 rounded-full bg-gradient-to-r from-green-500 to-emerald-600 animate-ping opacity-20 -z-10"></div>
</div>

<style>
    .speed-dial-option {
        width: 3rem;
        height: 3rem;
        border-radius: 9999px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
        transition: all 0.3s ease;
        position: relative;
    }

    .speed-dial-tooltip {
        position: absolute;
        right: 3.5rem;
        padding: 0.5rem 0.75rem;
        background-color: #1f2937;
        color: white;
        font-size: 0.875rem;
        border-radius: 0.5rem;
        white-space: nowrap;
        opacity: 0;
        pointer-events: none;
        transition: all 0.2s ease;
        transform: translateX(0.5rem);
    }

    .speed-dial-tooltip::after {
        content: '';
        position: absolute;
        top: 50%;
        right: -0.25rem;
        width: 0.5rem;
        height: 0.5rem;
        background-color: #1f2937;
        transform: translateY(-50%) rotate(45deg);
    }

    /* Active state */
    #speed-dial-widget.active #speed-dial-toggle {
        transform: rotate(45deg);
    }

    #speed-dial-widget.active #speed-dial-toggle .fa-comment-alt {
        opacity: 0;
        transform: rotate(90deg) scale(0.5);
    }

    #speed-dial-widget.active #speed-dial-toggle .fa-times {
        opacity: 1;
        transform: rotate(0deg) scale(1);
    }

    #speed-dial-widget.active #speed-dial-options {
        opacity: 1;
        pointer-events: auto;
        transform: translateY(0);
    }

    #speed-dial-widget.active .speed-dial-option {
        transform: translateY(0);
        opacity: 1;
    }

    /* Hover effects */
    .speed-dial-option:hover {
        transform: translateY(-2px) scale(1.1);
    }

    .group:hover .speed-dial-tooltip {
        opacity: 1;
        transform: translateX(0);
    }

    /* Mobile responsiveness */
    @media (max-width: 640px) {
        #speed-dial-widget {
            bottom: 1rem;
            right: 1rem;
        }
        
        .speed-dial-tooltip {
            display: none;
        }

        .speed-dial-option {
            width: 2.75rem;
            height: 2.75rem;
        }
        
        #back-to-top {
            bottom: 1rem;
            left: 1rem;
        }
    }

    /* Reduced motion for accessibility */
    @media (prefers-reduced-motion: reduce) {
        .speed-dial-option,
        #speed-dial-toggle,
        #speed-dial-options,
        #back-to-top {
            transition-duration: 0.1s;
        }
        
        .animate-ping {
            animation: none;
        }
    }
</style>
    
