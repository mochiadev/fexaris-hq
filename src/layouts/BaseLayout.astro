---
// BaseLayout.astro
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  keywords?: string;
  canonical?: string;
  ogImage?: string;
  hideHeader?: boolean;
  hideFooter?: boolean;
}

const {
  title,
  description = "We engineer high-converting web infrastructure, execute data-driven digital marketing, and integrate intelligent workflow automations that streamline operations and drive revenue.",
  keywords = "digital growth studio, ai automation consultancy, custom web infrastructure, technical seo agency, workflow automation, performance marketing, enterprise product engineering",
  canonical = "https://fexadigital.com/",
  ogImage = "https://fexadigital.com/assets/fexa-og-image.jpg",
  hideHeader = false,
  hideFooter = false
} = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <meta name="description" content={description}>
    <meta name="keywords" content={keywords}>
    <meta name="author" content="Fexaris Studio">

    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/assets/fxs-logo.png">
    <link rel="apple-touch-icon" href="/assets/fxs-logo.png">
    
    <meta property="og:type" content="website">
    <meta property="og:url" content={canonical}>
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:image" content={ogImage}> 
    <meta property="og:locale" content="en_GH">

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:site" content="@FexarisStudio"> 
    <meta name="twitter:creator" content="@FexarisStudio">
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content={ogImage}>
    
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-GV7DGWBVJB" is:inline></script>
    <script is:inline>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());

        gtag('config', 'G-GV7DGWBVJB');
    </script>

    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&display=swap">
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Local Stylesheet -->
    <link rel="stylesheet" href="/assets/css/style.css">
</head>
<body class="bg-white font-sans">
    {!hideHeader && <Header />}
    <slot />
    {!hideFooter && <Footer />}

    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js" is:inline></script>
    <script is:inline>
        // Initialize AOS
        document.addEventListener('DOMContentLoaded', function() {
            AOS.init({
                duration: 800,
                easing: 'ease-in-out',
                once: true,
                offset: 100
            });

            // Accordion functionality
            const toggles = document.querySelectorAll('.accordion-toggle');
            toggles.forEach(toggle => {
                toggle.addEventListener('click', function() {
                    // Collapse others
                    toggles.forEach(other => {
                        if (other !== toggle) {
                            other.classList.remove('active');
                            const otherContent = other.nextElementSibling;
                            if (otherContent) otherContent.style.maxHeight = null;
                        }
                    });

                    // Toggle current
                    toggle.classList.toggle('active');
                    const content = toggle.nextElementSibling;
                    if (content) {
                        if (toggle.classList.contains('active')) {
                            content.style.maxHeight = content.scrollHeight + "px";
                        } else {
                            content.style.maxHeight = null;
                        }
                    }
                });
            });

            // Smooth scrolling for anchor links
            document.querySelectorAll('a[href^="#"]').forEach(anchor => {
                anchor.addEventListener('click', function(e) {
                    e.preventDefault();
                    const target = document.querySelector(this.getAttribute('href'));
                    if (target) {
                        target.scrollIntoView({
                            behavior: 'smooth',
                            block: 'start'
                        });
                    }
                });
            });
        });
    </script>
</body>
</html>
