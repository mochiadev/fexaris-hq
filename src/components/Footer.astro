---
// Footer.astro
---
<footer class="bg-black text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
        <!-- Main Content -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-12">
            <!-- Company Info -->
            <div class="space-y-6 lg:col-span-1">
                <div class="flex items-center">
                    <img src="/assets/transfexalog.png" alt="Fexa Digital Logo" class="h-12 w-12 object-contain mr-3" />
                    <span class="text-2xl font-bold">
                        <span class="bg-gradient-to-r from-purple-400 to-blue-400 bg-clip-text text-transparent">FEXA</span>
                        <span>DIGITAL</span>
                    </span>
                </div>
                <p class="text-gray-300 text-sm leading-relaxed">
                    Transforming businesses through cutting-edge web solutions, AI automation, and data-driven digital strategies.
                </p>
                <div class="flex space-x-3">
                    <a href="https://wa.me/233549694956" target="_blank" class="social-icon">
                        <i class="fab fa-whatsapp text-lg"></i>
                    </a>
                    <a href="https://instagram.com/fexadigital" target="_blank" class="social-icon">
                        <i class="fab fa-instagram text-lg"></i>
                    </a>
                    <a href="https://github.com/fexadigital" target="_blank" class="social-icon">
                        <i class="fab fa-github text-lg"></i>
                    </a>
                    <a href="mailto:fexadigital@gmail.com" class="social-icon">
                        <i class="fas fa-envelope text-lg"></i>
                    </a>
                </div>
            </div>

            <!-- Services Column -->
            <div class="space-y-4">
                <h3 class="text-lg font-semibold text-white uppercase tracking-wider border-l-4 border-orange-500 pl-3">Services</h3>
                <ul class="space-y-3">
                    <li><a href="/services/web-development" class="gradient-link group flex items-center">
                        <span class="w-2 h-2 bg-orange-500 rounded-full mr-3 group-hover:scale-150 transition-transform duration-300"></span>
                        Web Design & Development
                    </a></li>
                    <li><a href="/services/ai-automation" class="gradient-link group flex items-center">
                        <span class="w-2 h-2 bg-orange-500 rounded-full mr-3 group-hover:scale-150 transition-transform duration-300"></span>
                        AI Automation
                    </a></li>
                    <li><a href="/services/digital-ads" class="gradient-link group flex items-center">
                        <span class="w-2 h-2 bg-orange-500 rounded-full mr-3 group-hover:scale-150 transition-transform duration-300"></span>
                        Digital Advertising
                    </a></li>
                    <li><a href="/services/managed-cloud" class="gradient-link group flex items-center">
                        <span class="w-2 h-2 bg-orange-500 rounded-full mr-3 group-hover:scale-150 transition-transform duration-300"></span>
                        Managed Cloud Services
                    </a></li>
                </ul>
            </div>

            <!-- Quick Links Column -->
            <div class="space-y-4">
                <h3 class="text-lg font-semibold text-white uppercase tracking-wider border-l-4 border-blue-500 pl-3">Quick Links</h3>
                <ul class="space-y-3">
                    <li><a href="/" class="gradient-link group flex items-center">
                        <span class="w-2 h-2 bg-blue-500 rounded-full mr-3 group-hover:scale-150 transition-transform duration-300"></span>
                        Home
                    </a></li>
                    <li><a href="/pricing" class="gradient-link group flex items-center">
                        <span class="w-2 h-2 bg-blue-500 rounded-full mr-3 group-hover:scale-150 transition-transform duration-300"></span>
                        Pricing
                    </a></li>
                    <li><a href="/about-us" class="gradient-link group flex items-center">
                        <span class="w-2 h-2 bg-blue-500 rounded-full mr-3 group-hover:scale-150 transition-transform duration-300"></span>
                        About Us
                    </a></li>
                    <li><a href="/contact-us" class="gradient-link group flex items-center">
                        <span class="w-2 h-2 bg-blue-500 rounded-full mr-3 group-hover:scale-150 transition-transform duration-300"></span>
                        Contact
                    </a></li>
                </ul>
            </div>

            <!-- Contact Column -->
            <div class="space-y-6">
                <h3 class="text-lg font-semibold text-white uppercase tracking-wider border-l-4 border-blue-500 pl-3">Get Started</h3>
                <div class="bg-gradient-to-br from-gray-900 to-gray-800 rounded-xl p-6 border border-gray-700">
                    <p class="text-gray-200 text-sm mb-4">Ready to transform your digital presence?</p>
                    <a href="/getting-started" class="block w-full text-center py-3 px-4 bg-gradient-to-r from-indigo-600 to-purple-600 hover:from-violet-500 hover:to-indigo-600 text-white font-semibold rounded-lg transition-all duration-300 transform hover:scale-105 shadow-lg">
                        Start Your Project
                    </a>
                </div>
                <div class="space-y-3 text-sm">
                    <div class="flex items-center text-gray-300">
                        <i class="fas fa-map-marker-alt text-orange-400 mr-3 w-4"></i>
                        <span>Accra, Ghana</span>
                    </div>
                    <div class="flex items-center text-gray-300">
                        <i class="fas fa-phone text-orange-400 mr-3 w-4"></i>
                        <a href="tel:+233549694956" class="hover:text-blue-400 transition-colors">+233 54 969 4956</a>
                    </div>
                    <div class="flex items-center text-gray-300">
                        <i class="fas fa-envelope text-orange-400 mr-3 w-4"></i>
                        <a href="mailto:fexadigital@gmail.com" class="hover:text-blue-400 transition-colors">fexadigital@gmail.com</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Footer Bottom -->
        <div class="border-t border-gray-800 mt-12 pt-8">
            <div class="flex flex-col md:flex-row justify-between items-center space-y-4 md:space-y-0">
                <div class="text-gray-400 text-sm">
                    <p>&copy; 2025 Fexa Digital Solutions.</p>
                </div>
                <div class="flex space-x-6 text-sm">
                    <a href="/privacy-policy" class="text-gray-400 hover:text-orange-400 transition-colors">Privacy</a>
                    <a href="/terms-of-service" class="text-gray-400 hover:text-orange-400 transition-colors">Terms</a>
                    <a href="/sitemap.xml" class="text-gray-400 hover:text-orange-400 transition-colors">Sitemap</a>
                </div>
            </div>
        </div>
    </div>
</footer>
