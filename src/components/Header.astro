---
// Header.astro
---
<header>
    <nav class="fixed top-0 left-0 w-full z-50 transition-all duration-300 bg-white">
        <div class="max-w-7xl mx-auto px-5 py-3 flex justify-between items-center">
            <!-- Logo -->
            <a href="/" class="flex items-center space-x-2 group">
                <img src="/assets/transfexalog.png" alt="Fexa Digital Logo" class="h-8 w-8 sm:h-10 sm:w-10 object-contain transition-transform duration-300 group-hover:scale-105" />
                <div class="flex flex-col">
                    <span class="text-base sm:text-xl font-bold text-gray-900 leading-tight">
                        <span class="bg-gradient-to-r from-purple-600 to-blue-600 bg-clip-text text-transparent">FEXA</span>
                        <span class="hidden sm:inline">DIGITAL</span>
                        <span class="sm:hidden">DIGITAL</span>
                    </span>
                    <span class="text-[9px] sm:text-xs text-gray-500 -mt-1 hidden sm:block">Web Design Agency</span>
                    <span class="text-[9px] text-gray-500 -mt-1 sm:hidden">Web Design Agency</span>
                </div>
            </a>

            <!-- Desktop Menu -->
            <div class="hidden lg:flex items-center space-x-6">
                <a href="/" class="nav-link text-gray-700 hover:text-purple-600 px-3 py-2">Home</a>
        
                <!-- Services Dropdown -->
                <div class="relative group">
                    <button class="nav-link flex items-center gap-1 text-gray-700 hover:text-purple-600 px-3 py-2">
                        Services
                        <span class="material-icons text-base dropdown-indicator">expand_more</span>
                    </button>
                    <div class="absolute left-0 top-full mt-2 w-72 bg-white rounded-xl shadow-2xl py-4 desktop-dropdown border border-gray-100">
                        <div class="px-4 py-2 border-b border-gray-100">
                            <h4 class="font-semibold text-gray-900 text-sm uppercase tracking-wide text-purple-600">Our Services</h4>
                        </div>
                        <div class="grid gap-1 p-2">
                            <!-- Web Development with Sub-Menu -->
                            <div class="relative group/sub">
                                <a href="/services/web-development" class="flex items-center px-3 py-2 rounded-lg hover:bg-purple-50 transition-colors group">
                                    <div class="w-8 h-8 bg-gradient-to-r from-purple-500 to-pink-500 rounded-lg flex items-center justify-center mr-3">
                                        <i class="fas fa-code text-white text-sm"></i>
                                    </div>
                                    <div>
                                        <span class="font-medium text-gray-900 group-hover:text-purple-600">Web Development</span>
                                        <p class="text-xs text-gray-500">Websites, Apps & SEO</p>
                                    </div>
                                    <i class="fas fa-chevron-right text-gray-400 text-xs ml-auto transition-transform group-hover:text-purple-600"></i>
                                </a>

                                <!-- Web Development Sub-Menu -->
                                <div class="absolute left-full top-0 ml-2 w-72 bg-white rounded-xl shadow-2xl py-3 border border-gray-100 invisible group-hover/sub:visible opacity-0 group-hover/sub:opacity-100 transition duration-200 z-50">
                                    <div class="px-3 py-2">
                                        <h5 class="text-xs font-semibold uppercase text-blue-600 tracking-wider">Web Solutions</h5>
                                    </div>
                                    <div class="grid gap-1 p-2">
                                        <a href="/services/web-development#design" class="flex items-center px-3 py-2 rounded-lg hover:bg-blue-50 transition-colors group">
                                            <i class="fas fa-palette text-blue-500 w-5 mr-3"></i>
                                            <div>
                                                <span class="font-medium text-gray-900">Web Design & Branding</span>
                                                <p class="text-xs text-gray-500">Professional, modern designs.</p>
                                            </div>
                                        </a>
                                        <a href="/services/web-development#webapp" class="flex items-center px-3 py-2 rounded-lg hover:bg-blue-50 transition-colors group">
                                            <i class="fas fa-terminal text-blue-500 w-5 mr-3"></i>
                                            <div>
                                                <span class="font-medium text-gray-900">Custom Web App</span>
                                                <p class="text-xs text-gray-500">Software built for your unique needs.</p>
                                            </div>
                                        </a>
                                        <a href="/services/web-development#seo" class="flex items-center px-3 py-2 rounded-lg hover:bg-green-50 transition-colors group">
                                            <i class="fas fa-search text-green-600 w-5 mr-3"></i>
                                            <div>
                                                <span class="font-medium text-gray-900">SEO Optimization</span>
                                                <p class="text-xs text-gray-500">Rank higher, get more traffic.</p>
                                            </div>
                                        </a>
                                        <a href="/services/web-development#maintain" class="flex items-center px-3 py-2 rounded-lg hover:bg-orange-50 transition-colors group">
                                            <i class="fas fa-tools text-orange-600 w-5 mr-3"></i>
                                            <div>
                                                <span class="font-medium text-gray-900">Website Maintenance</span>
                                                <p class="text-xs text-gray-500">Keep your site running smoothly.</p>
                                            </div>
                                        </a>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- AI Automation -->
                            <a href="/services/ai-automation" class="flex items-center px-3 py-2 rounded-lg hover:bg-purple-50 transition-colors group">
                                <div class="w-8 h-8 bg-gradient-to-r from-green-500 to-blue-500 rounded-lg flex items-center justify-center mr-3">
                                    <i class="fas fa-robot text-white text-sm"></i>
                                </div>
                                <div>
                                    <span class="font-medium text-gray-900 group-hover:text-purple-600">AI Automation</span>
                                    <p class="text-xs text-gray-500">Smart automation solutions</p>
                                </div>
                            </a>
                            
                            <!-- Digital Advertising -->
                            <a href="/services/digital-ads" class="flex items-center px-3 py-2 rounded-lg hover:bg-purple-50 transition-colors group">
                                <div class="w-8 h-8 bg-gradient-to-r from-orange-500 to-red-500 rounded-lg flex items-center justify-center mr-3">
                                    <i class="fas fa-bullhorn text-white text-sm"></i>
                                </div>
                                <div>
                                    <span class="font-medium text-gray-900 group-hover:text-purple-600">Digital Advertising</span>
                                    <p class="text-xs text-gray-500">Targeted campaigns & ROI</p>
                                </div>
                            </a>

                            <!-- Managed Cloud -->
                            <a href="/services/managed-cloud" class="flex items-center px-3 py-2 rounded-lg hover:bg-purple-50 transition-colors group">
                                <div class="w-8 h-8 bg-gradient-to-r from-blue-500 to-cyan-500 rounded-lg flex items-center justify-center mr-3">
                                    <i class="fas fa-cloud text-white text-sm"></i>
                                </div>
                                <div>
                                    <span class="font-medium text-gray-900 group-hover:text-purple-600">Managed Cloud</span>
                                    <p class="text-xs text-gray-500">Secure hosting & management</p>
                                </div>
                            </a>
                        </div>
                    </div>
                </div>
                
                <a href="/pricing" class="nav-link text-gray-700 hover:text-purple-600 px-3 py-2">Pricing</a>
                <a href="/about-us" class="nav-link text-gray-700 hover:text-purple-600 px-3 py-2">About</a>
                <a href="/contact-us" class="border border-indigo-600 text-indigo-600 hover:bg-indigo-600 hover:text-white px-4 py-2 rounded-lg transition-all duration-300">
                    Talk to Us
                </a>

                <!-- CTA Button -->
                <a href="/website-quote" class="inline-flex items-center px-6 py-2.5 text-white font-medium rounded-lg bg-slate-700 hover:bg-slate-800 transition-all duration-300 border border-slate-600 group">
                    <i class="fas fa-arrow-right mr-2 group-hover:text-orange-400 transition-colors duration-300"></i>Get Quote
                </a>
            </div>

            <!-- Mobile CTA Button and Menu Toggle -->
            <div class="flex items-center space-x-4 lg:hidden">
                <a href="/contact-us" class="px-4 py-2 text-sm text-indigo-600 font-medium rounded-full border border-indigo-600 hover:bg-indigo-600 hover:text-white transition-all duration-300">
                    Talk to Us
                </a>
                <button id="menu-toggle" class="focus:outline-none p-2">
                    <div class="hamburger">
                        <span></span>
                        <span></span>
                        <span></span>
                    </div>
                </button>
            </div>
        </div>

        <!-- Mobile Menu -->
        <div id="mobile-menu" class="hidden lg:hidden mobile-gradient absolute top-full left-0 w-full px-6 py-6 shadow-xl">
            <div class="space-y-1">
                <a href="/" class="mobile-menu-item mobile-link-hover block py-3 px-4 rounded-lg transition-colors" style="animation-delay: 0.05s">Home</a>
                
                <!-- Mobile Services Dropdown -->
                <div class="mobile-menu-item" style="animation-delay: 0.1s">
                    <button id="mobile-services-toggle" class="dropdown-toggle mobile-link-hover w-full flex justify-between items-center py-3 px-4 rounded-lg transition-colors">
                        <span>Services</span>
                        <span class="material-icons text-base dropdown-indicator">expand_more</span>
                    </button>
                    <div id="mobile-services-dropdown" class="mobile-dropdown pl-4 mt-1 space-y-1">
                        <!-- PRIMARY CATEGORY: WEB DEVELOPMENT -->
                        <a href="/services/web-development" class="mobile-link-hover flex items-center py-2 px-4 rounded-lg transition-colors font-semibold text-sm text-blue-800 bg-blue-50">
                            <i class="fas fa-code text-blue-500 w-5 mr-2"></i>
                            Web Development (Design, SEO, Apps)
                        </a>
                        
                        <!-- Sub-Services (using indentation) -->
                        <a href="/services/web-development#design" class="mobile-link-hover flex items-center py-1 px-4 rounded-lg transition-colors text-sm pl-8">
                            <i class="fas fa-palette text-blue-400 w-5 mr-2 opacity-70"></i>
                            Web Design & Branding
                        </a>
                        <a href="/services/web-development#seo" class="mobile-link-hover flex items-center py-1 px-4 rounded-lg transition-colors text-sm pl-8">
                            <i class="fas fa-search text-green-500 w-5 mr-2 opacity-70"></i>
                            Search Engine Optimization
                        </a>
                        <a href="/services/web-development#webapp" class="mobile-link-hover flex items-center py-1 px-4 rounded-lg transition-colors text-sm pl-8">
                            <i class="fas fa-terminal text-blue-400 w-5 mr-2 opacity-70"></i>
                            Custom Web App Development
                        </a>
                        <a href="/services/web-development#maintain" class="mobile-link-hover flex items-center py-1 px-4 rounded-lg transition-colors text-sm pl-8">
                            <i class="fas fa-tools text-orange-500 w-5 mr-2 opacity-70"></i>
                            Website Maintenance
                        </a>
                        
                        <!-- PRIMARY CATEGORY: AI AUTOMATION -->
                        <a href="/services/ai-automation" class="mobile-link-hover flex items-center py-2 px-4 rounded-lg transition-colors text-sm mt-2">
                            <i class="fas fa-robot text-purple-600 w-5 mr-2"></i>
                            AI Automation
                        </a>
                        
                        <!-- PRIMARY CATEGORY: DIGITAL ADVERTISING -->
                        <a href="/services/digital-ads" class="mobile-link-hover flex items-center py-2 px-4 rounded-lg transition-colors text-sm">
                            <i class="fas fa-bullhorn text-red-600 w-5 mr-2"></i>
                            Digital Advertising
                        </a>
                        
                        <!-- PRIMARY CATEGORY: MANAGED CLOUD SERVICE -->
                        <a href="/services/managed-cloud" class="mobile-link-hover flex items-center py-2 px-4 rounded-lg transition-colors text-sm">
                            <i class="fas fa-server text-indigo-600 w-5 mr-2"></i>
                            Managed Cloud Service
                        </a>
                    </div>
                </div>
               
                <a href="/pricing" class="mobile-menu-item mobile-link-hover block py-3 px-4 rounded-lg transition-colors" style="animation-delay: 0.2s">Pricing</a>
                <a href="/about-us" class="mobile-menu-item mobile-link-hover block py-3 px-4 rounded-lg transition-colors" style="animation-delay: 0.25s">About Us</a>
                <a href="/contact-us" class="mobile-menu-item mobile-link-hover block py-3 px-4 rounded-lg transition-colors" style="animation-delay: 0.3s"><i class="fas fa-comments mr-2"></i>Contact Us</a>
                
                <!-- Mobile CTA -->
                <div class="mobile-menu-item pt-4" style="animation-delay: 0.35s">
                   <a href="/website-quote" class="block w-full text-white text-center py-3 px-4 font-medium rounded-lg bg-slate-700 hover:bg-slate-800 transition-all duration-300 border border-slate-600 hover:border-orange-500 group">
                    <i class="fas fa-arrow-right mr-2 group-hover:text-orange-400 transition-colors duration-300"></i>
                    Request Quote
                   </a>
                </div>
            </div>
        </div>
    </nav>
</header>

<script is:inline>
document.addEventListener('DOMContentLoaded', function() {
    const menuToggle = document.getElementById('menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    const hamburger = document.querySelector('.hamburger');
    
    // Mobile dropdown toggles
    const mobileServicesToggle = document.getElementById('mobile-services-toggle');
    const mobileServicesDropdown = document.getElementById('mobile-services-dropdown');
    
    // Toggle mobile menu
    if (menuToggle) {
        menuToggle.addEventListener('click', function(e) {
            e.stopPropagation();
            mobileMenu.classList.toggle('hidden');
            hamburger.classList.toggle('active');
            
            // Reset dropdowns when closing menu
            if (mobileMenu.classList.contains('hidden')) {
                closeAllMobileDropdowns();
            }
        });
    }
    
    // Mobile services dropdown
    if (mobileServicesToggle) {
        mobileServicesToggle.addEventListener('click', function(e) {
            e.stopPropagation();
            mobileServicesDropdown.classList.toggle('open');
            mobileServicesToggle.classList.toggle('active');
        });
    }
    
    // Close mobile menu when clicking outside
    document.addEventListener('click', function(e) {
        if (!e.target.closest('nav') && menuToggle && !menuToggle.contains(e.target)) {
            if (mobileMenu) mobileMenu.classList.add('hidden');
            if (hamburger) hamburger.classList.remove('active');
            closeAllMobileDropdowns();
        }
    });
    
    // Close mobile menu when clicking on a link
    const mobileLinks = document.querySelectorAll('#mobile-menu a');
    mobileLinks.forEach(link => {
        link.addEventListener('click', function() {
            if (mobileMenu) mobileMenu.classList.add('hidden');
            if (hamburger) hamburger.classList.remove('active');
            closeAllMobileDropdowns();
        });
    });
    
    function closeAllMobileDropdowns() {
        if (mobileServicesDropdown) {
            mobileServicesDropdown.classList.remove('open');
        }
        if (mobileServicesToggle) {
            mobileServicesToggle.classList.remove('active');
        }
    }
});
</script>
