---
// Header.astro
import Logo from './Logo.astro';
---
<header>
    <nav class="fixed top-0 left-0 w-full z-50 transition-all duration-300 bg-white">
        <div class="max-w-7xl mx-auto px-5 py-3 flex justify-between items-center relative">
            <!-- Logo -->
            <a href="/" class="flex items-center space-x-2 group">
                <img src="/assets/fxs-logo.png" alt="Fexaris Studio Logo" class="h-8 w-8 sm:h-10 sm:w-10 object-contain transition-transform duration-300 group-hover:scale-105" />
                <div class="flex flex-col">
                    <span class="text-base sm:text-xl font-bold text-gray-900 leading-tight">
                        <Logo theme="light" class="h-6 w-auto sm:h-8 sm:w-auto align-middle" />
                    </span>
                    <span class="text-[9px] sm:text-xs text-gray-500 -mt-1 hidden sm:block">AI &amp; Digital Growth Studio</span>
                    <span class="text-[9px] text-gray-500 -mt-1 sm:hidden">AI &amp; Digital Growth Studio</span>
                </div>
            </a>

            <!-- Desktop Menu -->
            <div class="hidden lg:flex items-center space-x-6">
                <a href="/" class="nav-link text-gray-700 hover:text-purple-600 px-3 py-2">Home</a>
        
                <!-- Services Mega Menu -->
                <div class="group">
                    <button type="button" class="nav-link flex items-center gap-1 text-gray-700 hover:text-purple-600 px-3 py-2" aria-haspopup="true">
                        Services
                        <span class="material-icons text-base dropdown-indicator">expand_more</span>
                    </button>
                    <div class="desktop-dropdown absolute left-0 right-0 top-full pt-3 z-50">
                        <div class="mx-auto w-full max-w-5xl px-2">
                            <div class="rounded-2xl border border-gray-200 bg-white p-3 shadow-2xl">
                                <div class="grid gap-3 lg:grid-cols-[minmax(0,1fr)_300px]">
                                    <!-- Service links -->
                                    <div class="rounded-xl bg-gray-50 p-3">
                                        <div class="grid grid-cols-2 gap-2">
                                            <a href="/services/web-development" class="group/item flex items-center gap-3 rounded-lg border border-gray-100 bg-white px-3 py-2.5 transition-colors hover:border-gray-300 hover:bg-gray-50">
                                                <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-md border border-gray-200 bg-white text-gray-500 transition-colors group-hover/item:text-purple-600">
                                                    <i class="fas fa-code text-xs" aria-hidden="true"></i>
                                                </span>
                                                <span class="text-sm font-medium text-gray-800">Web Development</span>
                                            </a>
                                            <a href="/services/digital-marketing#seo" class="group/item flex items-center gap-3 rounded-lg border border-gray-100 bg-white px-3 py-2.5 transition-colors hover:border-gray-300 hover:bg-gray-50">
                                                <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-md border border-gray-200 bg-white text-gray-500 transition-colors group-hover/item:text-purple-600">
                                                    <i class="fas fa-magnifying-glass text-xs" aria-hidden="true"></i>
                                                </span>
                                                <span class="text-sm font-medium text-gray-800">Search Engine Optimization</span>
                                            </a>
                                            <a href="/services/digital-marketing#performance-marketing" class="group/item flex items-center gap-3 rounded-lg border border-gray-100 bg-white px-3 py-2.5 transition-colors hover:border-gray-300 hover:bg-gray-50">
                                                <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-md border border-gray-200 bg-white text-gray-500 transition-colors group-hover/item:text-purple-600">
                                                    <i class="fas fa-chart-line text-xs" aria-hidden="true"></i>
                                                </span>
                                                <span class="text-sm font-medium text-gray-800">Performance Marketing</span>
                                            </a>
                                            <a href="/services/digital-marketing#social-media" class="group/item flex items-center gap-3 rounded-lg border border-gray-100 bg-white px-3 py-2.5 transition-colors hover:border-gray-300 hover:bg-gray-50">
                                                <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-md border border-gray-200 bg-white text-gray-500 transition-colors group-hover/item:text-purple-600">
                                                    <i class="fas fa-hashtag text-xs" aria-hidden="true"></i>
                                                </span>
                                                <span class="text-sm font-medium text-gray-800">Social Media Marketing</span>
                                            </a>
                                            <a href="/services/ai-automation" class="group/item flex items-center gap-3 rounded-lg border border-gray-100 bg-white px-3 py-2.5 transition-colors hover:border-gray-300 hover:bg-gray-50">
                                                <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-md border border-gray-200 bg-white text-gray-500 transition-colors group-hover/item:text-purple-600">
                                                    <i class="fas fa-robot text-xs" aria-hidden="true"></i>
                                                </span>
                                                <span class="text-sm font-medium text-gray-800">AI Automation</span>
                                            </a>
                                            <a href="/services/managed-cloud" class="group/item flex items-center gap-3 rounded-lg border border-gray-100 bg-white px-3 py-2.5 transition-colors hover:border-gray-300 hover:bg-gray-50">
                                                <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-md border border-gray-200 bg-white text-gray-500 transition-colors group-hover/item:text-purple-600">
                                                    <i class="fas fa-cloud text-xs" aria-hidden="true"></i>
                                                </span>
                                                <span class="text-sm font-medium text-gray-800">Managed Cloud Services</span>
                                            </a>
                                        </div>
                                        <a href="/#services" class="mt-3 inline-flex items-center gap-1.5 text-sm font-medium text-gray-600 transition-colors hover:text-purple-600">
                                            All Services
                                            <i class="fas fa-arrow-right text-xs" aria-hidden="true"></i>
                                        </a>
                                    </div>

                                    <!-- Preview -->
                                    <a href="/#services" class="group/preview relative flex min-h-[240px] flex-col overflow-hidden rounded-xl border border-gray-200 bg-gray-100">
                                        <img src="/assets/ads-dash.png" alt="Fexaris digital marketing dashboard preview" class="absolute inset-0 h-full w-full object-cover" />
                                        <div class="relative flex items-center gap-1.5 border-b border-gray-200/70 bg-white/80 px-3 py-2 backdrop-blur">
                                            <span class="h-1.5 w-1.5 rounded-full bg-red-400"></span>
                                            <span class="h-1.5 w-1.5 rounded-full bg-yellow-400"></span>
                                            <span class="h-1.5 w-1.5 rounded-full bg-green-400"></span>
                                            <span class="ml-2 text-[10px] text-gray-500">fexaris.com</span>
                                        </div>
                                        <div class="relative mt-auto bg-gradient-to-t from-white via-white/95 to-transparent p-3 pt-10">
                                            <p class="text-[10px] font-medium uppercase tracking-widest text-gray-500">Fexaris Studio</p>
                                            <p class="mt-1 text-lg font-semibold leading-tight text-gray-900">Get creative.<br />Grow faster.</p>
                                            <span class="mt-2 inline-flex items-center gap-1.5 rounded-full bg-purple-600 px-3 py-1 text-xs font-semibold text-white transition-colors group-hover/preview:bg-purple-700">
                                                Browse Services
                                                <i class="fas fa-arrow-right text-[10px]" aria-hidden="true"></i>
                                            </span>
                                        </div>
                                        <div class="relative flex items-center justify-between border-t border-gray-200/70 bg-white/85 px-3 py-2.5 backdrop-blur">
                                            <span class="text-xs font-semibold tracking-wide text-gray-900">FEXARIS</span>
                                            <span class="flex h-7 w-7 items-center justify-center rounded-full bg-gray-900 text-white">
                                                <i class="fas fa-arrow-right text-xs" aria-hidden="true"></i>
                                            </span>
                                        </div>
                                    </a>
                                </div>

                                <div class="mt-3 flex items-center gap-6 border-t border-gray-100 px-1 pt-3 text-sm">
                                    <a href="/about-us" class="text-gray-600 transition-colors hover:text-purple-600">About Fexaris</a>
                                    <a href="/contact-us" class="text-gray-600 transition-colors hover:text-purple-600">Contact Sales</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                
                <a href="/case-studies" class="nav-link text-gray-700 hover:text-purple-600 px-3 py-2">Case Studies</a>
                <a href="/about-us" class="nav-link text-gray-700 hover:text-purple-600 px-3 py-2">About</a>
                <a href="https://calendly.com/fexaris/30min" target="_blank" class="btn-secondary btn-sm">
                    <i class="fas fa-calendar-check mr-2"></i>Book a Call
                </a>

                <!-- CTA Button -->
                <a href="/contact-us" class="btn-primary btn-sm">
                    Let's Connect
                    <i class="fas fa-arrow-right ml-2"></i>
                </a>
            </div>

            <!-- Mobile CTA Button and Menu Toggle -->
            <div class="flex items-center space-x-4 lg:hidden">
                <a href="https://calendly.com/fexaris/30min" target="_blank" class="btn-secondary btn-sm">
                    <i class="fas fa-calendar-check mr-2"></i>Book a Call
                </a>
                <button id="menu-toggle" class="focus:outline-none p-2">
                    <div class="hamburger">
                        <span></span>
                        <span></span>
                        <span></span>
                    </div>
                </button>
            </div>
        </div>

        <!-- Mobile Menu -->
        <div id="mobile-menu" class="hidden lg:hidden mobile-gradient absolute top-full left-0 w-full px-6 py-6 shadow-xl">
            <div class="space-y-1">
                <a href="/" class="mobile-menu-item mobile-link-hover block py-3 px-4 rounded-lg transition-colors" style="animation-delay: 0.05s">Home</a>
                
                <!-- Mobile Services Dropdown -->
                <div class="mobile-menu-item" style="animation-delay: 0.1s">
                    <button id="mobile-services-toggle" class="dropdown-toggle mobile-link-hover w-full flex justify-between items-center py-3 px-4 rounded-lg transition-colors">
                        <span>Services</span>
                        <span class="material-icons text-base dropdown-indicator">expand_more</span>
                    </button>
                    <div id="mobile-services-dropdown" class="mobile-dropdown pl-4 mt-1 space-y-1">
                        <a href="/services/web-development" class="mobile-link-hover flex items-center gap-2 py-2 px-4 rounded-lg transition-colors text-sm">
                            <i class="fas fa-code text-gray-500 w-5" aria-hidden="true"></i>
                            Web Development
                        </a>
                        <a href="/services/digital-marketing#seo" class="mobile-link-hover flex items-center gap-2 py-2 px-4 rounded-lg transition-colors text-sm">
                            <i class="fas fa-magnifying-glass text-gray-500 w-5" aria-hidden="true"></i>
                            Search Engine Optimization
                        </a>
                        <a href="/services/digital-marketing#performance-marketing" class="mobile-link-hover flex items-center gap-2 py-2 px-4 rounded-lg transition-colors text-sm">
                            <i class="fas fa-chart-line text-gray-500 w-5" aria-hidden="true"></i>
                            Performance Marketing
                        </a>
                        <a href="/services/digital-marketing#social-media" class="mobile-link-hover flex items-center gap-2 py-2 px-4 rounded-lg transition-colors text-sm">
                            <i class="fas fa-hashtag text-gray-500 w-5" aria-hidden="true"></i>
                            Social Media Marketing
                        </a>
                        <a href="/services/ai-automation" class="mobile-link-hover flex items-center gap-2 py-2 px-4 rounded-lg transition-colors text-sm">
                            <i class="fas fa-robot text-gray-500 w-5" aria-hidden="true"></i>
                            AI Automation
                        </a>
                        <a href="/services/managed-cloud" class="mobile-link-hover flex items-center gap-2 py-2 px-4 rounded-lg transition-colors text-sm">
                            <i class="fas fa-cloud text-gray-500 w-5" aria-hidden="true"></i>
                            Managed Cloud Services
                        </a>
                        <a href="/#services" class="mobile-link-hover flex items-center gap-2 py-2 px-4 rounded-lg transition-colors text-sm font-semibold text-purple-600">
                            <i class="fas fa-arrow-right text-xs" aria-hidden="true"></i>
                            All Services
                        </a>
                    </div>
                </div>

               
                <a href="/case-studies" class="mobile-menu-item mobile-link-hover block py-3 px-4 rounded-lg transition-colors" style="animation-delay: 0.2s">Case Studies</a>
                <a href="/about-us" class="mobile-menu-item mobile-link-hover block py-3 px-4 rounded-lg transition-colors" style="animation-delay: 0.25s">About Us</a>
                
                <!-- Mobile CTA -->
                <div class="mobile-menu-item pt-4" style="animation-delay: 0.3s">
                   <a href="/contact-us" class="btn-primary w-full block text-center">
                    Let's Connect
                    <i class="fas fa-arrow-right ml-2"></i>
                   </a>
                </div>
            </div>
        </div>
    </nav>
</header>

<script is:inline>
document.addEventListener('DOMContentLoaded', function() {
    const menuToggle = document.getElementById('menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    const hamburger = document.querySelector('.hamburger');
    
    // Mobile dropdown toggles
    const mobileServicesToggle = document.getElementById('mobile-services-toggle');
    const mobileServicesDropdown = document.getElementById('mobile-services-dropdown');
    
    // Toggle mobile menu
    if (menuToggle) {
        menuToggle.addEventListener('click', function(e) {
            e.stopPropagation();
            mobileMenu.classList.toggle('hidden');
            hamburger.classList.toggle('active');
            
            // Reset dropdowns when closing menu
            if (mobileMenu.classList.contains('hidden')) {
                closeAllMobileDropdowns();
            }
        });
    }
    
    // Mobile services dropdown
    if (mobileServicesToggle) {
        mobileServicesToggle.addEventListener('click', function(e) {
            e.stopPropagation();
            mobileServicesDropdown.classList.toggle('open');
            mobileServicesToggle.classList.toggle('active');
        });
    }
    
    // Close mobile menu when clicking outside
    document.addEventListener('click', function(e) {
        if (!e.target.closest('nav') && menuToggle && !menuToggle.contains(e.target)) {
            if (mobileMenu) mobileMenu.classList.add('hidden');
            if (hamburger) hamburger.classList.remove('active');
            closeAllMobileDropdowns();
        }
    });
    
    // Close mobile menu when clicking on a link
    const mobileLinks = document.querySelectorAll('#mobile-menu a');
    mobileLinks.forEach(link => {
        link.addEventListener('click', function() {
            if (mobileMenu) mobileMenu.classList.add('hidden');
            if (hamburger) hamburger.classList.remove('active');
            closeAllMobileDropdowns();
        });
    });
    
    function closeAllMobileDropdowns() {
        if (mobileServicesDropdown) {
            mobileServicesDropdown.classList.remove('open');
        }
        if (mobileServicesToggle) {
            mobileServicesToggle.classList.remove('active');
        }
    }
});
</script>
